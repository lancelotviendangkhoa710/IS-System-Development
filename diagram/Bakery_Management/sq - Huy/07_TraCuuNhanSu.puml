@startuml TraCuuNhanSu
mainframe sd Seq_TraCuuNhanSu
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

    skinparam noteBackgroundColor transparent
    skinparam noteBorderColor transparent

actor "Quản lý" as QL #White
boundary "GUI_NhanSu" as UI #White
control "Controller_NhanSu" as SYS #White

entity ": NHANVIEN" as DB_NV #White

UI -> UI: Mở màn hình quản lý nhân sự
activate UI
deactivate UI

QL -> UI: Gõ từ khóa tìm kiếm thông tin \n nhân viên cần tìm kiếm  / Chọn bộ lọc
activate UI
deactivate UI

UI -> SYS: Yêu cầu truy vấn thông tin nhân viên theo điều kiện
activate SYS
deactivate SYS

SYS -> DB_NV: Tìm kiếm nhân viên theo điều kiện
activate DB_NV
deactivate DB_NV

DB_NV -> DB_NV: Thực hiện truy vấn thông tin \n nhân viên theo điều kiện
activate DB_NV
deactivate DB_NV

group alt Kiểm tra thông tin
    note over of QL: [Không tìm thấy]
    autonumber stop
    QL -[hidden]-> DB_NV
    autonumber resume "<b>##."
    SYS -->> UI: Hiển thị danh sách rỗng
else 
    note over of QL: [Tìm thấy]
    autonumber stop
    QL -[hidden]-> DB_NV
    autonumber resume "<b>##."
    SYS -->> UI: Cập nhật danh sách kết quả
end

@enduml