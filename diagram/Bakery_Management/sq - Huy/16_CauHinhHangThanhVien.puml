@startuml CauHinhHangThanhVien
mainframe sd Seq_CauHinhHangThanhVien
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

    skinparam noteBackgroundColor transparent
    skinparam noteBorderColor transparent

actor "Quản lý" as QL #White
boundary "GUI_HangThanhVien" as UI #White
control "Controller_HangThanhVien" as SYS #White
entity ": HANGTHANHVIEN" as DB_HTV #White

QL -> UI: Mở màn hình cấu hình hạng thành viên
activate UI
deactivate UI

UI -> SYS: Yêu cầu tải danh sách hạng
activate SYS
deactivate SYS

SYS -> DB_HTV: Lấy danh sách hạng (sắp xếp theo điểm tăng dần)
activate DB_HTV
deactivate DB_HTV

SYS -->> UI: Hiển thị danh sách hạng thành viên

QL -> UI: Chọn hạng thành viên cần thay đổi 
activate UI
deactivate UI

UI -> UI: Hiển thị hộp thoại cấu hình hạng thành viên
activate UI
deactivate UI

QL -> UI: Chỉnh sửa điểm tối thiểu / tỷ lệ giảm giá và nhấn "Lưu"
activate UI
deactivate UI

UI -> SYS: Gửi dữ liệu cập nhật
activate SYS
deactivate SYS

SYS -> SYS: Kiểm tra tính hợp lệ của dữ liệu đầu vào
activate SYS
deactivate SYS

group alt Kiểm tra tính hợp lệ của dữ liệu đầu vào
    note over of QL: [Dữ liệu không hợp lệ]
    autonumber stop
    QL -[hidden]-> DB_HTV
    autonumber resume "<b>##."
    SYS -->> UI: Báo lỗi định dạng
else 
    note over of QL: [Dữ liệu hợp lệ]
    autonumber stop
    QL -[hidden]-> DB_HTV
    autonumber resume "<b>##."
    SYS -> DB_HTV: Cập nhật thông tin hạng (luồng nền)
    activate DB_HTV
    deactivate DB_HTV
    
    group alt Cập nhật thông tin hạng (luồng nền)
        note over of QL: [Lỗi cơ sở dữ liệu]
        autonumber stop
        QL -[hidden]-> DB_HTV
        autonumber resume "<b>##."
        SYS -->> UI: Báo lỗi lưu dữ liệu
    else 
        note over of QL: [Cập nhật thành công]
        autonumber stop
        QL -[hidden]-> DB_HTV
        autonumber resume "<b>##."
        SYS -> DB_HTV: Tải lại danh sách
        activate DB_HTV
        deactivate DB_HTV
        
        SYS -->> UI: Thông báo thành công và làm mới danh sách
        autonumber stop
        UI -[hidden]-> QL
        autonumber resume "<b>##."
    end
end

@enduml
