@startuml CapNhatTrangThaiDanhMuc
mainframe sd Seq_CapNhatTrangThaiDanhMuc
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

skinparam noteBackgroundColor transparent
skinparam noteBorderColor transparent

actor "Quản lý" as QL #White
boundary "GUI_SanPham" as UI #White
control "Controller_SanPham" as SYS #White
entity ": SANPHAM" as DB_SP #White
entity ": DANHMUCSANPHAM" as DB_DM #White

QL -> UI: Chọn danh mục và nhấn khóa/khôi phục
activate UI
deactivate UI

UI -> SYS: Yêu cầu cập nhật trạng thái
activate SYS
deactivate SYS

SYS -> DB_SP: Kiểm tra sản phẩm trong danh mục
activate DB_SP
deactivate DB_SP

group alt Kiểm tra điều kiện
    note over of QL: [Còn sản phẩm đang hoạt động]
    autonumber stop
    QL -[hidden]-> DB_DM
    autonumber resume "<b>##."
    SYS -->> UI: Báo lỗi, từ chối khóa
else
    note over of QL: [Hợp lệ]
    autonumber stop
    QL -[hidden]-> DB_DM
    autonumber resume "<b>##."
    SYS -> DB_DM: Lưu trạng thái mới
    activate DB_DM
    deactivate DB_DM
    
    SYS -->> UI: Cập nhật thành công và làm mới danh sách
end
@enduml
