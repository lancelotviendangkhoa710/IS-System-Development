@startuml SuaSanPham
mainframe sd Seq_SuaSanPham
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

skinparam noteBackgroundColor transparent
skinparam noteBorderColor transparent

actor "Quản lý" as QL #White
boundary "Form_SuaSanPham" as FRM #White
boundary "GUI_SanPham" as UI #White
control "Controller_SanPham" as SYS #White
entity ": SANPHAM" as DB_SP #White

QL -> UI: Chọn sản phẩm cần sửa
activate UI
deactivate UI

UI -->> FRM: Hiển thị chi tiết vào biểu mẫu
activate FRM
deactivate FRM

QL -> FRM: Chỉnh sửa thông tin và nhấn "Lưu thay đổi"
activate FRM
deactivate FRM

FRM -> SYS: Gửi dữ liệu cập nhật
activate SYS
deactivate SYS

SYS -> SYS: Kiểm tra tính hợp lệ
activate SYS
deactivate SYS

group alt Kiểm tra
    note over of QL: [Dữ liệu lỗi]
    autonumber stop
    QL -[hidden]-> DB_SP
    autonumber resume "<b>##."
    SYS -->> FRM: Báo lỗi
else
    note over of QL: [Hợp lệ]
    autonumber stop
    QL -[hidden]-> DB_SP
    autonumber resume "<b>##."
    SYS -> DB_SP: Lưu dữ liệu cập nhật
    activate DB_SP
    deactivate DB_SP
    
    SYS -->> UI: Cập nhật thành công và làm mới danh sách
end
@enduml
