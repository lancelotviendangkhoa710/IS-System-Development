@startuml TraCuuDanhSachDon
mainframe sd Seq_TraCuuDanhSachDon
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

skinparam noteBackgroundColor transparent
skinparam noteBorderColor transparent

actor "Thu ngân" as TN #White
boundary "GUI_BanHang" as UI #White
control "Controller_BanHang" as SYS #White
entity ": DONDATHANG" as DB_DDH #White

TN -> UI: Vào màn hình theo dõi đơn hàng
activate UI
deactivate UI

UI -> SYS: Yêu cầu tải danh sách mặc định
activate SYS
deactivate SYS

SYS -> DB_DDH: Truy vấn danh sách trong ngày
activate DB_DDH
deactivate DB_DDH

SYS -->> UI: Hiển thị danh sách ban đầu

TN -> UI: Nhập bộ lọc (Ngày, giờ, mã đơn, trạng thái) và nhấn Tìm
activate UI
deactivate UI

UI -> SYS: Yêu cầu tìm kiếm
activate SYS
deactivate SYS

SYS -> SYS: Kiểm tra tính hợp lệ bộ lọc
activate SYS
deactivate SYS

group alt Kiểm tra bộ lọc
    note over of TN: [Lỗi dữ liệu lọc]
    autonumber stop
    TN -[hidden]-> DB_DDH
    autonumber resume "<b>##."
    SYS -->> UI: Thông báo lỗi
else
    note over of TN: [Hợp lệ]
    autonumber stop
    TN -[hidden]-> DB_DDH
    autonumber resume "<b>##."
    SYS -> DB_DDH: Lọc đơn hàng theo điều kiện
    activate DB_DDH
    deactivate DB_DDH
    
    SYS -->> UI: Làm mới danh sách hiển thị
end
@enduml
