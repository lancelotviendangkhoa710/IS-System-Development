@startuml TraCuuLichSuMuaHang
mainframe sd Seq_TraCuuLichSuMuaHang
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

    skinparam noteBackgroundColor transparent
    skinparam noteBorderColor transparent

actor "Nhân viên" as NV #White
boundary "GUI_KhachHang" as UI #White
control "Controller_KhachHang" as SYS #White
entity ": DONDATHANG" as DB_DDH #White
entity ": CTDONHANG" as DB_CTDH #White
entity ": CTDONTUYCHINH" as DB_CTTC #White
entity ": SANPHAM" as DB_SP #White

NV -> UI: Chọn chức năng xem lịch sử mua hàng từ hồ sơ khách hàng
activate UI
deactivate UI

UI -> SYS: Yêu cầu tải lịch sử giao dịch (Mã KH)
activate SYS
deactivate SYS

SYS -> DB_DDH: Tìm kiếm lịch sử đơn hàng (Hóa đơn lẻ & Đặt bánh)
activate DB_DDH
deactivate DB_DDH

SYS -> SYS: Xử lý dữ liệu
activate SYS
deactivate SYS

group alt Xử lý dữ liệu
    note over of NV: [Lỗi truy xuất dữ liệu]
    autonumber stop
    NV -[hidden]-> DB_DDH
    autonumber resume "<b>##."
    SYS -->> UI: Báo lỗi hệ thống
else 
    note over of NV: [Chưa từng mua hàng]
    autonumber stop
    NV -[hidden]-> DB_DDH
    autonumber resume "<b>##."
    SYS -->> UI: Hiển thị danh sách rỗng
else 
    note over of NV: [Có lịch sử mua hàng]
    autonumber stop
    NV -[hidden]-> DB_DDH
    autonumber resume "<b>##."
    SYS -->> UI: Hiển thị danh sách lịch sử mua hàng
    
    NV -> UI: Chọn xem chi tiết một đơn hàng cụ thể
    activate UI
    deactivate UI
    
    UI -> SYS: Yêu cầu thông tin chi tiết đơn hàng
    activate SYS
    deactivate SYS
    
    group alt Yêu cầu thông tin chi tiết đơn hàng
        note over of NV: [Đơn hàng bán lẻ]
        autonumber stop
        NV -[hidden]-> DB_DDH
        autonumber resume "<b>##."
        SYS -> DB_CTDH: Lấy chi tiết đơn bán lẻ
        activate DB_CTDH
        deactivate DB_CTDH
        
        SYS -> DB_SP: Lấy thông tin sản phẩm
        activate DB_SP
        deactivate DB_SP
    else 
        note over of NV: [Đơn đặt bánh tùy chỉnh]
        autonumber stop
        NV -[hidden]-> DB_DDH
        autonumber resume "<b>##."
        SYS -> DB_CTTC: Lấy chi tiết đơn tùy chỉnh
        activate DB_CTTC
        deactivate DB_CTTC
        
        SYS -> DB_SP: Lấy thông tin sản phẩm (bánh gốc)
        activate DB_SP
        deactivate DB_SP
    end
    
    SYS -->> UI: Hiển thị thông tin chi tiết đơn hàng
end

@enduml
