@startuml HuyPhieuThuChi
mainframe sd Seq_HuyPhieuThuChi
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

    skinparam noteBackgroundColor transparent
    skinparam noteBorderColor transparent

actor "Người dùng" as ND #White
boundary "GUI_QuanLyThuChi" as UI #White
control "Controller_QuanLyThuChi" as SYS #White
entity ": PHIEUTHUCHI" as DB_PTC #White

ND -> UI: Chọn hủy một phiếu giao dịch đang hiệu lực
activate UI
deactivate UI

UI -> SYS: Gửi yêu cầu hủy phiếu
activate SYS
deactivate SYS

SYS -->> UI: Cảnh báo hành động không thể hoàn tác và yêu cầu nhập lý do

group alt Nhập lý do và xác nhận
    note over of ND: [Từ chối xác nhận]
    autonumber stop
    ND -[hidden]-> DB_PTC
    autonumber resume "<b>##."
    ND -> UI: Hủy thao tác
    activate UI
    deactivate UI
    
    UI -> SYS: Hủy yêu cầu
    activate SYS
    deactivate SYS
    
    SYS -->> UI: Hủy thao tác, phiếu giữ nguyên trạng thái
else 
    note over of ND: [Đồng ý xác nhận]
    autonumber stop
    ND -[hidden]-> DB_PTC
    autonumber resume "<b>##."
    ND -> UI: Nhập lý do và nhấn xác nhận
    activate UI
    deactivate UI
    
    UI -> SYS: Gửi yêu cầu hủy phiếu kèm lý do
    activate SYS
    deactivate SYS
    
    SYS -> SYS: Kiểm tra lý do hủy
    activate SYS
    deactivate SYS

    group alt Kiểm tra lý do
        note over of ND: [Lý do trống]
        autonumber stop
        ND -[hidden]-> DB_PTC
        autonumber resume "<b>##."
        SYS -->> UI: Thông báo lỗi yêu cầu nhập lý do
    else 
        note over of ND: [Lý do hợp lệ]
        autonumber stop
        ND -[hidden]-> DB_PTC
        autonumber resume "<b>##."
        SYS -> DB_PTC: Cập nhật trạng thái phiếu thành "Đã hủy" và ghi nhận lý do
        activate DB_PTC
        deactivate DB_PTC

        SYS -> SYS: Tính toán lại tổng quan quỹ (hoàn tác dòng tiền)
        activate SYS
        deactivate SYS
        
        SYS -> SYS: Kiểm tra kết quả lưu
        activate SYS
        deactivate SYS
        
        group alt Kết quả lưu
            note over of ND: [Lưu thất bại]
            autonumber stop
            ND -[hidden]-> DB_PTC
            autonumber resume "<b>##."
            SYS -->> UI: Thông báo lỗi, trạng thái phiếu không thay đổi
        else 
            note over of ND: [Lưu thành công]
            autonumber stop
            ND -[hidden]-> DB_PTC
            autonumber resume "<b>##."
            SYS -->> UI: Thông báo thành công, làm mới danh sách và tổng quan quỹ
        end
    end
end

@enduml
