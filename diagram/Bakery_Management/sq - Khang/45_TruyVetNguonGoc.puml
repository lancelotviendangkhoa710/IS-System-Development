@startuml TruyVetNguonGoc
mainframe sd Seq_TruyVetNguonGoc
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

    skinparam noteBackgroundColor transparent
    skinparam noteBorderColor transparent

actor "Thủ kho" as TK #White
boundary "GUI_TruyVetNguonGoc" as UI #White
control "Controller_KhoVaNguyenLieu" as SYS #White
entity ": THEKHO" as DB_TKHO #White
entity ": PHIEUNHAPKHO" as DB_PNK #White
entity ": NHACUNGCAP" as DB_NCC #White

TK -> UI: Vào trang thẻ kho của nguyên liệu gặp sự cố
activate UI
deactivate UI

UI -> SYS: Yêu cầu lấy thông tin thẻ kho
activate SYS
deactivate SYS

SYS -> DB_TKHO: Lấy dữ liệu thẻ kho
activate DB_TKHO
deactivate DB_TKHO

SYS -->> UI: Hiển thị thông tin thẻ kho

TK -> UI: Lọc các phiếu liên quan theo loại phiếu nhập
activate UI
deactivate UI

UI -> SYS: Yêu cầu danh sách phiếu nhập của nguyên liệu
activate SYS
deactivate SYS

SYS -> DB_PNK: Truy vấn các phiếu nhập kho
activate DB_PNK
deactivate DB_PNK

SYS -->> UI: Hiển thị danh sách phiếu nhập liên quan

group opt Nhiều phiếu nhập
    autonumber stop
    TK -[hidden]-> DB_NCC
    autonumber resume "<b>##."
    note over TK: So sánh thời gian và thời hạn để xác định lô hàng gặp sự cố
end

TK -> UI: Chọn một phiếu nhập
activate UI
deactivate UI

UI -> SYS: Yêu cầu chi tiết phiếu nhập và nhà cung cấp
activate SYS
deactivate SYS

SYS -> DB_PNK: Lấy chi tiết phiếu nhập (số lô, thời hạn)
activate DB_PNK
deactivate DB_PNK

SYS -> DB_NCC: Lấy thông tin nhà cung cấp
activate DB_NCC
deactivate DB_NCC

SYS -->> UI: Hiển thị chi tiết phiếu nhập và nhà cung cấp

group opt Xem thông tin nhà cung cấp
    autonumber stop
    TK -[hidden]-> DB_NCC
    autonumber resume "<b>##."
    TK -> UI: Nhấn "Xem thông tin nhà cung cấp"
    activate UI
    deactivate UI
    
    UI -> SYS: Yêu cầu lấy chi tiết hồ sơ nhà cung cấp
    activate SYS
    deactivate SYS
    
    SYS -->> UI: Mở chi tiết hồ sơ nhà cung cấp
end

@enduml
