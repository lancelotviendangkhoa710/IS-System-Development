@startuml ThemNhaCungCap
mainframe sd Seq_ThemNhaCungCap
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

    skinparam noteBackgroundColor transparent
    skinparam noteBorderColor transparent

actor "Thủ kho" as TK #White
boundary "Form_ThemNhaCungCap" as FRM #White
boundary "GUI_NhaCungCap" as UI #White
control "Controller_NhaCungCap" as SYS #White
entity ": NHACUNGCAP" as DB_NCC #White

TK -> UI: Chọn thêm nhà cung cấp mới
activate UI
deactivate UI

UI -->> FRM: Hiển thị biểu mẫu nhập thông tin

group opt Hủy thao tác
    autonumber stop
    TK -[hidden]-> DB_NCC
    autonumber resume "<b>##."
    TK -> FRM: Nhấn nút "Hủy"
    activate FRM
    deactivate FRM
    
FRM -> SYS: Yêu cầu đóng form
    activate SYS
    deactivate SYS
    
    SYS -->> UI: Đóng biểu mẫu, không lưu dữ liệu
end


TK -> FRM: Nhập tên, địa chỉ, số điện thoại, email, người đại diện và nhấn "Lưu"
activate FRM
deactivate FRM

FRM -> SYS: Gửi yêu cầu thêm nhà cung cấp
activate SYS
deactivate SYS

SYS -> SYS: Kiểm tra tính hợp lệ và tên không trùng lặp
activate SYS
deactivate SYS

group alt Kiểm tra dữ liệu
    note over of TK: [Thông tin không hợp lệ hoặc trùng tên]
    autonumber stop
    TK -[hidden]-> DB_NCC
    autonumber resume "<b>##."
    SYS -->> UI: Thông báo lỗi và giữ nguyên biểu mẫu
else 
    note over of TK: [Thông tin hợp lệ]
    autonumber stop
    TK -[hidden]-> DB_NCC
    autonumber resume "<b>##."
    SYS -> DB_NCC: Lưu thông tin nhà cung cấp mới
    activate DB_NCC
    deactivate DB_NCC

    SYS -> SYS: Kiểm tra kết quả lưu
    activate SYS
    deactivate SYS
    
    group alt Kết quả lưu
        note over of TK: [Lưu thất bại]
        autonumber stop
        TK -[hidden]-> DB_NCC
        autonumber resume "<b>##."
        SYS -->> UI: Thông báo lỗi lưu dữ liệu
    else 
        note over of TK: [Lưu thành công]
        autonumber stop
        TK -[hidden]-> DB_NCC
        autonumber resume "<b>##."
        SYS -->> UI: Thông báo thành công và làm mới danh sách
    end
end

@enduml
