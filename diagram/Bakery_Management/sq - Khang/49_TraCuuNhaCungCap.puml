@startuml TraCuuNhaCungCap
mainframe sd Seq_TraCuuNhaCungCap
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

    skinparam noteBackgroundColor transparent
    skinparam noteBorderColor transparent

actor "Thủ kho" as TK #White
boundary "GUI_TraCuuNhaCungCap" as UI #White
control "Controller_NhaCungCap" as SYS #White
entity ": NHACUNGCAP" as DB_NCC #White
entity ": PHIEUNHAPKHO" as DB_PNK #White

UI -> SYS: Yêu cầu tải danh sách nhà cung cấp
activate SYS
deactivate SYS

SYS -> DB_NCC: Truy vấn danh sách nhà cung cấp đang hoạt động
activate DB_NCC
deactivate DB_NCC

SYS -->> UI: Hiển thị danh sách ban đầu

group opt Tìm kiếm nhà cung cấp
    autonumber stop
    TK -[hidden]-> DB_NCC
    autonumber resume "<b>##."
    TK -> UI: Gõ từ khóa vào ô tìm kiếm
    activate UI
    deactivate UI
    
    UI -> SYS: Yêu cầu lọc nhà cung cấp theo từ khóa
    activate SYS
    deactivate SYS
    
    SYS -->> UI: Cập nhật danh sách sau khi lọc (hoặc toàn bộ nếu từ khóa rỗng)
end

TK -> UI: Chọn một nhà cung cấp
activate UI
deactivate UI

UI -> SYS: Yêu cầu lấy thông tin chi tiết nhà cung cấp
activate SYS
deactivate SYS

SYS -> DB_NCC: Lấy dữ liệu chi tiết
activate DB_NCC
deactivate DB_NCC

SYS -->> UI: Hiển thị chi tiết hồ sơ nhà cung cấp

group opt Xem lịch sử giao dịch
    autonumber stop
    TK -[hidden]-> DB_NCC
    autonumber resume "<b>##."
    TK -> UI: Nhấn "Xem lịch sử giao dịch"
    activate UI
    deactivate UI
    
    UI -> SYS: Yêu cầu lấy danh sách phiếu nhập kho
    activate SYS
    deactivate SYS
    
    SYS -> DB_PNK: Truy vấn các phiếu nhập kho của nhà cung cấp này
    activate DB_PNK
    deactivate DB_PNK
    
    SYS -->> UI: Hiển thị danh sách các phiếu nhập có liên quan
end

@enduml
