@startuml SuaNhaCungCap
mainframe sd Seq_SuaNhaCungCap
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

    skinparam noteBackgroundColor transparent
    skinparam noteBorderColor transparent

actor "Thủ kho" as TK #White
boundary "Form_SuaNhaCungCap" as FRM #White
boundary "GUI_NhaCungCap" as UI #White
control "Controller_NhaCungCap" as SYS #White
entity ": NHACUNGCAP" as DB_NCC #White

TK -> UI: Chọn sửa một nhà cung cấp
activate UI
deactivate UI

UI -->> FRM: Hiển thị biểu mẫu sửa

FRM -> SYS: Yêu cầu lấy thông tin
activate SYS
deactivate SYS

SYS -> DB_NCC: Lấy dữ liệu nhà cung cấp theo ID
activate DB_NCC
deactivate DB_NCC

SYS -->> FRM: Hiển thị biểu mẫu với thông tin hiện tại

group opt Hủy thao tác
    autonumber stop
    TK -[hidden]-> DB_NCC
    autonumber resume "<b>##."
    TK -> FRM: Nhấn nút "Hủy"
    activate FRM
    deactivate FRM
    
FRM -> SYS: Yêu cầu đóng form
    activate SYS
    deactivate SYS
    
    SYS -->> UI: Đóng biểu mẫu, không lưu dữ liệu
end


TK -> FRM: Chỉnh sửa thông tin và nhấn "Lưu"
activate FRM
deactivate FRM

FRM -> SYS: Gửi dữ liệu cập nhật
activate SYS
deactivate SYS

SYS -> SYS: Kiểm tra tính hợp lệ và tên không trùng với NCC khác
activate SYS
deactivate SYS

group alt Kiểm tra dữ liệu
    note over of TK: [Thông tin không hợp lệ hoặc trùng tên]
    autonumber stop
    TK -[hidden]-> DB_NCC
    autonumber resume "<b>##."
    SYS -->> UI: Thông báo lỗi và giữ nguyên biểu mẫu
else 
    note over of TK: [Thông tin hợp lệ]
    autonumber stop
    TK -[hidden]-> DB_NCC
    autonumber resume "<b>##."
    SYS -> DB_NCC: Cập nhật thông tin nhà cung cấp
    activate DB_NCC
    deactivate DB_NCC

    SYS -> SYS: Kiểm tra kết quả cập nhật
    activate SYS
    deactivate SYS
    
    group alt Kết quả cập nhật
        note over of TK: [Lưu thất bại]
        autonumber stop
        TK -[hidden]-> DB_NCC
        autonumber resume "<b>##."
        SYS -->> UI: Thông báo lỗi lưu dữ liệu
    else 
        note over of TK: [Lưu thành công (kể cả không có thay đổi)]
        autonumber stop
        TK -[hidden]-> DB_NCC
        autonumber resume "<b>##."
        SYS -->> UI: Thông báo thành công và làm mới danh sách
    end
end

@enduml
