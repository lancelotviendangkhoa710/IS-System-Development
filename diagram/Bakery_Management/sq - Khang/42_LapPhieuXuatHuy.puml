@startuml LapPhieuXuatHuy
mainframe sd Seq_LapPhieuXuatHuy
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

    skinparam noteBackgroundColor transparent
    skinparam noteBorderColor transparent

actor "Thủ kho" as TK #White
boundary "Form_LapPhieuXuatHuy" as FRM #White
boundary "GUI_KhoVaNguyenLieu" as UI #White
control "Controller_KhoVaNguyenLieu" as SYS #White
entity ": NGUYENLIEU" as DB_NL #White
entity ": PHIEUXUATHUY" as DB_PXH #White
entity ": CHITIETPHIEUXUATHUY" as DB_CTPXH #White
entity ": THEKHO" as DB_TKHO #White

TK -> UI: Chọn chức năng lập phiếu xuất hủy
activate UI
deactivate UI

UI -> SYS: Yêu cầu mở form lập phiếu xuất hủy
activate SYS
deactivate SYS

SYS -> DB_NL: Lấy danh sách nguyên liệu (tồn kho > 0)
activate DB_NL
deactivate DB_NL

SYS -->> UI: Trả về danh sách dữ liệu

UI -->> FRM: Hiển thị biểu mẫu lập phiếu mới

group opt Hủy thao tác
    autonumber stop
    TK -[hidden]-> DB_TKHO
    autonumber resume "<b>##."
    TK -> FRM: Nhấn nút "Hủy"
    activate FRM
    deactivate FRM
    
FRM -> SYS: Yêu cầu đóng form
    activate SYS
    deactivate SYS
    
    SYS -->> UI: Đóng biểu mẫu, không lưu dữ liệu
end


TK -> FRM: Nhập lý do xuất hủy
activate FRM
deactivate FRM

loop Thêm nguyên liệu vào phiếu
    TK -> FRM: Chọn nguyên liệu, nhập số lượng và thêm vào phiếu
    activate FRM
    deactivate FRM
    
FRM -> SYS: Thêm nguyên liệu vào danh sách tạm
    activate SYS
    deactivate SYS
    
    SYS -->> FRM: Cập nhật chi tiết phiếu
end

TK -> FRM: Nhấn xác nhận lưu phiếu xuất hủy
activate FRM
deactivate FRM

FRM -> SYS: Gửi dữ liệu phiếu xuất hủy
activate SYS
deactivate SYS

SYS -> SYS: Kiểm tra tính hợp lệ (phiếu rỗng, số lượng hủy <= tồn kho)
activate SYS
deactivate SYS

group alt Kiểm tra dữ liệu
    note over of TK: [Phiếu rỗng hoặc số lượng hủy quá tồn kho]
    autonumber stop
    TK -[hidden]-> DB_TKHO
    autonumber resume "<b>##."
    SYS -->> UI: Thông báo lỗi và giữ nguyên biểu mẫu
else 
    note over of TK: [Dữ liệu hợp lệ]
    autonumber stop
    TK -[hidden]-> DB_TKHO
    autonumber resume "<b>##."
    SYS -> DB_PXH: Lưu thông tin phiếu xuất hủy
    activate DB_PXH
    deactivate DB_PXH
    
    SYS -> DB_CTPXH: Lưu chi tiết các nguyên liệu hủy
    activate DB_CTPXH
    deactivate DB_CTPXH

    SYS -> DB_NL: Trừ số lượng tồn kho
    activate DB_NL
    deactivate DB_NL

    SYS -> DB_TKHO: Ghi nhận biến động thẻ kho
    activate DB_TKHO
    deactivate DB_TKHO

    SYS -> SYS: Kiểm tra kết quả lưu
    activate SYS
    deactivate SYS
    
    group alt Kết quả lưu
        note over of TK: [Lưu thất bại]
        autonumber stop
        TK -[hidden]-> DB_TKHO
        autonumber resume "<b>##."
        SYS -->> UI: Thông báo lỗi lưu dữ liệu
    else 
        note over of TK: [Lưu thành công]
        autonumber stop
        TK -[hidden]-> DB_TKHO
        autonumber resume "<b>##."
        SYS -->> UI: Thông báo thành công và làm mới màn hình
    end
end

@enduml
