@startuml ThemLoaiThuChi
mainframe sd Seq_ThemLoaiThuChi
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

    skinparam noteBackgroundColor transparent
    skinparam noteBorderColor transparent

actor "Quản lý" as QL #White
boundary "Form_ThemLoaiThuChi" as FRM #White
boundary "GUI_QuanLyThuChi" as UI #White
control "Controller_QuanLyThuChi" as SYS #White
entity ": LOAITHUCHI" as DB_LTC #White

QL -> UI: Chọn thêm loại thu chi mới
activate UI
deactivate UI

UI -->> FRM: Hiển thị biểu mẫu (mặc định là khoản thu)

group opt Hủy thao tác
    autonumber stop
    QL -[hidden]-> DB_LTC
    autonumber resume "<b>##."
    QL -> FRM: Nhấn nút "Hủy"
    activate FRM
    deactivate FRM
    
FRM -> SYS: Yêu cầu đóng form
    activate SYS
    deactivate SYS
    
    SYS -->> UI: Đóng biểu mẫu, không lưu dữ liệu
end


QL -> FRM: Nhập tên, chọn phân loại (thu hoặc chi) và nhấn "Lưu"
activate FRM
deactivate FRM

FRM -> SYS: Gửi dữ liệu loại thu chi mới
activate SYS
deactivate SYS

SYS -> SYS: Kiểm tra tính hợp lệ (tên không rỗng, phân loại hợp lệ)
activate SYS
deactivate SYS

group alt Kiểm tra dữ liệu
    note over of QL: [Tên trống hoặc phân loại không hợp lệ]
    autonumber stop
    QL -[hidden]-> DB_LTC
    autonumber resume "<b>##."
    SYS -->> UI: Thông báo lỗi và giữ nguyên biểu mẫu
else 
    note over of QL: [Thông tin hợp lệ]
    autonumber stop
    QL -[hidden]-> DB_LTC
    autonumber resume "<b>##."
    SYS -> DB_LTC: Lưu loại thu chi mới
    activate DB_LTC
    deactivate DB_LTC

    SYS -> SYS: Kiểm tra kết quả lưu
    activate SYS
    deactivate SYS
    
    group alt Kết quả lưu
        note over of QL: [Lưu thất bại]
        autonumber stop
        QL -[hidden]-> DB_LTC
        autonumber resume "<b>##."
        SYS -->> UI: Thông báo lỗi lưu dữ liệu
    else 
        note over of QL: [Lưu thành công]
        autonumber stop
        QL -[hidden]-> DB_LTC
        autonumber resume "<b>##."
        SYS -->> UI: Thông báo thành công và làm mới danh sách
    end
end

@enduml
