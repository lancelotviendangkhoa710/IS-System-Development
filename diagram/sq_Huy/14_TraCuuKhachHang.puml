@startuml TraCuuKhachHang
mainframe sd Seq_TraCuuKhachHang
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

    skinparam noteBackgroundColor transparent
    skinparam noteBorderColor transparent

actor "Nhân viên" as NV #White
boundary "GUI_KhachHang" as UI #White
control "Controller_KhachHang" as SYS #White
entity ": HANGTHANHVIEN" as DB_HTV #White
entity ": KHACHHANG" as DB_KH #White

NV -> UI: Mở màn hình quản lý khách hàng
activate UI
deactivate UI

UI -> SYS: Yêu cầu tải danh sách
activate SYS
deactivate SYS

SYS -> DB_KH: Truy vấn danh sách khách hàng hoạt động
activate DB_KH
deactivate DB_KH

SYS -> DB_HTV: Lấy thông tin hạng thành viên
activate DB_HTV
deactivate DB_HTV

SYS -->> UI: Cập nhật danh sách lên bảng

NV -> UI: Gõ từ khóa tìm kiếm (Họ tên, SĐT, Địa chỉ, Mã KH)
activate UI
deactivate UI

UI -> SYS: Gửi sự kiện tìm kiếm
activate SYS
deactivate SYS

SYS -> DB_KH: Truy vấn kết hợp từ khóa và bộ lọc
activate DB_KH
deactivate DB_KH

SYS -> DB_HTV: Lấy thông tin hạng thành viên
activate DB_HTV
deactivate DB_HTV

SYS -> SYS: Xử lý kết quả trả về
activate SYS
deactivate SYS

group alt Xử lý kết quả trả về
    note over of NV: [Không có kết quả]
    autonumber stop
    NV -[hidden]-> DB_KH
    autonumber resume "<b>##."
    SYS -->> UI: Hiển thị danh sách rỗng
else 
    note over of NV: [Có kết quả]
    autonumber stop
    NV -[hidden]-> DB_KH
    autonumber resume "<b>##."
    SYS -->> UI: Hiển thị danh sách kết quả lọc
    
    NV -> UI: Chuyển trang qua thanh phân trang
    activate UI
    deactivate UI
    
    UI -> SYS: Yêu cầu tải trang mới
    activate SYS
    deactivate SYS
    
    SYS -> DB_KH: Truy vấn trang dữ liệu mới
    activate DB_KH
    deactivate DB_KH

    SYS -> DB_HTV: Lấy thông tin hạng thành viên
    activate DB_HTV
    deactivate DB_HTV
    
    SYS -->> UI: Hiển thị danh sách mới
end

@enduml
