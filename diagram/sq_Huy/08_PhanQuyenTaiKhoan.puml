@startuml PhanQuyenTaiKhoan
mainframe sd Seq_PhanQuyenTaiKhoan
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

    skinparam noteBackgroundColor transparent
    skinparam noteBorderColor transparent

actor "Quản lý" as QL #White
boundary "GUI_PhanQuyen" as UI #White
control "Controller_PhanQuyen" as SYS #White
entity ": CHUCNANG" as DB_CN #White
entity ": VAITRO_CHUCNANG" as DB_VC #White
entity ": NHANVIEN" as DB_NV #White
entity ": TAIKHOAN" as DB_TK #White

QL -> UI: Chọn chức năng phân quyền tài khoản
activate UI
deactivate UI

UI -> UI: Hiển thị danh sách tài khoản
activate UI
deactivate UI

QL -> UI: Chọn tài khoản cần phân quyền
activate UI
deactivate UI

UI -> SYS: Yêu cầu quyền hạn hiện tại
activate SYS
deactivate SYS

SYS -> DB_CN: Lấy danh sách chức năng
activate DB_CN
deactivate DB_CN

SYS -> DB_VC: Lấy danh sách quyền hạn theo vai trò của tài khoản
activate DB_VC
deactivate DB_VC

SYS -->> UI: Hiển thị danh sách quyền hạn

QL -> UI: Chọn cấp phát/thu hồi quyền và nhấn Lưu
activate UI
deactivate UI

UI -> SYS: Gửi thông tin phân quyền mới
activate SYS
deactivate SYS

SYS -> DB_TK: Kiểm tra tài khoản có bị vô hiệu hóa không
activate DB_TK
deactivate DB_TK

group alt Kiểm tra tài khoản có bị vô hiệu hóa không
    note over of QL: [Tài khoản bị vô hiệu hóa]
    autonumber stop
    QL -[hidden]-> DB_NV
    autonumber resume "<b>##."
    SYS -->> UI: Cảnh báo không thể đổi quyền
else 
    note over of QL: [Tài khoản đang hoạt động]
    autonumber stop
    QL -[hidden]-> DB_NV
    autonumber resume "<b>##."
    SYS -> DB_VC: Cập nhật quyền hạn chi tiết
    activate DB_VC
    deactivate DB_VC
    
    group alt Cập nhật quyền hạn chi tiết
        note over of QL: [Lỗi lưu dữ liệu]
        autonumber stop
        QL -[hidden]-> DB_TK
        autonumber resume "<b>##."
        SYS -->> UI: Thông báo lỗi
    else 
        note over of QL: [Lưu thành công]
        autonumber stop
        QL -[hidden]-> DB_NV
        autonumber resume "<b>##."
        SYS -->> UI: Thông báo thành công và làm mới màn hình
    end
end

@enduml
