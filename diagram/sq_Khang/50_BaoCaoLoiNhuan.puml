@startuml BaoCaoLoiNhuan
mainframe sd Seq_BaoCaoLoiNhuan
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

    skinparam noteBackgroundColor transparent
    skinparam noteBorderColor transparent

actor "Quản lý" as QL #White
boundary "GUI_BaoCaoLoiNhuan" as UI #White
control "Controller_BaoCaoThongKe" as SYS #White
entity ": HOADON" as DB_HD #White
entity ": CTDONHANG" as DB_CTDH #White
entity ": PHIEUTHUCHI" as DB_PTC #White

QL -> UI: Chọn chức năng báo cáo lợi nhuận
activate UI
deactivate UI

QL -> UI: Chọn khoảng thời gian và nhấn "Tạo báo cáo"
activate UI
deactivate UI

UI -> SYS: Gửi yêu cầu thống kê lợi nhuận
activate SYS
deactivate SYS

SYS -> DB_HD: Tính toán tổng doanh thu từ hóa đơn bán hàng hoàn tất
activate DB_HD
deactivate DB_HD

SYS -> DB_CTDH: Tính toán tổng chi phí từ giá vốn
activate DB_CTDH
deactivate DB_CTDH

SYS -> DB_PTC: Tính toán chi phí khác từ phí thu chi
activate DB_PTC
deactivate DB_PTC

SYS -> SYS: Tính toán lợi nhuận gộp và tỷ suất lợi nhuận
activate SYS
deactivate SYS

group alt Kết quả tính toán
    note over QL: [Lỗi tính toán hoặc kết nối]
    autonumber stop
    QL -[hidden]-> DB_PTC
    autonumber resume "<b>##."
    SYS -->> UI: Thông báo lỗi, không hiển thị báo cáo
else 
    note over QL: [Không có doanh thu]
    autonumber stop
    QL -[hidden]-> DB_PTC
    autonumber resume "<b>##."
    SYS -->> UI: Hiển thị báo cáo trống
else 
    note over QL: [Tính toán thành công]
    autonumber stop
    QL -[hidden]-> DB_PTC
    autonumber resume "<b>##."
    SYS -->> UI: Hiển thị báo cáo: doanh thu, chi phí, lợi nhuận gộp, tỷ suất lợi nhuận
end

@enduml
