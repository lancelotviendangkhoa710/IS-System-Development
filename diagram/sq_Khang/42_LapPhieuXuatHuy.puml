@startuml LapPhieuXuatHuy
mainframe sd Seq_LapPhieuXuatHuy
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

    skinparam noteBackgroundColor transparent
    skinparam noteBorderColor transparent

actor "Thủ kho" as TK #White
boundary "Form_LapPhieuXuatHuy" as FRM #White
boundary "GUI_KhoVaNguyenLieu" as UI #White
control "Controller_GiaoDichKho" as SYS #White
entity ": SANPHAM" as DB_SP #White
entity ": PHIEUXUATKHO" as DB_PXK #White
entity ": CTPHIEUXUAT_TP" as DB_CTPXK #White

TK -> UI: Chọn chức năng lập phiếu xuất kho
activate UI
deactivate UI

UI -> SYS: Yêu cầu mở tùy chọn lập phiếu
activate SYS
deactivate SYS

UI -->> FRM: Hiển thị tùy chọn lý do lập phiếu

group opt Hủy thao tác
    autonumber stop
    TK -[hidden]-> DB_CTPXK
    autonumber resume "<b>##."
    TK -> FRM: Nhấn nút "Hủy"
    activate FRM
    deactivate FRM
    
FRM -> SYS: Yêu cầu đóng form
    activate SYS
    deactivate SYS
    
    SYS -->> UI: Đóng biểu mẫu, không lưu dữ liệu
end

group alt Chọn lý do xuất kho
    note over of TK: [Bảo quản hỏng]
    autonumber stop
    TK -[hidden]-> DB_CTPXK
    autonumber resume "<b>##."
    TK -> FRM: Chọn "Xuất vì bánh bảo quản hỏng"
    activate FRM
    deactivate FRM
else
    note over of TK: [Sai sót khi làm bánh]
    autonumber stop
    TK -[hidden]-> DB_CTPXK
    autonumber resume "<b>##."
    TK -> FRM: Chọn "Xuất vì sai sót trong làm bánh"
    activate FRM
    deactivate FRM
end

FRM -> SYS: Yêu cầu hiển thị thông tin sản phẩm
activate SYS
deactivate SYS

SYS -> DB_SP: Lấy danh sách sản phẩm
activate DB_SP
deactivate DB_SP    
SYS -->> FRM: Trả về danh sách sản phẩm

TK -> FRM: Chọn sản phẩm và điền số lượng
activate FRM
deactivate FRM

FRM -> SYS: Gửi thông tin sản phẩm
activate SYS
deactivate SYS

TK -> FRM: Nhấn xác nhận lưu phiếu xuất
activate FRM
deactivate FRM

FRM -> SYS: Gửi dữ liệu phiếu xuất kho
activate SYS
deactivate SYS

SYS -> SYS: Kiểm tra tính hợp lệ
activate SYS
deactivate SYS

group alt Kiểm tra dữ liệu
    note over of TK: [Dữ liệu không hợp lệ]
    autonumber stop
    TK -[hidden]-> DB_CTPXK
    autonumber resume "<b>##."
    SYS -->> UI: Thông báo lỗi và trả về màn hình Bếp
else 
    note over of TK: [Dữ liệu hợp lệ]
    autonumber stop
    TK -[hidden]-> DB_CTPXK
    autonumber resume "<b>##."
    SYS -> DB_PXK: Lưu thông tin phiếu xuất kho
    activate DB_PXK
    deactivate DB_PXK
    
    SYS -> DB_CTPXK: Lưu chi tiết các sản phẩm xuất
    activate DB_CTPXK
    deactivate DB_CTPXK

    SYS -> DB_SP: Trừ số lượng tồn kho\nsản phẩm tương ứng
    activate DB_SP
    deactivate DB_SP

    SYS -> SYS: Kiểm tra kết quả lưu
    activate SYS
    deactivate SYS
    
    group alt Kết quả lưu
        note over of TK: [Lưu thất bại]
        autonumber stop
        TK -[hidden]-> DB_CTPXK
        autonumber resume "<b>##."
        SYS -->> UI: Thông báo lỗi lưu dữ liệu
    else 
        note over of TK: [Lưu thành công]
        autonumber stop
        TK -[hidden]-> DB_CTPXK
        autonumber resume "<b>##."
        SYS -->> UI: Thông báo thành công và làm mới màn hình
    end
end

@enduml
