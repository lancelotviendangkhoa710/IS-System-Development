@startuml LapPhieuNhapKho
mainframe sd Seq_LapPhieuNhapKho
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

    skinparam noteBackgroundColor transparent
    skinparam noteBorderColor transparent

actor "Thủ kho" as TK #White
boundary "Form_LapPhieuNhapKho" as FRM #White
boundary "GUI_KhoVaNguyenLieu" as UI #White
control "Controller_GiaoDichKho" as SYS #White
entity ": NHACUNGCAP" as DB_NCC #White
entity ": NGUYENLIEU" as DB_NL #White
entity ": PHIEUNHAPKHO" as DB_PNK #White
entity ": CTPHIEUNHAP" as DB_CTPNK #White

TK -> UI: Chọn chức năng lập phiếu nhập kho
activate UI
deactivate UI

UI -> SYS: Yêu cầu mở form lập phiếu
activate SYS
deactivate SYS

SYS -> DB_NCC: Lấy danh sách nhà cung cấp
activate DB_NCC
deactivate DB_NCC

SYS -> DB_NL: Lấy danh sách nguyên liệu
activate DB_NL
deactivate DB_NL

SYS -->> UI: Trả về danh sách dữ liệu

UI -->> FRM: Hiển thị biểu mẫu lập phiếu mới

group opt Hủy thao tác
    autonumber stop
    TK -[hidden]-> DB_CTPNK
    autonumber resume "<b>##."
    TK -> FRM: Nhấn nút "Hủy"
    activate FRM
    deactivate FRM
    
FRM -> SYS: Yêu cầu đóng form
    activate SYS
    deactivate SYS
    
    SYS -->> UI: Đóng biểu mẫu, không lưu dữ liệu
end

TK -> FRM: Chọn nhà cung cấp và\nđiền chi tiết lô hàng
activate FRM
deactivate FRM

group loop Thêm nguyên liệu vào phiếu
    autonumber stop
    TK -[hidden]-> DB_CTPNK
    autonumber resume "<b>##."
    TK -> FRM: Chọn nguyên liệu, nhập số lượng,\nđơn giá và thêm vào phiếu
    activate FRM
    deactivate FRM
    
FRM -> SYS: Thêm nguyên liệu vào danh sách tạm
    activate SYS
    deactivate SYS
    
    SYS -> SYS: Tính toán lại tổng tiền
    activate SYS
    deactivate SYS
    
    SYS -->> FRM: Cập nhật chi tiết phiếu và tổng tiền
end

TK -> FRM: Nhấn xác nhận lưu phiếu nhập
activate FRM
deactivate FRM

FRM -> SYS: Gửi dữ liệu phiếu nhập kho
activate SYS
deactivate SYS

SYS -> SYS: Kiểm tra tính hợp lệ
activate SYS
deactivate SYS

group alt Kiểm tra dữ liệu
    note over of TK: [Dữ liệu không hợp lệ]
    autonumber stop
    TK -[hidden]-> DB_CTPNK
    autonumber resume "<b>##."
    SYS -->> UI: Thông báo lỗi và giữ nguyên biểu mẫu
else 
    note over of TK: [Dữ liệu hợp lệ]
    autonumber stop
    TK -[hidden]-> DB_CTPNK
    autonumber resume "<b>##."
    SYS -> DB_PNK: Lưu thông tin phiếu nhập kho
    activate DB_PNK
    deactivate DB_PNK
    
    SYS -> DB_CTPNK: Lưu chi tiết các nguyên liệu nhập
    activate DB_CTPNK
    deactivate DB_CTPNK

    SYS -> DB_NL: Cập nhật số lượng tồn kho
    activate DB_NL
    deactivate DB_NL

    SYS -> SYS: Kiểm tra kết quả lưu
    activate SYS
    deactivate SYS
    
    group alt Kết quả lưu
        note over of TK: [Lưu thất bại]
        autonumber stop
        TK -[hidden]-> DB_CTPNK
        autonumber resume "<b>##."
        SYS -->> UI: Thông báo lỗi lưu dữ liệu
    else 
        note over of TK: [Lưu thành công]
        autonumber stop
        TK -[hidden]-> DB_CTPNK
        autonumber resume "<b>##."
        SYS -->> UI: Thông báo thành công và làm mới màn hình
    end
end



@enduml
