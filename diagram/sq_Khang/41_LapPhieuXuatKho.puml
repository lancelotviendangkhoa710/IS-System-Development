@startuml LapPhieuXuatKho
mainframe sd Seq_LapPhieuXuatKho
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

    skinparam noteBackgroundColor transparent
    skinparam noteBorderColor transparent

actor "Thợ bếp" as TB #White
boundary "Form_LapPhieuXuatKho" as FRM #White
boundary "GUI_KhoVaNguyenLieu" as UI #White
control "Controller_KhoVaNguyenLieu" as SYS #White
entity ": SANPHAM" as DB_SP #White
entity ": NGUYENLIEU" as DB_NL #White
entity ": CONGTHUC" as DB_CT #White
entity ": PHIEUXUATKHO" as DB_PXK #White
entity ": CTPHIEUXUAT_NL" as DB_CTPXK #White

TB -> UI: Chọn chức năng lập phiếu xuất kho
activate UI
deactivate UI

UI -> SYS: Yêu cầu mở tùy chọn lập phiếu
activate SYS
deactivate SYS

UI -->> FRM: Hiển thị tùy chọn lý do lập phiếu

group opt Hủy thao tác
    autonumber stop
    TB -[hidden]-> DB_CTPXK
    autonumber resume "<b>##."
    TB -> FRM: Nhấn nút "Hủy"
    activate FRM
    deactivate FRM
    
FRM -> SYS: Yêu cầu đóng form
    activate SYS
    deactivate SYS
    
    SYS -->> UI: Đóng biểu mẫu, không lưu dữ liệu
end

group alt Chọn lý do xuất kho
    note over of TB: [Làm bánh]
    autonumber stop
    TB -[hidden]-> DB_CTPXK
    autonumber resume "<b>##."
    TB -> FRM: Chọn "Xuất để làm bánh"
    activate FRM
    deactivate FRM
    
    FRM -> SYS: Yêu cầu hiển thị thông tin sản phẩm
    activate SYS
    deactivate SYS
    
    SYS -> DB_SP: Lấy danh sách sản phẩm
    activate DB_SP
    deactivate DB_SP    
    SYS -->> FRM: Trả về danh sách sản phẩm

    TB -> FRM: Chọn sản phẩm và điền số lượng
    activate FRM
    deactivate FRM

    FRM -> SYS: Gửi thông tin sản phẩm
    activate SYS
    deactivate SYS

    SYS -> DB_CT: Lấy dữ liệu công thức theo mã sản phẩm
    activate DB_CT
    deactivate DB_CT

    DB_NL -->> SYS: Trả về dữ liệu nguyên liệu theo mã sản phẩm
else
    note over of TB: [Nguyên liệu hỏng]
    autonumber stop
    TB -[hidden]-> DB_CTPXK
    autonumber resume "<b>##."
    TB -> FRM: Chọn "Xuất vì nguyên liệu hỏng"
    activate FRM
    deactivate FRM

    FRM -> SYS: Yêu cầu hiển thị thông tin nguyên liệu
    activate SYS
    deactivate SYS

    SYS -> DB_NL: Lấy danh sách nguyên liệu
    activate DB_NL
    deactivate DB_NL

    SYS -->> FRM: Trả về danh sách nguyên liệu

    TB -> FRM: Chọn nguyên liệu và điền số lượng
    activate FRM
    deactivate FRM

    FRM -> SYS: Gửi thông tin nguyên liệu
    activate SYS
    deactivate SYS
end

TB -> FRM: Nhấn xác nhận lưu phiếu xuất
activate FRM
deactivate FRM

FRM -> SYS: Gửi dữ liệu phiếu xuất kho
activate SYS
deactivate SYS

SYS -> SYS: Kiểm tra tính hợp lệ
activate SYS
deactivate SYS

group alt Kiểm tra dữ liệu
    note over of TB: [Dữ liệu không hợp lệ]
    autonumber stop
    TB -[hidden]-> DB_CTPXK
    autonumber resume "<b>##."
    SYS -->> UI: Thông báo lỗi và trả về màn hình Bếp
else 
    note over of TB: [Dữ liệu hợp lệ]
    autonumber stop
    TB -[hidden]-> DB_CTPXK
    autonumber resume "<b>##."
    SYS -> DB_PXK: Lưu thông tin phiếu xuất kho
    activate DB_PXK
    deactivate DB_PXK
    
    SYS -> DB_CTPXK: Lưu chi tiết các nguyên liệu xuất
    activate DB_CTPXK
    deactivate DB_CTPXK

    SYS -> DB_NL: Trừ số lượng tồn kho\nnguyên liệu tương ứng
    activate DB_NL
    deactivate DB_NL

    SYS -> SYS: Kiểm tra kết quả lưu
    activate SYS
    deactivate SYS
    
    group alt Kết quả lưu
        note over of TB: [Lưu thất bại]
        autonumber stop
        TB -[hidden]-> DB_CTPXK
        autonumber resume "<b>##."
        SYS -->> UI: Thông báo lỗi lưu dữ liệu
    else 
        note over of TB: [Lưu thành công]
        autonumber stop
        TB -[hidden]-> DB_CTPXK
        autonumber resume "<b>##."
        SYS -->> UI: Thông báo thành công và làm mới màn hình
    end
end

@enduml