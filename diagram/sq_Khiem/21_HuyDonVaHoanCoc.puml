@startuml HuyDonVaHoanCoc
mainframe sd Seq_HuyDonVaHoanCoc
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

skinparam noteBackgroundColor transparent
skinparam noteBorderColor transparent

actor "Nhân viên" as NV #White
boundary "Form_HuyDon" as FRM #White
boundary "GUI_BanHang" as UI #White
control "Controller_BanHang" as SYS #White
entity ": DONDATHANG" as DB_DDH #White

NV -> UI: Chọn hủy đơn từ chi tiết đơn
activate UI
deactivate UI

UI -->> FRM: Hiển thị biểu mẫu xác nhận hủy
activate FRM
deactivate FRM

group opt Hủy thao tác
    autonumber stop
    NV -[hidden]-> DB_DDH
    autonumber resume "<b>##."
    NV -> FRM: Nhấn "Hủy"
    activate FRM
    deactivate FRM
    FRM -->> UI: Đóng biểu mẫu
end

NV -> FRM: Nhập lý do hủy và tiếp tục
activate FRM
deactivate FRM

FRM -> SYS: Kiểm tra thông tin đơn hàng
activate SYS
deactivate SYS

SYS -> DB_DDH: Truy vấn thông tin cọc
activate DB_DDH
deactivate DB_DDH

SYS -->> FRM: Hiển thị thông tin cọc
NV -> FRM: Xác nhận phương thức hoàn tiền và nhấn "Xác nhận"
activate FRM
deactivate FRM

FRM -> SYS: Gửi yêu cầu hủy và hoàn cọc
activate SYS
deactivate SYS

SYS -> SYS: Kiểm tra tính hợp lệ
activate SYS
deactivate SYS

group alt Kiểm tra
    note over of NV: [Lỗi]
    autonumber stop
    NV -[hidden]-> DB_DDH
    autonumber resume "<b>##."
    SYS -->> FRM: Thông báo lỗi
else
    note over of NV: [Hợp lệ]
    autonumber stop
    NV -[hidden]-> DB_DDH
    autonumber resume "<b>##."
    SYS -> DB_DDH: Cập nhật trạng thái "Đã hủy"
    activate DB_DDH
    deactivate DB_DDH
    
    SYS -> DB_DDH: Ghi nhận hoàn cọc
    activate DB_DDH
    deactivate DB_DDH
    
    SYS -->> UI: Thông báo thành công và làm mới màn hình
end
@enduml
