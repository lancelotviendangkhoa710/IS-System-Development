@startuml TraCuuCongThuc
mainframe sd Seq_TraCuuCongThuc
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

skinparam noteBackgroundColor transparent
skinparam noteBorderColor transparent

actor "Quản lý" as QL #White
boundary "GUI_CongThuc" as UI #White
control "Controller_CongThuc" as SYS #White
entity ": CONGTHUC" as DB_CT #White

QL -> UI: Nhập từ khóa tìm kiếm
activate UI
deactivate UI

UI -> SYS: Yêu cầu tìm kiếm
activate SYS
deactivate SYS

SYS -> DB_CT: Truy vấn danh sách
activate DB_CT
deactivate DB_CT

SYS -->> UI: Trả về kết quả

QL -> UI: Chọn một sản phẩm
activate UI
deactivate UI

UI -> SYS: Yêu cầu chi tiết
activate SYS
deactivate SYS

SYS -> DB_CT: Lấy bảng chi tiết công thức
activate DB_CT
deactivate DB_CT

SYS -->> UI: Hiển thị bảng định lượng chi tiết
@enduml
