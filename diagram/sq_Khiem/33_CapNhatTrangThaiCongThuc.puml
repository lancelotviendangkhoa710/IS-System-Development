@startuml CapNhatTrangThaiCongThuc
mainframe sd Seq_CapNhatTrangThaiCongThuc
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

skinparam noteBackgroundColor transparent
skinparam noteBorderColor transparent

actor "Quản lý" as QL #White
boundary "GUI_CongThuc" as UI #White
control "Controller_CongThuc" as SYS #White
entity ": CONGTHUC" as DB_CT #White

QL -> UI: Chọn sản phẩm và nhấn Vô hiệu hóa/Khôi phục
activate UI
deactivate UI

UI -->> QL: Hiển thị xác nhận

group opt Xác nhận
    autonumber stop
    QL -[hidden]-> DB_CT
    autonumber resume "<b>##."
    QL -> UI: Nhấn Xác nhận
    activate UI
    deactivate UI
    
    UI -> SYS: Gửi yêu cầu cập nhật
    activate SYS
    deactivate SYS
    
    SYS -> DB_CT: Lưu trạng thái mới
    activate DB_CT
    deactivate DB_CT
    
    SYS -->> UI: Thông báo thành công và làm mới danh sách
end
@enduml
