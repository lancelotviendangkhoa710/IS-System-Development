@startuml ThemCongThuc
mainframe sd Seq_ThemCongThuc
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

skinparam noteBackgroundColor transparent
skinparam noteBorderColor transparent

actor "Quản lý" as QL #White
boundary "Form_CongThuc" as FRM #White
boundary "GUI_CongThuc" as UI #White
control "Controller_CongThuc" as SYS #White
entity ": CONGTHUC" as DB_CT #White

QL -> UI: Chọn sản phẩm chưa có công thức và chọn Thêm
activate UI
deactivate UI

UI -->> FRM: Mở biểu mẫu thêm công thức
activate FRM
deactivate FRM

QL -> FRM: Nhấn "Thêm dòng", chọn nguyên liệu, nhập số lượng
activate FRM
deactivate FRM

QL -> FRM: Nhấn "Lưu công thức"
activate FRM
deactivate FRM

FRM -> SYS: Gửi dữ liệu công thức
activate SYS
deactivate SYS

SYS -> SYS: Kiểm tra hợp lệ (không trùng nguyên liệu, SL > 0)
activate SYS
deactivate SYS

group alt Kiểm tra
    note over of QL: [Lỗi dữ liệu]
    autonumber stop
    QL -[hidden]-> DB_CT
    autonumber resume "<b>##."
    SYS -->> FRM: Thông báo lỗi
else
    note over of QL: [Hợp lệ]
    autonumber stop
    QL -[hidden]-> DB_CT
    autonumber resume "<b>##."
    SYS -> DB_CT: Lưu công thức mới
    activate DB_CT
    deactivate DB_CT
    
    SYS -->> UI: Thông báo thành công và làm mới danh sách
end
@enduml
