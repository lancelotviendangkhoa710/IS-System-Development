@startuml SuaCongThuc
mainframe sd Seq_SuaCongThuc
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

skinparam noteBackgroundColor transparent
skinparam noteBorderColor transparent

actor "Quản lý" as QL #White
boundary "Form_CongThuc" as FRM #White
boundary "GUI_CongThuc" as UI #White
control "Controller_CongThuc" as SYS #White
entity ": CONGTHUC" as DB_CT #White

QL -> UI: Chọn sản phẩm đã có công thức và nhấn Sửa
activate UI
deactivate UI

UI -> SYS: Yêu cầu tải chi tiết công thức
activate SYS
deactivate SYS

SYS -> DB_CT: Lấy dữ liệu công thức
activate DB_CT
deactivate DB_CT

SYS -->> FRM: Hiển thị bảng định lượng
activate FRM
deactivate FRM

QL -> FRM: Chỉnh sửa dòng, thêm bớt và nhấn "Lưu"
activate FRM
deactivate FRM

FRM -> SYS: Gửi dữ liệu cập nhật
activate SYS
deactivate SYS

SYS -> SYS: Kiểm tra tính hợp lệ
activate SYS
deactivate SYS

group alt Kiểm tra
    note over of QL: [Dữ liệu không hợp lệ]
    autonumber stop
    QL -[hidden]-> DB_CT
    autonumber resume "<b>##."
    SYS -->> FRM: Báo lỗi
else
    note over of QL: [Hợp lệ]
    autonumber stop
    QL -[hidden]-> DB_CT
    autonumber resume "<b>##."
    SYS -> DB_CT: Cập nhật công thức
    activate DB_CT
    deactivate DB_CT
    
    SYS -->> UI: Thông báo thành công
end
@enduml
