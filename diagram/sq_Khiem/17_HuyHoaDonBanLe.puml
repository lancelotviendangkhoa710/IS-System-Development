@startuml HuyHoaDonBanLe
mainframe sd Seq_HuyHoaDonBanLe
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

skinparam noteBackgroundColor transparent
skinparam noteBorderColor transparent

actor "Quản lý / Thu ngân" as NV #White
boundary "Form_HuyHoaDon" as FRM #White
boundary "GUI_BanHang" as UI #White
control "Controller_BanHang" as SYS #White
entity ": HOADON" as DB_HD #White
entity ": SANPHAM" as DB_SP #White

NV -> UI: Chọn chức năng hủy đơn/trả hàng và chọn hóa đơn
activate UI
deactivate UI

UI -> SYS: Yêu cầu thông tin hóa đơn
activate SYS
deactivate SYS

SYS -> DB_HD: Lấy chi tiết hóa đơn
activate DB_HD
deactivate DB_HD

SYS -->> UI: Hiển thị chi tiết
UI -->> FRM: Hiển thị biểu mẫu hủy
activate FRM
deactivate FRM

group opt Hủy thao tác
    autonumber stop
    NV -[hidden]-> DB_SP
    autonumber resume "<b>##."
    NV -> FRM: Nhấn "Hủy"
    activate FRM
    deactivate FRM
    FRM -->> UI: Đóng biểu mẫu
end

NV -> FRM: Nhập lý do và xác nhận hủy
activate FRM
deactivate FRM

FRM -> SYS: Gửi yêu cầu hủy hóa đơn
activate SYS
deactivate SYS

SYS -> SYS: Kiểm tra điều kiện hủy
activate SYS
deactivate SYS

group alt Kiểm tra điều kiện
    note over of NV: [Không đủ điều kiện/Lỗi]
    autonumber stop
    NV -[hidden]-> DB_SP
    autonumber resume "<b>##."
    SYS -->> FRM: Báo lỗi, từ chối hủy
else
    note over of NV: [Hợp lệ]
    autonumber stop
    NV -[hidden]-> DB_SP
    autonumber resume "<b>##."
    SYS -> DB_HD: Cập nhật trạng thái "Đã hủy"
    activate DB_HD
    deactivate DB_HD
    
    SYS -> DB_HD: Lưu giao dịch hoàn tiền
    activate DB_HD
    deactivate DB_HD
    
    SYS -> DB_SP: Hoàn trả số lượng tồn kho
    activate DB_SP
    deactivate DB_SP
    
    SYS -->> UI: Thông báo thành công và làm mới màn hình
end
@enduml
