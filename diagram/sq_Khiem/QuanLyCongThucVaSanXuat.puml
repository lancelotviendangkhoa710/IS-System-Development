@startuml QuanLyCongThucVaSanXuat
mainframe sd Seq_QuanLyCongThuc
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

skinparam noteBackgroundColor transparent
skinparam noteBorderColor transparent

actor "Quản lý" as QL #White
boundary "GUI_CongThuc" as UI #White
control "Controller_CongThuc" as SYS #White
entity ": CONGTHUC" as DB_CT #White
entity ": SANPHAM" as DB_SP #White

UI -> UI: Mở màn hình quản lý công thức
activate UI
deactivate UI

UI -> SYS: Yêu cầu tải dữ liệu
activate SYS
deactivate SYS

SYS -> DB_SP: Truy vấn sản phẩm
activate DB_SP
deactivate DB_SP

SYS -> DB_CT: Truy vấn công thức
activate DB_CT
deactivate DB_CT

SYS -->> UI: Hiển thị danh sách

QL -> UI: Chọn chức năng
activate UI
deactivate UI

group opt Thêm công thức
    autonumber stop
    QL -[hidden]-> DB_SP
    autonumber resume "<b>##."
    ref over QL, DB_SP: Thêm công thức (Seq_ThemCongThuc)
end

group opt Sửa công thức
    autonumber stop
    QL -[hidden]-> DB_SP
    autonumber resume "<b>##."
    ref over QL, DB_SP: Sửa công thức (Seq_SuaCongThuc)
end

group opt Cập nhật trạng thái công thức
    autonumber stop
    QL -[hidden]-> DB_SP
    autonumber resume "<b>##."
    ref over QL, DB_SP: Cập nhật trạng thái (Seq_CapNhatTrangThaiCongThuc)
end

group opt Tra cứu công thức
    autonumber stop
    QL -[hidden]-> DB_SP
    autonumber resume "<b>##."
    ref over QL, DB_SP: Tra cứu công thức (Seq_TraCuuCongThuc)
end

group opt Tính toán số lượng bánh làm ra
    autonumber stop
    QL -[hidden]-> DB_SP
    autonumber resume "<b>##."
    ref over QL, DB_SP: Tính số lượng bánh (Seq_TinhToanSoLuongBanhLamRa)
end

group opt Cấu hình giới hạn nhận đơn
    autonumber stop
    QL -[hidden]-> DB_SP
    autonumber resume "<b>##."
    ref over QL, DB_SP: Cấu hình giới hạn (Seq_CauHinhGioiHanNhanDon)
end
@enduml
