<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="24.0" style="-fx-background-color: #f9f9f9;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bakery.controllers.CustomerInfoController">
    <padding>
        <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
    </padding>

    <!-- ==================== STAT CARD (gộp) ==================== -->
    <VBox style="-fx-background-color: white; -fx-background-radius: 14px; -fx-padding: 18px 24px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 2, 4); -fx-border-color: #e8e8e8; -fx-border-radius: 14px;">
        <HBox alignment="CENTER">
            <!-- Phần Tổng khách hàng đang hoạt động -->
            <VBox alignment="CENTER_LEFT" spacing="4" HBox.hgrow="ALWAYS">
                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #666; -fx-text-transform: uppercase;" text="Tổng khách hàng đang hoạt động" />
                <Label fx:id="lblTotalCustomers" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="0" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #888;" text="👥  Khách hàng" />
            </VBox>

            <!-- Đường phân cách -->
            <Region prefHeight="60" prefWidth="1" style="-fx-background-color: #e0e0e0;" />

            <!-- Phần Khách hàng mới trong tháng -->
            <VBox alignment="CENTER_LEFT" spacing="4" style="-fx-padding: 0 0 0 28px;" HBox.hgrow="ALWAYS">
                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #666; -fx-text-transform: uppercase;" text="Khách hàng mới trong tháng" />
                <Label fx:id="lblNewCustomers" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="0" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #888;" text="🧑‍🤝‍🧑  Trong tháng" />
            </VBox>
        </HBox>
    </VBox>

    <!-- ==================== SEARCH BAR ==================== -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: #eeeeee; -fx-background-radius: 20; -fx-padding: 4 16;">
            <Label style="-fx-font-size: 16px; -fx-text-fill: #78716c;" text="🔍" />
            <TextField fx:id="searchField" prefHeight="29.0" prefWidth="303.0" promptText="Tìm theo tên, SĐT, mã KH, địa chỉ" style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
        </HBox>
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <!-- ==================== HEADER & BUTTONS ==================== -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <Label text="Danh sách khách hàng">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnRefresh" onAction="#refreshCustomerData" styleClass="secondary-button" text="↻ Làm mới" />
        <Button onAction="#goToDeletedView" styleClass="secondary-button" text="🗑 Thùng rác" />
        <Button onAction="#openTierManagementDialog" styleClass="secondary-button" text="🧑‍💼 Quản lý hạng" />
        <Button onAction="#openAddCustomerDialog" styleClass="primary-button" text="➕ Thêm khách hàng" />
    </HBox>

    <!-- ==================== TABLE + PAGINATION (gộp chung) ==================== -->
    <VBox prefHeight="608.0" prefWidth="1077.0"
          style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e2e2e2; -fx-border-radius: 12;"
          VBox.vgrow="ALWAYS">

        <!-- Bảng dữ liệu -->
        <TableView fx:id="customerTable"
                   style="-fx-background-color: white; -fx-table-cell-border-color: transparent; -fx-border-color: transparent;"
                   styleClass="customer-info-table"
                   VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="Mã KH">
                    <cellValueFactory><PropertyValueFactory property="maKH" /></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colName" prefWidth="180.0" text="Tên khách hàng">
                    <cellValueFactory><PropertyValueFactory property="hoTen" /></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colPhone" prefWidth="140.0" text="Số điện thoại">
                    <cellValueFactory><PropertyValueFactory property="sdt" /></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colAddress" prefWidth="200.0" text="Địa chỉ">
                    <cellValueFactory><PropertyValueFactory property="diaChi" /></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colRegDate" prefWidth="120.0" text="Ngày đăng ký">
                    <cellValueFactory><PropertyValueFactory property="ngayDangKy" /></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colPoints" prefWidth="130.0" text="Điểm">
                    <cellValueFactory><PropertyValueFactory property="diemTichLuy" /></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colTier" prefWidth="100.0" text="Hạng" />
                <TableColumn fx:id="colActions" prefWidth="120.0" text="Thao tác" />
            </columns>
        </TableView>

        <!-- Đường kẻ phân cách -->
        <Region prefHeight="1" style="-fx-background-color: #e8e8e8;" />

        <!-- Thanh phân trang + nút Xuất Excel -->
        <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-padding: 10 16;">
            <Label fx:id="lblPageInfo"
                   style="-fx-text-fill: #50453b; -fx-font-size: 13px;"
                   text="Hiển thị 1-10 của 0" />

            <!-- Spacer đẩy các nút sang phải -->
            <Region HBox.hgrow="ALWAYS" />

            <Button mnemonicParsing="false" prefHeight="28.0" prefWidth="150.0"
                    text="📥 Xuất Excel"
                    styleClass="secondary-button" 
                    onAction="#exportCustomersToExcel"
                    />

            <HBox fx:id="paginationBox" spacing="4.0" />
        </HBox>
    </VBox>

</VBox>
