<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox maxHeight="600.0" prefWidth="750.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 20, 0, 0, 10);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bakery.controllers.CustomerDeletedController">

    <!-- ==================== HEADER (giống HTML) ==================== -->
    <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 16 20; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
        <!-- Icon thùng rác (đỏ) -->
        <Label style="-fx-font-size: 24px; -fx-text-fill: #ba1a1a;" text="🗑" />
        <!-- Tiêu đề -->
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1c1917;" text="Thùng rác - Khách hàng đã xóa" />
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <!-- ==================== BODY (bảng dữ liệu) ==================== -->
    <TableView fx:id="deletedTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colMaKH" prefWidth="100.0" text="Mã KH" />
            <TableColumn fx:id="colTenKH" prefWidth="180.0" text="Tên khách hàng" />
            <TableColumn fx:id="colSDT" prefWidth="140.0" text="SĐT" />
            <TableColumn fx:id="colNgayXoa" prefWidth="160.0" text="Ngày xóa" />
            <TableColumn fx:id="colThaoTac" prefWidth="169.14283098493308" text="Thao tác" />
        </columns>
    </TableView>

    <!-- ==================== FOOTER (giống HTML) ==================== -->
    <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-padding: 12 20; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
        <Label fx:id="lblPageInfo" style="-fx-text-fill: #50453b; -fx-font-size: 14px;" text="Hiển thị 0 khách hàng" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnPrevPage" disable="true" onAction="#goToPreviousPage" styleClass="pagination-button" text="◀" />
        <Button fx:id="btnPage1" onAction="#goToSelectedPage" styleClass="pagination-button" text="1" />
        <Button fx:id="btnPage2" onAction="#goToSelectedPage" styleClass="pagination-button" text="2" />
        <Button fx:id="btnPage3" onAction="#goToSelectedPage" styleClass="pagination-button" text="3" />
        <Label fx:id="lblPageEllipsis" style="-fx-text-fill: #50453b;" text="..." />
        <Button fx:id="btnNextPage" onAction="#goToNextPage" styleClass="pagination-button" text="▶" />
    </HBox>
</VBox>
