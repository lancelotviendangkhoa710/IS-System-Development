<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bakery.controllers.MainController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="top-bar">
            <padding>
                <Insets bottom="0" left="24" right="24" top="0" />
            </padding>
            <Region HBox.hgrow="ALWAYS" />
            <Button alignment="TOP_LEFT" contentDisplay="TEXT_ONLY" styleClass="sidebar-button" text="🔔 Notification" wrapText="true" />
            <ImageView fx:id="avatar" fitHeight="32" fitWidth="32" preserveRatio="true" />
        </HBox>
    </top>

    <center>
        <SplitPane fx:id="mainSplitPane" dividerPositions="0.18">
            <items>
                <!-- Sidebar -->
                <VBox fx:id="sidebar" maxWidth="350" minWidth="180" prefWidth="256" styleClass="sidebar">
                    <!-- Nội dung sidebar giữ nguyên -->
                    <VBox alignment="CENTER_LEFT" spacing="8">
                        <Label styleClass="sidebar-logo-text" text="Artisan Manager" />
                        <Label styleClass="sidebar-subtitle" text="Floor Operations" />
                    </VBox>
                    <VBox spacing="4" VBox.vgrow="ALWAYS">
                        <Button fx:id="btnCustomers" styleClass="sidebar-button, sidebar-button-active" text="👥 Customers" />
                    </VBox>
                    <VBox spacing="4" VBox.vgrow="NEVER">
                        <Button fx:id="btnSettings" styleClass="sidebar-button" text="⚙️ Settings" />
                        <Button fx:id="btnLogout" styleClass="sidebar-button" text="↩ Logout" />
                    </VBox>
                </VBox>

                <!-- Content Area -->
                <StackPane fx:id="contentArea" style="-fx-background-color: #f9f9f9;" VBox.vgrow="ALWAYS" />
            </items>
        </SplitPane>
    </center>
</BorderPane>
