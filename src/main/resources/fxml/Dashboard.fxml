<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="680.0" prefWidth="1280.0"
            xmlns="http://javafx.com/javafx/24"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bakery.views.controllers.MainController">
    <left>
        <VBox prefWidth="300.0" spacing="12.0">
            <padding>
                <Insets top="24.0" right="20.0" bottom="24.0" left="20.0"/>
            </padding>
            <Label text="Menu theo quyền" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Label text="Các mục dưới đây được tạo từ quyền thực tế của role trong CSDL." wrapText="true"/>
            <Separator/>
            <VBox fx:id="menuContainer" spacing="10.0"/>
            <Separator/>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleShowOverview" text="Tổng quan"/>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleShowChangePassword" text="Đổi mật khẩu"/>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLogout" text="Đăng xuất"/>
        </VBox>
    </left>
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <padding>
                <Insets top="18.0" right="24.0" bottom="18.0" left="24.0"/>
            </padding>
            <VBox spacing="4.0">
                <Label text="Dashboard" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Label fx:id="lblCurrentView" text="Tổng quan"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox spacing="4.0">
                <Label text="Nhân viên"/>
                <Label fx:id="lblWelcome" style="-fx-font-weight: bold;"/>
            </VBox>
            <VBox spacing="4.0">
                <Label text="Vai trò"/>
                <Label fx:id="lblRole" style="-fx-font-weight: bold;"/>
            </VBox>
        </HBox>
    </top>
    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
            </padding>
            <Label fx:id="lblDashboardMessage" wrapText="true"/>
            <VBox fx:id="overviewPane" spacing="14.0">
                <Label text="Phiên đăng nhập đang hoạt động" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                <HBox spacing="12.0">
                    <Label text="Số quyền được cấp:"/>
                    <Label fx:id="lblPermissionCount" style="-fx-font-weight: bold;"/>
                </HBox>
                <Label fx:id="lblPermissionHint" wrapText="true"/>
                <Label text="Chọn từng mục trong menu để kiểm tra quyền đã tải từ DB." wrapText="true"/>
            </VBox>
            <VBox fx:id="changePasswordPane" managed="false" spacing="12.0" visible="false">
                <Label text="Đổi mật khẩu" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                <VBox spacing="8.0">
                    <Label text="Mật khẩu hiện tại"/>
                    <PasswordField fx:id="txtCurrentPassword" promptText="Nhập mật khẩu hiện tại"/>
                </VBox>
                <VBox spacing="8.0">
                    <Label text="Mật khẩu mới"/>
                    <PasswordField fx:id="txtNewPassword" promptText="Nhập mật khẩu mới"/>
                </VBox>
                <VBox spacing="8.0">
                    <Label text="Xác nhận mật khẩu mới"/>
                    <PasswordField fx:id="txtConfirmPassword" promptText="Nhập lại mật khẩu mới"/>
                </VBox>
                <Button fx:id="btnChangePassword" maxWidth="220.0" mnemonicParsing="false" onAction="#handleChangePassword" text="Cập nhật và đăng xuất"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
