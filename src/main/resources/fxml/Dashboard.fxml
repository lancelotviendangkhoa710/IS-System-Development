<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.bakery.presenters.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label fx:id="welcomeText" text="Hệ Thống Quản Lý Tiệm Bánh" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
    <Button text="Quản lý Sản phẩm (Demo)" onAction="#onHelloButtonClick" style="-fx-font-size: 14px; -fx-padding: 10px 20px;"/>
</VBox>
