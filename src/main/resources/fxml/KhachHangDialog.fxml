<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bakery.views.controllers.KhachHangDialogController"
      styleClass="dialog-container" prefWidth="520">

    <Label fx:id="lblTitle" text="Thêm Khách Hàng" styleClass="dialog-header-title"/>
    <Separator style="-fx-opacity: 0.3;"/>

    <GridPane styleClass="dialog-grid">
        <columnConstraints>
            <ColumnConstraints percentWidth="35"/>
            <ColumnConstraints percentWidth="65"/>
        </columnConstraints>

        <Label text="Họ tên *" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="dialog-label"/>
        <TextField fx:id="txtHoTen" promptText="Nhập tên khách hàng" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="text-field"/>

        <Label text="SĐT *" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="dialog-label"/>
        <TextField fx:id="txtSDT" promptText="VD: 0901234567" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="text-field"/>

        <Label text="Địa chỉ" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="dialog-label"/>
        <TextField fx:id="txtDiaChi" promptText="Nhập địa chỉ (tùy chọn)" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="text-field"/>
    </GridPane>

    <Label fx:id="lblError" text="" styleClass="dialog-error" wrapText="true"/>

    <HBox spacing="16" alignment="CENTER_RIGHT">
        <Button text="Hủy" onAction="#onHuy" styleClass="dialog-button-cancel"/>
        <Button fx:id="btnLuu" text="Lưu khách hàng" onAction="#onLuu" styleClass="dialog-button-save"/>
    </HBox>
</VBox>
