<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bakery.views.controllers.khachhang.LichSuMuaHangDialogViewFXMLController"
      spacing="0">

    <!-- Header -->
    <HBox styleClass="dialog-header" alignment="CENTER_LEFT" spacing="12">
        <Label fx:id="lblTieuDe" text="Lịch sử mua hàng" styleClass="dialog-header-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTenKhachHang" styleClass="lbl-body"/>
    </HBox>

    <!-- Summary cards -->
    <HBox styleClass="dialog-body" spacing="16">
        <padding><Insets bottom="0"/></padding>
        <VBox spacing="4" HBox.hgrow="ALWAYS" styleClass="card">
            <Label text="TỔNG ĐƠN" styleClass="lbl-small-bold"/>
            <Label fx:id="lblTongDon" text="0" styleClass="lbl-kpi"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS" styleClass="card">
            <Label text="TỔNG CHI TIÊU" styleClass="lbl-small-bold"/>
            <Label fx:id="lblTongChiTieu" text="0 đ" styleClass="lbl-price"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS" styleClass="card">
            <Label text="ĐÃ CỌC" styleClass="lbl-small-bold"/>
            <Label fx:id="lblTongCoc" text="0 đ" styleClass="lbl-price"/>
        </VBox>
    </HBox>

    <!-- Table -->
    <VBox styleClass="dialog-body" VBox.vgrow="ALWAYS" spacing="10">
        <TableView fx:id="tblLichSu" styleClass="table-view" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colMaDon"      text="Mã đơn"      prefWidth="80"/>
                <TableColumn fx:id="colNgayNhan"   text="Ngày nhận"   prefWidth="140"/>
                <TableColumn fx:id="colTrangThai"  text="Trạng thái"  prefWidth="130"/>
                <TableColumn fx:id="colHinhThuc"   text="Hình thức"   prefWidth="110"/>
                <TableColumn fx:id="colTongTien"   text="Tổng tiền"   prefWidth="130"/>
                <TableColumn fx:id="colDaCoc"      text="Đã cọc"      prefWidth="120"/>
                <TableColumn fx:id="colConLai"     text="Còn lại"     prefWidth="120"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>
        <Label fx:id="lblThongBao" styleClass="lbl-small-bold"/>
    </VBox>

    <!-- Footer -->
    <HBox styleClass="dialog-footer" alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="btnXuatPdf" text="📄 Xuất PDF"
                styleClass="btn-secondary" onAction="#onXuatPdf"/>
        <Button fx:id="btnXuatExcel" text="📥 Xuất Excel"
                styleClass="btn-secondary" onAction="#onXuatExcel"/>
        <Button text="✕ Đóng"
                styleClass="btn-secondary" onAction="#onDong"/>
    </HBox>

</VBox>
