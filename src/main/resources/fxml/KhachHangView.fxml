<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" styleClass="bg-app" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bakery.views.controllers.khachhang.KhachHangViewFXMLController">
    <padding>
        <Insets bottom="20" left="24" right="24" top="20" />
    </padding>

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Button onAction="#onBack" styleClass="btn-secondary" text="← Quay lại" />
        <VBox spacing="5">
            <Label styleClass="lbl-title-screen" text="Quản lý Khách hàng &amp; Hội viên" />
            <Label styleClass="lbl-body" text="Theo dõi thông tin khách hàng, tích điểm và quản lý các hạng thành viên" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <TabPane styleClass="modern-tab-pane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
            <Tab text="👥 Khách hàng">
                <content>
                    <VBox spacing="20" style="-fx-padding: 20 0 0 0;">
                        <!-- STAT CARDS -->
                        <HBox spacing="20">
                            <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="card">
                                <Label text="TỔNG KHÁCH HÀNG" styleClass="lbl-small-bold" />
                                <Label fx:id="lblTotalCustomers" text="0" styleClass="lbl-kpi" />
                                <Label text="Khách hàng đang hoạt động" styleClass="lbl-small" />
                            </VBox>
                            <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="card">
                                <Label text="KHÁCH HÀNG MỚI" styleClass="lbl-small-bold" />
                                <Label fx:id="lblNewCustomers" text="0" styleClass="lbl-kpi" />
                                <Label text="Đăng ký trong tháng này" styleClass="lbl-small" />
                            </VBox>
                        </HBox>

                        <!-- TOOLBAR -->
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <HBox alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS">
                                <TextField fx:id="searchField" prefHeight="35" prefWidth="350" promptText="🔍 Tìm theo tên, SĐT, mã KH..." styleClass="text-field" />
                                <Button fx:id="btnToggleFilter" onAction="#onToggleFilterClicked" styleClass="btn-secondary" text="Lọc nâng cao" />
                            </HBox>
                            <Button fx:id="btnRefresh" onAction="#onRefreshClicked" styleClass="btn-secondary" text="↻" />
                            <Button fx:id="btnCheDoThungRac" onAction="#onDeletedViewClicked" styleClass="btn-secondary" text="🗑 Thùng rác" />
                            <Button onAction="#onExportExcelClicked" styleClass="btn-secondary" text="📥 Xuất Excel" />
                            <Button onAction="#onAddCustomerClicked" styleClass="btn-primary" text="➕ Thêm khách hàng" />
                        </HBox>

                        <!-- FILTER PANEL -->
                        <HBox fx:id="filterPanel" alignment="CENTER_LEFT" spacing="15" managed="false" visible="false" styleClass="card">
                            <VBox spacing="5">
                                <Label text="Từ ngày" styleClass="lbl-small-bold" />
                                <DatePicker fx:id="dpFromDate" prefWidth="150" />
                            </VBox>
                            <VBox spacing="5">
                                <Label text="Đến ngày" styleClass="lbl-small-bold" />
                                <DatePicker fx:id="dpToDate" prefWidth="150" />
                            </VBox>
                            <VBox spacing="5">
                                <Label text="Hạng hội viên" styleClass="lbl-small-bold" />
                                <ComboBox fx:id="cbTierFilter" prefWidth="150" promptText="Tất cả" />
                            </VBox>
                            <Region HBox.hgrow="ALWAYS" />
                            <VBox alignment="BOTTOM_CENTER" spacing="8">
                                <HBox spacing="10">
                                    <Button onAction="#onApplyFilterClicked" styleClass="btn-primary" text="Áp dụng" />
                                    <Button onAction="#onClearFilterClicked" styleClass="btn-secondary" text="Xóa" />
                                </HBox>
                            </VBox>
                        </HBox>

                        <!-- TABLE CONTAINER -->
                        <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="10">
                            <TableView fx:id="customerTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colId" prefWidth="80" text="Mã KH" />
                                    <TableColumn fx:id="colName" prefWidth="200" text="Tên khách hàng" />
                                    <TableColumn fx:id="colPhone" prefWidth="120" text="Số điện thoại" />
                                    <TableColumn fx:id="colAddress" prefWidth="250" text="Địa chỉ" />
                                    <TableColumn fx:id="colRegDate" prefWidth="120" text="Ngày đăng ký" />
                                    <TableColumn fx:id="colPoints" prefWidth="100" text="Điểm" />
                                    <TableColumn fx:id="colTier" prefWidth="120" text="Hạng" />
                                    <TableColumn fx:id="colActions" prefWidth="150" text="Thao tác" />
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            </TableView>
                            
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <Label fx:id="lblPageInfo" styleClass="lbl-small" text="Hiển thị 1-10 của 0" />
                                <Region HBox.hgrow="ALWAYS" />
                                <HBox fx:id="paginationBox" spacing="5" alignment="CENTER_RIGHT" />
                            </HBox>
                        </VBox>
                    </VBox>
                </content>
            </Tab>
            <Tab text="🏅 Hạng thành viên">
                <content>
                    <fx:include source="HangThanhVienView.fxml" />
                </content>
            </Tab>
        </tabs>
    </TabPane>

    <!-- Footer Status -->
    <HBox>
        <Label fx:id="lblThongBao" styleClass="lbl-small-bold" />
    </HBox>
</VBox>
