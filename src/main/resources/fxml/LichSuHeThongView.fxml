<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bakery.views.controllers.hethong.LichSuHeThongViewFXMLController"
      spacing="20" styleClass="bg-app">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <VBox spacing="5">
            <Label text="Lịch Sử Hệ Thống" styleClass="lbl-title-screen"/>
            <Label text="Theo dõi toàn bộ thao tác của nhân viên trên hệ thống." styleClass="lbl-body"/>
        </VBox>
    </HBox>

    <!-- Card nội dung chính -->
    <VBox spacing="12" VBox.vgrow="ALWAYS" styleClass="card">

        <!-- Thanh công cụ -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Nhật ký thao tác" styleClass="lbl-title-card"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="txtTimKiem" promptText="🔍 Tìm theo nhân viên / hành động..."
                       prefWidth="280" onKeyReleased="#onTimKiem" styleClass="text-field"/>
            <ComboBox fx:id="cbBoLoc" prefWidth="150" promptText="Lọc theo Module"/>
            <Button text="🔄 Tải lại" onAction="#onTaiLai" styleClass="btn-secondary"/>
        </HBox>

        <!-- TableView -->
        <TableView fx:id="tblAuditLog" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colThoiGian"  text="Thời gian"         prefWidth="170"/>
                <TableColumn fx:id="colNguoiDung" text="Nhân viên"          prefWidth="200"/>
                <TableColumn fx:id="colHanhDong"  text="Module"             prefWidth="120"/>
                <TableColumn fx:id="colChiTiet"   text="Chi tiết thao tác"  prefWidth="380"/>
                <TableColumn fx:id="colTrangThai" text="Entity ID"          prefWidth="90"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>
    </VBox>
</VBox>
