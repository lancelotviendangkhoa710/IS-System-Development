<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="480.0" spacing="20.0" style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 12, 0, 0, 6);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bakery.views.controllers.customer.CustomerUpdateViewFXMLController">

    <!-- Header -->
    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1c1917;" text="Sửa thông tin khách hàng" />

    <!-- Mã KH (disabled) -->
    <VBox spacing="6.0">
        <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #50453b; -fx-text-transform: uppercase;" text="Mã KH" />
        <TextField fx:id="txtMaKH" editable="false" style="-fx-background-color: #e8e8e8; -fx-border-color: #d4c4b7; -fx-border-radius: 8; -fx-padding: 8; -fx-font-size: 14px; -fx-text-fill: #78716c;" />
    </VBox>

    <!-- Họ tên -->
    <VBox spacing="6.0">
        <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #50453b; -fx-text-transform: uppercase;" text="Họ tên *" />
        <TextField fx:id="txtHoTen" promptText="Nhập họ và tên" style="-fx-background-color: white; -fx-border-color: #d4c4b7; -fx-border-radius: 8; -fx-padding: 8; -fx-font-size: 14px;" />
    </VBox>

    <!-- Số điện thoại -->
    <VBox spacing="6.0">
        <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #50453b; -fx-text-transform: uppercase;" text="Số điện thoại *" />
        <TextField fx:id="txtSDT" promptText="Nhập số điện thoại (10 chữ số)" style="-fx-background-color: white; -fx-border-color: #d4c4b7; -fx-border-radius: 8; -fx-padding: 8; -fx-font-size: 14px;" />
    </VBox>

    <!-- Địa chỉ -->
    <VBox spacing="6.0">
        <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #50453b; -fx-text-transform: uppercase;" text="Địa chỉ" />
        <TextArea fx:id="txtDiaChi" prefRowCount="3" promptText="Nhập địa chỉ" style="-fx-background-color: white; -fx-border-color: #d4c4b7; -fx-border-radius: 8; -fx-padding: 8; -fx-font-size: 14px;" wrapText="true" />
    </VBox>

    <!-- Hạng thành viên + Điểm tích lũy (cùng dòng) -->
    <HBox spacing="16.0">
        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #50453b; -fx-text-transform: uppercase;" text="Hạng thành viên" />
            <TextField fx:id="txtHangThanhVien" editable="false" style="-fx-background-color: #e8e8e8; -fx-border-color: #d4c4b7; -fx-border-radius: 8; -fx-padding: 8; -fx-font-size: 14px; -fx-text-fill: #78716c;" />
        </VBox>
        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #50453b; -fx-text-transform: uppercase;" text="Điểm tích lũy" />
            <TextField fx:id="txtDiemTichLuy" editable="false" style="-fx-background-color: #e8e8e8; -fx-border-color: #d4c4b7; -fx-border-radius: 8; -fx-padding: 8; -fx-font-size: 14px; -fx-text-fill: #78716c;" />
        </VBox>
    </HBox>

    <!-- Nút Hủy / Cập nhật -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Button onAction="#onCancelClicked" styleClass="secondary-button" text="Hủy" />
        <Button onAction="#onSaveClicked" styleClass="primary-button" text="Cập nhật" />
    </HBox>
</VBox>
