<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bakery.views.controllers.kho.KhoViewFXMLController"
      styleClass="bg-app"
      spacing="16">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="4">
            <Label text="Quản lý Kho hàng" styleClass="lbl-title-screen"/>
            <Label text="Theo dõi tồn kho, quản lý đơn nhập hàng và hậu cần." styleClass="lbl-body"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="➕ Tạo phiếu nhập mới" styleClass="btn-primary" onAction="#onActionTam"/>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <!-- Cột trái: Cảnh báo & Thống kê nhanh -->
        <VBox styleClass="card" spacing="10" prefWidth="320">
            <Label text="⚠️ Cảnh báo quan trọng" styleClass="lbl-title-card"/>
            <Button text="Bột mì - Sắp hết: Còn 5kg" styleClass="nav-item" maxWidth="Infinity" onAction="#onActionTam"/>
            <Button text="Men tươi - Hết hạn: 12/10/2023" styleClass="nav-item" maxWidth="Infinity" onAction="#onActionTam"/>
            <Button text="Vani - Cần nhập thêm" styleClass="nav-item" maxWidth="Infinity" onAction="#onActionTam"/>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox spacing="8" styleClass="dash-banner" style="-fx-padding: 15;">
                <Label text="Giá trị tồn kho: 12.450.000 đ" styleClass="lbl-small-bold" style="-fx-text-fill: white;"/>
                <Label text="Đơn nhập chờ: 08" styleClass="lbl-small-bold" style="-fx-text-fill: white;"/>
            </VBox>
        </VBox>

        <!-- Cột phải: Chi tiết đơn nhập -->
        <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Phiếu Nhập Kho (Purchase Order)" styleClass="lbl-title-card"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="PO-#2023-4492" styleClass="lbl-small-bold"/>
            </HBox>

            <HBox spacing="10">
                <TextField promptText="Chọn nhà cung cấp" styleClass="text-field" HBox.hgrow="ALWAYS"/>
                <TextField promptText="Ngày giao hàng dự kiến" styleClass="text-field" HBox.hgrow="ALWAYS"/>
            </HBox>

            <TableView fx:id="tblStock" styleClass="table-view" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colName" text="Tên mặt hàng" prefWidth="230"/>
                    <TableColumn fx:id="colType" text="Phân loại" prefWidth="110"/>
                    <TableColumn fx:id="colAmount" text="Số lượng tồn" prefWidth="150"/>
                    <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="150"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button text="➕ Thêm dòng mới" styleClass="btn-secondary" onAction="#onActionTam"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Lưu bản nháp" styleClass="btn-secondary" onAction="#onActionTam"/>
                <Button text="Xác nhận nhập kho" styleClass="btn-primary" onAction="#onActionTam"/>
            </HBox>
        </VBox>
    </HBox>

    <VBox styleClass="card" spacing="10">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Lịch sử nhập hàng &amp; Logistics" styleClass="lbl-title-card"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Xem tất cả lịch sử →" styleClass="btn-secondary" onAction="#onActionTam"/>
        </HBox>
        <FlowPane hgap="12" vgap="12">
            <Button text="🚚 Artisan Grain - Đã về 08:30" styleClass="nav-item" onAction="#onActionTam"/>
            <Button text="🚚 Normandy Dairy - Giao trễ 2h" styleClass="nav-item" onAction="#onActionTam"/>
            <Button text="🚚 Vanilla Dreams - Đã giao hôm qua" styleClass="nav-item" onAction="#onActionTam"/>
            <Button text="🚚 Pantry Plus - Đang chờ xử lý" styleClass="nav-item" onAction="#onActionTam"/>
        </FlowPane>
    </VBox>

    <HBox>
        <Label fx:id="lblThongBao" styleClass="lbl-small-bold"/>
    </HBox>
</VBox>
