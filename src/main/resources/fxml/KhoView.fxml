<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  KhoView.fxml — Trung tam Quan ly Kho hang.
  3 Tab: Nha cung cap | Kiem ke kho (Nguyen lieu + Ton kho) | Nhap kho.
  Controller: KhoViewFXMLController.
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bakery.views.controllers.kho.KhoViewFXMLController"
      styleClass="bg-app" spacing="0">

    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <!-- Header chung -->
    <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 0 0 16 0;">
        <VBox spacing="4">
            <Label text="QUAN LY KHO HANG" styleClass="lbl-header"/>
            <Label text="Nha cung cap · Kiem ke · Nguyen lieu · Nhap kho" styleClass="lbl-body-secondary"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblThongBao" styleClass="lbl-small-bold"/>
    </HBox>

    <!-- TabPane 3 tab chinh -->
    <TabPane fx:id="tabPaneKho" VBox.vgrow="ALWAYS"
             tabClosingPolicy="UNAVAILABLE"
             styleClass="tab-pane">

        <!-- Tab 1: Nha cung cap -->
        <Tab text="🏭  Nhà cung cấp" fx:id="tabNhaCungCap">
            <fx:include source="QuanLyNhaCungCapView.fxml"/>
        </Tab>

        <!-- Tab 2: Kiem ke kho — gom Nguyen lieu + Ton kho -->
        <Tab text="📊  Kiểm kê kho" fx:id="tabKiemKe">
            <VBox spacing="0">
                <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="tab-pane">
                    <Tab text="🌾  Nguyên liệu">
                        <fx:include source="NguyenLieuView.fxml"/>
                    </Tab>
                    <Tab text="📋  Tồn kho">
                        <fx:include source="KiemKeKhoView.fxml"/>
                    </Tab>
                </TabPane>
            </VBox>
        </Tab>

        <!-- Tab 3: Nhap kho -->
        <Tab text="📥  Nhập kho" fx:id="tabNhapKho">
            <fx:include source="NhapKhoView.fxml"/>
        </Tab>

    </TabPane>
</VBox>
