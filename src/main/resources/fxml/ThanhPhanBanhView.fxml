<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bakery.views.controllers.kho.ThanhPhanBanhController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Cot Banh Section -->
        <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="card">
            <Label text="Cốt bánh" styleClass="lbl-title-card" />
            <TableView fx:id="tblCotBanh" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colTenCot" text="Tên cốt bánh" prefWidth="120" />
                    <TableColumn fx:id="colGiaVonCot" text="Giá vốn" prefWidth="80" />
                    <TableColumn fx:id="colPhuPhiCot" text="Phụ phí" prefWidth="80" />
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>
            <HBox spacing="10">
                <Button text="➕" onAction="#onThemCot" styleClass="btn-primary" />
                <Button text="✏️" onAction="#onSuaCot" styleClass="btn-secondary" />
                <Button text="🗑" onAction="#onXoaCot" styleClass="btn-danger" />
            </HBox>
        </VBox>

        <!-- Nhan Banh Section -->
        <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="card">
            <Label text="Nhân bánh" styleClass="lbl-title-card" />
            <TableView fx:id="tblNhanBanh" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colTenNhan" text="Tên nhân bánh" prefWidth="120" />
                    <TableColumn fx:id="colGiaVonNhan" text="Giá vốn" prefWidth="80" />
                    <TableColumn fx:id="colPhuPhiNhan" text="Phụ phí" prefWidth="80" />
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>
            <HBox spacing="10">
                <Button text="➕" onAction="#onThemNhan" styleClass="btn-primary" />
                <Button text="✏️" onAction="#onSuaNhan" styleClass="btn-secondary" />
                <Button text="🗑" onAction="#onXoaNhan" styleClass="btn-danger" />
            </HBox>
        </VBox>

        <!-- Kieu Trang Tri Section -->
        <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="card">
            <Label text="Kiểu trang trí" styleClass="lbl-title-card" />
            <TableView fx:id="tblKieuTrangTri" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colTenTrangTri" text="Tên kiểu trang trí" prefWidth="120" />
                    <TableColumn fx:id="colGiaVonTrangTri" text="Giá vốn" prefWidth="80" />
                    <TableColumn fx:id="colPhuPhiTrangTri" text="Phụ phí" prefWidth="80" />
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>
            <HBox spacing="10">
                <Button text="➕" onAction="#onThemTrangTri" styleClass="btn-primary" />
                <Button text="✏️" onAction="#onSuaTrangTri" styleClass="btn-secondary" />
                <Button text="🗑" onAction="#onXoaTrangTri" styleClass="btn-danger" />
            </HBox>
        </VBox>
    </HBox>

    <!-- Cong Thuc Nguyen Lieu Section -->
    <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="card">
        <Label text="Chi tiết định mức nguyên liệu (Công thức cấu thành)" styleClass="lbl-title-card" />
        <TableView fx:id="tblCongThuc" VBox.vgrow="ALWAYS" prefHeight="150">
            <columns>
                <TableColumn fx:id="colTenNguyenLieu" text="Tên nguyên liệu (Bột, Sữa, Trứng,...)" prefWidth="250" />
                <TableColumn fx:id="colDinhMuc" text="Định mức (Lượng tiêu hao)" prefWidth="150" />
                <TableColumn fx:id="colDonGiaNL" text="Đơn giá" prefWidth="120" />
                <TableColumn fx:id="colThanhTienNL" text="Thành tiền (Giá vốn)" prefWidth="150" />
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>
    </VBox>
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="card">
        <Label text="Ước tính giá vốn khi kết hợp:" styleClass="lbl-body-bold" />
        <Label fx:id="lblTongGiaVon" styleClass="lbl-primary" text="0 đ" style="-fx-font-size: 16px;"/>
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lblThongBao" styleClass="lbl-small-bold" />
    </HBox>
</VBox>
