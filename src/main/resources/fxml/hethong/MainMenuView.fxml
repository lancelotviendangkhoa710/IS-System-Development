<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bakery.views.controllers.hethong.MainMenuViewFXMLController"
            styleClass="dashboard-root"
            >

    <!-- SIDEBAR -->
    <left>
        <VBox fx:id="vboxSidebar" styleClass="dash-sidebar" prefWidth="240">
            <!-- Header with Toggle -->
            <HBox fx:id="hboxLogo" alignment="CENTER_LEFT" spacing="10" styleClass="dash-logo-box">
                <children>
                    <Button fx:id="btnToggleSidebar" text="☰" onAction="#onToggleSidebar" styleClass="icon-btn" />
                    <Label fx:id="lblLogoText" text="H3K Bakery" styleClass="dash-logo-text"/>
                </children>
            </HBox>

            <!-- Navigation with Scroll -->
            <ScrollPane fx:id="scrollNav" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                <content>
                    <VBox styleClass="dash-nav" spacing="12">
                        <!-- PHÂN HỆ: TỔNG QUAN -->
                        <VBox spacing="4">
                            <Button fx:id="btnTongQuan" text="📊 Tổng quan" onAction="#onMoDashboard" styleClass="dash-nav-item" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                        </VBox>

                        <!-- PHÂN HỆ: NHÂN SỰ -->
                        <VBox spacing="4">
                            <Button fx:id="btnNhanSu" text="👥 Nhân sự" onAction="#onMoNhanSu" styleClass="dash-nav-item" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                        </VBox>

                        <!-- PHÂN HỆ: BÁN HÀNG -->
                        <VBox spacing="4">
                            <Button fx:id="btnBanHang" text="🛒 Bán hàng" onAction="#onMoBanHang" styleClass="dash-nav-item" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                        </VBox>

                        <!-- PHÂN HỆ: QUẢN LÝ KHÁCH HÀNG -->
                        <VBox spacing="4">
                            <Button fx:id="btnKhachHang" text="🤝 Khách hàng" onAction="#onMoKhachHang" styleClass="dash-nav-item" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                        </VBox>

                        <!-- PHÂN HỆ: SẢN PHẨM -->
                        <VBox spacing="4">
                            <Button fx:id="btnSanPham" text="🍰 Sản phẩm" onAction="#onMoSanPham" styleClass="dash-nav-item" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                        </VBox>

                        <!-- PHAN HE: KHO -->
                        <VBox spacing="4">
                            <Button fx:id="btnKho" text="📦 Kho" onAction="#onMoKho" styleClass="dash-nav-item" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                        </VBox>

                        <!-- PHAN HE: BEP -->
                        <VBox spacing="4">
                            <Button fx:id="btnBep" text="🍳 Bếp" onAction="#onMoBep" styleClass="dash-nav-item" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                        </VBox>


                        <!-- PHÂN HỆ: BÁO CÁO -->
                        <VBox spacing="4">
                            <Button fx:id="btnBaoCao" text="📈 Thống kê &amp; BC" onAction="#onMoBaoCao" styleClass="dash-nav-item" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                            <Button fx:id="btnAuditLogs" text="📜 Lịch sử hệ thống" onAction="#onMoLichSuHeThong" styleClass="dash-nav-item" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                            <Button fx:id="btnKhoiPhucDuLieu" text="🔄 Khôi phục dữ liệu" onAction="#onMoKhoiPhucDuLieu" styleClass="dash-nav-item" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </left>

    <!-- CENTER (Shell Area) -->
    <center>
        <BorderPane>
            <!-- HEADER -->
            <top>
                <HBox styleClass="dash-header" alignment="CENTER_LEFT">
                    <Region HBox.hgrow="ALWAYS"/>
                    <!-- User Profile -->
                    <HBox styleClass="dash-user-profile" spacing="12" alignment="CENTER">
                        <VBox alignment="CENTER_RIGHT">
                            <Label fx:id="lblTenNguoiDung" text="User Name" styleClass="dash-user-name"/>
                            <Label fx:id="lblVaiTro" text="ROLE ACCESS" styleClass="dash-user-role"/>
                        </VBox>
                        <Button fx:id="btnAvatar"
                                text="👤"
                                styleClass="dash-icon-btn"
                                onAction="#onMoThongTinCaNhan"/>
                        <Button text="🚪" styleClass="dash-icon-btn" onAction="#onDangXuat"/>
                    </HBox>
                </HBox>
            </top>

            <!-- DYNAMIC CONTENT AREA -->
            <center>
                <StackPane fx:id="contentArea" styleClass="dash-content-area" />
            </center>

            <bottom>
                <HBox alignment="CENTER_RIGHT" style="-fx-padding: 5 20; -fx-background-color: #f8f9fa;">
                    <Label fx:id="lblThongBao" style="-fx-text-fill: #DC2626; -fx-font-size: 12px;"/>
                </HBox>
            </bottom>
        </BorderPane>
    </center>
</BorderPane>
