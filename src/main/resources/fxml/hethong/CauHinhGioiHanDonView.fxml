<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" styleClass="bg-app"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bakery.views.controllers.hethong.CauHinhGioiHanDonViewFXMLController">

    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

    <!-- ① HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="⚙ Cấu hình giới hạn nhận đơn" styleClass="lbl-title-screen"/>
        <VBox spacing="3">
            <Label text="Thiết lập số lượng bánh tối đa bếp có thể sản xuất trong một ngày." styleClass="lbl-body"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="↺ Làm mới" styleClass="btn-reset" onAction="#onLamMoi"/>
    </HBox>

    <!-- ② CONTENT -->
    <HBox spacing="30" VBox.vgrow="ALWAYS">

        <!-- Left: Bảng cấu hình hiện tại -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <Label text="Danh sách cấu hình hiện tại" styleClass="lbl-title-card"/>
            <TableView fx:id="tblCauHinh" styleClass="table-view" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colLoai" text="Loại đơn"/>
                    <TableColumn fx:id="colGioiHan" text="Giới hạn (đơn/ngày)"/>
                    <TableColumn fx:id="colMoTa" text="Mô tả"/>
                    <TableColumn fx:id="colCapNhat" text="Cập nhật lần cuối"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Right: Form cấu hình -->
        <VBox spacing="20" styleClass="card" prefWidth="420" alignment="TOP_CENTER">
            <Label text="Thiết lập giới hạn" styleClass="lbl-title-card"/>

            <!-- Bánh tùy chỉnh -->
            <VBox spacing="8">
                <Label text="Giới hạn bánh tùy chỉnh (đơn/ngày): *" styleClass="lbl-body-bold"/>
                <TextField fx:id="txtGioiHanTuyChinhMoi" promptText="VD: 50"
                           styleClass="text-field"/>
                <Label text="Số đơn bánh tùy chỉnh tối đa được nhận trong 1 ngày" styleClass="lbl-body"/>
            </VBox>

            <!-- Giới hạn từng sản phẩm bán lẻ -->
            <VBox spacing="8">
                <Label text="Chọn sản phẩm bán lẻ:" styleClass="lbl-body-bold"/>
                <ComboBox fx:id="cmbSanPhamBanLe" promptText="-- Chọn sản phẩm --"
                          styleClass="combo-box" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="8">
                <Label text="Giới hạn số lượng sản phẩm (cái/ngày): *" styleClass="lbl-body-bold"/>
                <TextField fx:id="txtGioiHanSanPham" promptText="VD: 100"
                           styleClass="text-field"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Actions -->
            <VBox spacing="12" maxWidth="Infinity">
                <Button fx:id="btnLuuCauHinh" text="💾 Lưu cấu hình"
                        styleClass="btn-success" maxWidth="Infinity"
                        onAction="#onLuuCauHinh"/>
                <Button fx:id="btnHuy" text="✖ Hủy"
                        styleClass="btn-secondary" maxWidth="Infinity"
                        onAction="#onHuy"/>
            </VBox>
        </VBox>

    </HBox>

    <!-- ③ FOOTER STATUS BAR -->
    <HBox>
        <Label fx:id="lblThongBao" styleClass="lbl-small-bold"/>
    </HBox>

</VBox>
