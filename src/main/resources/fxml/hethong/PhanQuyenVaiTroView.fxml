<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListCell?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bakery.views.controllers.nhansu.PhanQuyenVaiTroViewFXMLController"
      spacing="20" styleClass="bg-app">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <VBox spacing="5">
            <Label text="Phân quyền chức năng" styleClass="lbl-title-screen"/>
            <Label text="Quản lý quyền truy cập của từng vai trò vào các chức năng hệ thống"
                   styleClass="lbl-small-bold"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Lưu phân quyền" fx:id="btnLuuPhanQuyen" styleClass="btn-success"
                onAction="#onLuuPhanQuyen"/>
        <Button text="↺ Làm mới" styleClass="btn-reset" onAction="#onLamMoi"/>
    </HBox>

    <!-- Main content: Left = Role list, Right = Permission grid -->
    <HBox spacing="24" VBox.vgrow="ALWAYS">

        <!-- Danh sách vai trò -->
        <VBox spacing="10" prefWidth="220" minWidth="200">
            <Label text="Chọn vai trò" styleClass="lbl-title-card"/>
            <ListView fx:id="lstVaiTro" VBox.vgrow="ALWAYS" styleClass="list-view"/>
        </VBox>

        <!-- Bảng phân quyền chức năng -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <Label fx:id="lblTenVaiTro" text="— Chọn vai trò bên trái —"
                   styleClass="lbl-title-card"/>

            <TableView fx:id="tblChucNang" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colTenChucNang" text="Chức năng" prefWidth="200"/>
                    <TableColumn fx:id="colModule"      text="Module"    prefWidth="100"/>
                    <TableColumn fx:id="colView"        text="Xem"       prefWidth="70"/>
                    <TableColumn fx:id="colAdd"         text="Thêm"      prefWidth="70"/>
                    <TableColumn fx:id="colEdit"        text="Sửa"       prefWidth="70"/>
                    <TableColumn fx:id="colDelete"      text="Xóa"       prefWidth="70"/>
                    <TableColumn fx:id="colDownload"    text="Xuất"      prefWidth="70"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <!-- Quick-grant buttons -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Cấp nhanh:" styleClass="lbl-small-bold"/>
                <Button text="✅ Cấp tất cả" styleClass="btn-success-sm" onAction="#onCapTatCa"/>
                <Button text="❌ Thu hồi tất cả" styleClass="btn-danger-sm" onAction="#onThuHoiTatCa"/>
            </HBox>
        </VBox>
    </HBox>

    <!-- Status bar -->
    <HBox>
        <Label fx:id="lblThongBao" styleClass="lbl-small-bold"/>
    </HBox>

</VBox>
