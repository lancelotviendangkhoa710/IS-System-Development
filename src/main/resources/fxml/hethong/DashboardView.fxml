<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="dash-scroll"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bakery.views.controllers.hethong.DashboardController">

    <VBox styleClass="dash-main-content" spacing="24">

        <!-- BANNER with decoration -->
        <StackPane>
            <HBox styleClass="dash-banner" alignment="CENTER_LEFT">
                <!-- Text bên trái -->
                <VBox styleClass="dash-banner-text-box" spacing="10" HBox.hgrow="ALWAYS">
                    <HBox alignment="BOTTOM_LEFT" spacing="6">
                        <Label text="🎉" style="-fx-font-size:28px;"/>
                        <Label text="Xin chào, " styleClass="dash-banner-title"/>
                        <Label fx:id="lblBannerName" text="user name" styleClass="dash-banner-title-name"/>
                    </HBox>
                    <Label text="Chào mừng bạn quay lại với hệ thống quản lý tiệm bánh H3K!"
                           styleClass="dash-banner-sub" wrapText="true" maxWidth="480"/>
                    <!-- KPI mini row -->
                    <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 8 0 0 0;">
                        <VBox alignment="CENTER" style="-fx-background-color:rgba(255,255,255,0.15);-fx-background-radius:10;-fx-padding:8 16;">
                            <Label text="📦" style="-fx-font-size:18px;"/>
                            <Label fx:id="lblKpiDon" text="—" style="-fx-font-weight:bold;-fx-font-size:20px;-fx-text-fill:white;"/>
                            <Label text="Đơn hôm nay" style="-fx-font-size:11px;-fx-text-fill:rgba(255,255,255,0.75);"/>
                        </VBox>
                        <VBox alignment="CENTER" style="-fx-background-color:rgba(255,255,255,0.15);-fx-background-radius:10;-fx-padding:8 16;">
                            <Label text="💰" style="-fx-font-size:18px;"/>
                            <Label fx:id="lblKpiDoanhThu" text="—" style="-fx-font-weight:bold;-fx-font-size:20px;-fx-text-fill:white;"/>
                            <Label text="Doanh thu hôm nay" style="-fx-font-size:11px;-fx-text-fill:rgba(255,255,255,0.75);"/>
                        </VBox>
                    </HBox>
                </VBox>
                <!-- Decoration emoji bên phải -->
                <VBox alignment="CENTER" HBox.hgrow="NEVER" style="-fx-padding:0 20 0 0;">
                    <Label text="🎂" styleClass="dash-banner-deco"/>
                </VBox>
            </HBox>
        </StackPane>

        <Label fx:id="lblThongBao" styleClass="dash-status-label"/>

        <!-- SECTION: Top 5 sản phẩm bán chạy + Biểu đồ (2 cột) -->
        <HBox spacing="20">

            <!-- Top 5 card (trái) -->
            <VBox styleClass="card" spacing="0" HBox.hgrow="ALWAYS" prefWidth="340" maxWidth="380">
                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding:0 0 12 0;">
                    <Label text="🏆" style="-fx-font-size:18px;"/>
                    <Label text="Top 5 sản phẩm bán chạy" styleClass="lbl-title-card"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblCapNhatTop5" text="" styleClass="lbl-small"/>
                </HBox>

                <!-- Rows được tạo động từ controller -->
                <VBox fx:id="vboxTop5" spacing="0"/>

                <!-- Placeholder nếu chưa có data -->
                <Label fx:id="lblTop5Empty" text="Chưa có dữ liệu bán hàng."
                       style="-fx-text-fill:#A8A29E;-fx-font-size:12px;-fx-padding:16 0;"
                       managed="false" visible="false"/>
            </VBox>

            <!-- Biểu đồ doanh thu (phải) -->
            <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="📈" style="-fx-font-size:16px;"/>
                    <Label text="Doanh thu 7 ngày gần nhất" styleClass="lbl-title-card"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblCapNhatChart" text="" styleClass="lbl-small"/>
                </HBox>

                <LineChart fx:id="chartDoanhThu" prefHeight="260"
                           styleClass="dash-chart" createSymbols="true">
                    <xAxis>
                        <CategoryAxis fx:id="axisNgay" label="Ngày" tickLabelRotation="0"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="axisDoanhThu" label="Doanh thu (đ)" forceZeroInRange="true"/>
                    </yAxis>
                </LineChart>
            </VBox>
        </HBox>

        <!-- SECTION: Bảng thống kê theo ngày -->
        <VBox styleClass="card" spacing="12">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="📋" style="-fx-font-size:16px;"/>
                <Label text="Chi tiết theo ngày (7 ngày gần nhất)" styleClass="lbl-title-card"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblCapNhatBang" text="" styleClass="lbl-small"/>
            </HBox>

            <TableView fx:id="tblThongKe" styleClass="table-view, dash-table" prefHeight="220">
                <columns>
                    <TableColumn fx:id="colNgay"          text="Ngày"           prefWidth="90"/>
                    <TableColumn fx:id="colDoanhThu"      text="Doanh thu"      prefWidth="160"/>
                    <TableColumn fx:id="colDonHoanThanh"  text="Đơn hoàn thành" prefWidth="140"/>
                    <TableColumn fx:id="colDonHuy"        text="Đơn hủy"        prefWidth="100"/>
                    <TableColumn fx:id="colTongDon"       text="Tổng đơn"       prefWidth="100"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

        <Region prefHeight="30"/>
    </VBox>
</ScrollPane>
