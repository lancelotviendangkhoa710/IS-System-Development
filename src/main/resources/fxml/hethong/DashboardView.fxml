<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="dash-scroll"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bakery.views.controllers.hethong.DashboardController">
    <VBox styleClass="dash-main-content" spacing="30">
        <!-- BANNER -->
        <HBox styleClass="dash-banner">
            <VBox styleClass="dash-banner-text-box" spacing="12" HBox.hgrow="ALWAYS">
                <HBox alignment="BOTTOM_LEFT">
                    <Label text="Xin chào, " styleClass="dash-banner-title"/>
                    <Label fx:id="lblBannerName" text="user name" styleClass="dash-banner-title-name"/>
                </HBox>
                <Label text="Chào mừng bạn quay lại với hệ thống quản lý tiệm bánh H3K!"
                       styleClass="dash-banner-sub" wrapText="true" maxWidth="500"/>
                <Region prefHeight="8"/>
                <HBox spacing="16">
                    <Button fx:id="btnTaoDonHang" text="Tạo đơn hàng mới"
                            styleClass="dash-btn-primary" onAction="#onMoBanHang"/>
                    <Button fx:id="btnQuanLyCa" text="Quản lý Ca làm việc"
                            styleClass="dash-btn-secondary" onAction="#onQuanLyCa"/>
                </HBox>
            </VBox>
        </HBox>

        <Label fx:id="lblThongBao" styleClass="dash-status-label"/>

        <!-- BEST SELLERS MENU -->
        <VBox spacing="16" styleClass="dash-best-seller-section">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="🌟 Bánh Bán Chạy Nhất" styleClass="dash-best-seller-title"/>
            </HBox>
            <FlowPane fx:id="flowBestSellersMenu" hgap="16" vgap="16" maxWidth="Infinity">
                <!-- Dynamic items loaded via Controller -->
            </FlowPane>
        </VBox>

        <!-- MODULES GRID -->
        <GridPane hgap="24" vgap="24" styleClass="dash-grid">
            <columnConstraints>
                <ColumnConstraints percentWidth="33.33"/>
                <ColumnConstraints percentWidth="33.33"/>
                <ColumnConstraints percentWidth="33.33"/>
            </columnConstraints>

            <!-- Card 1: POS -->
            <VBox fx:id="cardBanHang" styleClass="dash-card" GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="12">
                <StackPane styleClass="dash-icon-box, dash-icon-pos">
                    <Label text="🛒" styleClass="dash-icon-text, dash-icon-text-pos"/>
                </StackPane>
                <Label text="POS (Bán hàng)" styleClass="dash-card-title"/>
                <Label text="Manage daily sales, process payments, and generate digital receipts seamlessly."
                       styleClass="dash-card-desc" wrapText="true"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Button fx:id="btnBanHangCard" text="Truy cập ngay →"
                        styleClass="dash-card-action, dash-action-pos" onAction="#onMoBanHang"/>
            </VBox>

            <!-- Card 2: Inventory -->
            <VBox fx:id="cardKho" styleClass="dash-card" GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="12">
                <StackPane styleClass="dash-icon-box, dash-icon-inv">
                    <Label text="📦" styleClass="dash-icon-text, dash-icon-text-inv"/>
                </StackPane>
                <Label text="Inventory (Kho hàng)" styleClass="dash-card-title"/>
                <Label text="Track stock levels, manage ingredients, and set automated reorder alerts."
                       styleClass="dash-card-desc" wrapText="true"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Button fx:id="btnKhoCard" text="Kiểm kê kho →"
                        styleClass="dash-card-action, dash-action-inv" onAction="#onMoKho"/>
            </VBox>

            <!-- Card 3: Staff -->
            <VBox fx:id="cardNhanSu" styleClass="dash-card" GridPane.columnIndex="2" GridPane.rowIndex="0" spacing="12">
                <StackPane styleClass="dash-icon-box, dash-icon-staff">
                    <Label text="👥" styleClass="dash-icon-text, dash-icon-text-staff"/>
                </StackPane>
                <Label text="Staff (Nhân sự)" styleClass="dash-card-title"/>
                <Label text="Manage employee shifts, payroll, and performance metrics for the team."
                       styleClass="dash-card-desc" wrapText="true"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Button fx:id="btnNhanSuCard" text="Quản lý đội ngũ →"
                        styleClass="dash-card-action, dash-action-staff" onAction="#onMoNhanSu"/>
            </VBox>

            <!-- Card 4: Reports -->
            <VBox fx:id="cardBaoCao" styleClass="dash-card" GridPane.columnIndex="0" GridPane.rowIndex="1" spacing="12">
                <StackPane styleClass="dash-icon-box, dash-icon-report">
                    <Label text="📈" styleClass="dash-icon-text, dash-icon-text-report"/>
                </StackPane>
                <Label text="Business Reports" styleClass="dash-card-title"/>
                <Label text="Deep dive into financial health, popular items, and customer trends."
                       styleClass="dash-card-desc" wrapText="true"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Button fx:id="btnBaoCaoCard" text="Xem báo cáo →"
                        styleClass="dash-card-action, dash-action-report" onAction="#onMoBaoCao"/>
            </VBox>

            <!-- Card 5: KDS -->
            <VBox fx:id="cardKds" styleClass="dash-card" GridPane.columnIndex="1" GridPane.rowIndex="1" spacing="12">
                <StackPane styleClass="dash-icon-box, dash-icon-kds">
                    <Label text="👨‍🍳" styleClass="dash-icon-text, dash-icon-text-kds"/>
                </StackPane>
                <Label text="KDS (Màn hình bếp)" styleClass="dash-card-title"/>
                <Label text="Live kitchen display system to manage order queues and preparation times."
                       styleClass="dash-card-desc" wrapText="true"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Button fx:id="btnKdsCard" text="Điều phối bếp →"
                        styleClass="dash-card-action, dash-action-kds" onAction="#onMoKds"/>
            </VBox>

            <!-- Card 6: Audit Logs -->
            <VBox fx:id="cardAuditLogs" styleClass="dash-card" GridPane.columnIndex="2" GridPane.rowIndex="1" spacing="12">
                <StackPane styleClass="dash-icon-box, dash-icon-audit">
                    <Label text="🧾" styleClass="dash-icon-text, dash-icon-text-audit"/>
                </StackPane>
                <Label text="Audit Logs" styleClass="dash-card-title"/>
                <Label text="Monitor all system activities and security events for total transparency."
                       styleClass="dash-card-desc" wrapText="true"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Button fx:id="btnAuditLogsCard" text="Kiểm tra hệ thống →"
                        styleClass="dash-card-action, dash-action-audit" onAction="#onMoLichSuHeThong"/>
            </VBox>
        </GridPane>

        <Region prefHeight="40"/>
    </VBox>
</ScrollPane>
