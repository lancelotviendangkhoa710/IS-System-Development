<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="dash-scroll"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bakery.views.controllers.hethong.DashboardController">

    <VBox styleClass="dash-main-content" spacing="24">

        <!-- BANNER -->
        <HBox styleClass="dash-banner">
            <VBox styleClass="dash-banner-text-box" spacing="10" HBox.hgrow="ALWAYS">
                <HBox alignment="BOTTOM_LEFT">
                    <Label text="Xin chào, " styleClass="dash-banner-title"/>
                    <Label fx:id="lblBannerName" text="user name" styleClass="dash-banner-title-name"/>
                </HBox>
                <Label text="Chào mừng bạn quay lại với hệ thống quản lý tiệm bánh H3K!"
                       styleClass="dash-banner-sub" wrapText="true" maxWidth="500"/>
            </VBox>
        </HBox>

        <Label fx:id="lblThongBao" styleClass="dash-status-label"/>

        <!-- SECTION: Biểu đồ doanh thu 7 ngày -->
        <VBox styleClass="card" spacing="12">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="📈 Doanh thu 7 ngày gần nhất" styleClass="lbl-title-card"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblCapNhatChart" text="" styleClass="lbl-small"/>
            </HBox>

            <LineChart fx:id="chartDoanhThu" prefHeight="280"
                       styleClass="dash-chart" createSymbols="true">
                <xAxis>
                    <CategoryAxis fx:id="axisNgay" label="Ngày"
                                  tickLabelRotation="0"/>
                </xAxis>
                <yAxis>
                    <NumberAxis fx:id="axisDoanhThu" label="Doanh thu (đ)"
                                forceZeroInRange="true"/>
                </yAxis>
            </LineChart>
        </VBox>

        <!-- SECTION: Bảng thống kê theo ngày -->
        <VBox styleClass="card" spacing="12">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="📋 Chi tiết theo ngày (7 ngày gần nhất)" styleClass="lbl-title-card"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblCapNhatBang" text="" styleClass="lbl-small"/>
            </HBox>

            <TableView fx:id="tblThongKe" styleClass="table-view, dash-table" prefHeight="240">
                <columns>
                    <TableColumn fx:id="colNgay"           text="Ngày"            prefWidth="90"/>
                    <TableColumn fx:id="colDoanhThu"       text="Doanh thu"        prefWidth="160"/>
                    <TableColumn fx:id="colDonHoanThanh"   text="Đơn hoàn thành"  prefWidth="140"/>
                    <TableColumn fx:id="colDonHuy"         text="Đơn hủy"         prefWidth="100"/>
                    <TableColumn fx:id="colTongDon"        text="Tổng đơn"        prefWidth="100"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

        <Region prefHeight="30"/>
    </VBox>
</ScrollPane>
