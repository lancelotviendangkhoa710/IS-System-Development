<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.bakery.views.controllers.nhansu.DangNhapViewFXMLController"
           prefWidth="1100" prefHeight="680">

    <!-- Layer 1: Background Image -->
    <ImageView fx:id="bgImageView"
               preserveRatio="false" smooth="true">
        <image>
            <Image url="@../../images/login.png"/>
        </image>
    </ImageView>

    <!-- Layer 2: Dark overlay (0.18) -->
    <Region maxWidth="Infinity" maxHeight="Infinity"
            style="-fx-background-color: rgba(0, 0, 0, 0.18);"/>

    <!-- ── Layer 3: Glassmorphism Form Card (centered) ── -->
    <VBox styleClass="login-glass-card"
          prefWidth="420" maxWidth="450" maxHeight="580"
          alignment="CENTER" spacing="0"
          StackPane.alignment="CENTER_RIGHT">
        <StackPane.margin><Insets right="60"/></StackPane.margin>

        <!-- Brand header -->
        <VBox alignment="CENTER" spacing="3">
            <padding><Insets top="20" right="36" bottom="14" left="36"/></padding>
            <Label fx:id="lblBrandGiant" text="H3K" styleClass="login-brand-giant"/>
            <Region prefHeight="4"/>
            <Label fx:id="lblBrandName" text="La Boulangerie H3K" styleClass="login-brand-name"/>
            <Label text="Hệ thống quản lý tiệm bánh" styleClass="login-glass-subtitle"/>
        </VBox>

        <!-- Divider -->
        <Region prefHeight="1" maxWidth="Infinity"
                style="-fx-background-color: rgba(255,255,255,0.12);"/>

        <!-- Form Content Area — all panels in this StackPane -->
        <StackPane alignment="TOP_CENTER" VBox.vgrow="ALWAYS">
            <padding><Insets top="20" right="32" bottom="24" left="32"/></padding>

            <!-- ── Panel 1: Start Screen ── -->
            <VBox fx:id="panelStartScreen" alignment="CENTER" spacing="0">
                <Label text="Chào mừng trở lại 👋" styleClass="login-glass-title"/>
                <Region prefHeight="8"/>
                <Label text="Vui lòng đăng nhập để tiếp tục"
                       styleClass="login-glass-body" wrapText="true"/>
                <Region prefHeight="20"/>
                <Button text="Đăng nhập" styleClass="btn-login-primary"
                        maxWidth="Infinity" onAction="#onMoDangNhap"/>
                <Region prefHeight="12"/>
                <Button text="🔑  Quên mật khẩu?" styleClass="btn-login-ghost"
                        maxWidth="Infinity" onAction="#onMoQuenMatKhau"/>
            </VBox>

            <!-- ── Panel 2: Login Form ── -->
            <VBox fx:id="panelLogin" alignment="TOP_LEFT" spacing="14"
                  visible="false" managed="false">

                <!-- Title block -->
                <VBox spacing="0">
                    <Label text="Đăng nhập" styleClass="login-glass-title"/>
                    <Region prefHeight="8"/>
                    <Label text="Nhập thông tin tài khoản của bạn"
                           styleClass="login-glass-body" wrapText="true"/>
                </VBox>

                <!-- Username field group -->
                <VBox spacing="8">
                    <Label text="Tên đăng nhập" styleClass="login-glass-label"/>
                    <TextField fx:id="txtTenDangNhap" styleClass="login-glass-input"
                               promptText="Nhập tên đăng nhập..."/>
                </VBox>

                <!-- Password field group -->
                <VBox spacing="8">
                    <Label text="Mật khẩu" styleClass="login-glass-label"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <StackPane HBox.hgrow="ALWAYS">
                            <PasswordField fx:id="txtMatKhau" styleClass="login-glass-input"
                                          onAction="#onDangNhap" maxWidth="Infinity"/>
                            <TextField fx:id="txtMatKhauVisible" styleClass="login-glass-input"
                                       onAction="#onDangNhap" visible="false"
                                       managed="false" maxWidth="Infinity"/>
                        </StackPane>
                        <Button fx:id="btnToggleMatKhau" text="👁"
                                styleClass="btn-login-icon" onAction="#onToggleMatKhau"/>
                    </HBox>
                </VBox>

                <!-- Actions: button → forgot → error (12px gaps) -->
                <VBox spacing="0">
                    <Button fx:id="btnDangNhap" text="Đăng nhập"
                            styleClass="btn-login-primary" maxWidth="Infinity"
                            onAction="#onDangNhap"/>
                    <Region prefHeight="12"/>
                    <Button text="🔑  Quên mật khẩu?" styleClass="btn-login-ghost"
                            maxWidth="Infinity" onAction="#onMoQuenMatKhau"/>
                    <Region prefHeight="8"/>
                    <Label fx:id="lblThongBao" styleClass="login-glass-error"
                           wrapText="true" maxWidth="Infinity"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS" minHeight="2"/>
                <Button text="← Quay lại" styleClass="btn-login-ghost"
                        maxWidth="Infinity" onAction="#onQuayVeStart"/>
            </VBox>

            <!-- ── Panel 3: Register Form ── -->
            <VBox fx:id="panelRegister" alignment="TOP_LEFT" spacing="14"
                  visible="false" managed="false">

                <VBox spacing="0">
                    <Label text="Đăng ký" styleClass="login-glass-title"/>
                    <Region prefHeight="10"/>
                    <Label text="Tạo tài khoản nhân viên mới"
                           styleClass="login-glass-body"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Họ tên nhân viên" styleClass="login-glass-label"/>
                    <TextField fx:id="txtRegisterHoTen" styleClass="login-glass-input"/>
                </VBox>
                <VBox spacing="8">
                    <Label text="Tên đăng nhập" styleClass="login-glass-label"/>
                    <TextField fx:id="txtRegisterTenDangNhap" styleClass="login-glass-input"/>
                </VBox>
                <VBox spacing="8">
                    <Label text="Số điện thoại" styleClass="login-glass-label"/>
                    <TextField fx:id="txtRegisterSoDienThoai" styleClass="login-glass-input"/>
                </VBox>
                <VBox spacing="8">
                    <Label text="Mật khẩu" styleClass="login-glass-label"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <StackPane HBox.hgrow="ALWAYS">
                            <PasswordField fx:id="txtRegisterMatKhau"
                                          styleClass="login-glass-input" maxWidth="Infinity"/>
                            <TextField fx:id="txtRegisterMatKhauVisible"
                                       styleClass="login-glass-input" visible="false"
                                       managed="false" maxWidth="Infinity"/>
                        </StackPane>
                        <Button fx:id="btnToggleRegisterMatKhau" text="👁"
                                styleClass="btn-login-icon"
                                onAction="#onToggleRegisterMatKhau"/>
                    </HBox>
                </VBox>
                <VBox spacing="8">
                    <Label text="Vai trò" styleClass="login-glass-label"/>
                    <ComboBox fx:id="cboRegisterVaiTro" maxWidth="Infinity"
                              styleClass="login-glass-input"/>
                </VBox>
                <VBox spacing="8">
                    <Label text="Mã xác nhận của quản lý" styleClass="login-glass-label"/>
                    <TextField fx:id="txtRegisterMaXacNhan" styleClass="login-glass-input"/>
                </VBox>

                <Button fx:id="btnTaoTaiKhoan" text="Tạo tài khoản"
                        styleClass="btn-login-primary" maxWidth="Infinity"
                        onAction="#onTaoTaiKhoan"/>
                <Label fx:id="lblRegisterThongBao" styleClass="login-glass-error"
                       wrapText="true" maxWidth="Infinity"/>
                <Button text="← Quay lại" styleClass="btn-login-ghost"
                        maxWidth="Infinity" onAction="#onQuayVeStart"/>
            </VBox>

            <!-- ── Panel 4: Quên mật khẩu (OTP Flow) ── -->
            <VBox fx:id="panelQuenMatKhau" alignment="TOP_LEFT" spacing="20"
                  visible="false" managed="false">

                <!-- Sub 1: Nhập tên đăng nhập -->
                <VBox fx:id="subNhapUsername" alignment="TOP_LEFT" spacing="20">
                    <VBox spacing="0">
                        <Label text="🔑 Quên mật khẩu" styleClass="login-glass-title"/>
                        <Region prefHeight="10"/>
                        <Label text="Nhập tên đăng nhập để nhận mã OTP qua email"
                               styleClass="login-glass-body" wrapText="true"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="Tên đăng nhập" styleClass="login-glass-label"/>
                        <TextField fx:id="txtQmkTenDangNhap" styleClass="login-glass-input"
                                   promptText="Nhập tên đăng nhập..."/>
                    </VBox>
                    <Button fx:id="btnGuiOtp" text="Gửi mã OTP"
                            styleClass="btn-login-primary" maxWidth="Infinity"
                            onAction="#onGuiOtp"/>
                    <Label fx:id="lblQmkThongBao1" styleClass="login-glass-error"
                           wrapText="true" maxWidth="Infinity"/>
                </VBox>

                <!-- Sub 2: Nhập OTP -->
                <VBox fx:id="subNhapOtp" alignment="TOP_LEFT" spacing="20"
                      visible="false" managed="false">
                    <VBox spacing="0">
                        <Label text="✉️ Nhập mã xác nhận" styleClass="login-glass-title"/>
                        <Region prefHeight="10"/>
                        <Label fx:id="lblQmkEmailHint" styleClass="login-glass-body" wrapText="true"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="Mã OTP (6 số)" styleClass="login-glass-label"/>
                        <TextField fx:id="txtQmkOtp" styleClass="login-glass-input"
                                   promptText="Nhập mã 6 số..."/>
                    </VBox>
                    <Button fx:id="btnXacNhanOtp" text="Xác nhận mã"
                            styleClass="btn-login-primary" maxWidth="Infinity"
                            onAction="#onXacNhanOtp"/>
                    <Button text="Gửi lại mã" styleClass="btn-login-ghost"
                            maxWidth="Infinity" onAction="#onGuiLaiOtp"/>
                    <Label fx:id="lblQmkThongBao2" styleClass="login-glass-error"
                           wrapText="true" maxWidth="Infinity"/>
                </VBox>

                <!-- Sub 3: Đặt mật khẩu mới -->
                <VBox fx:id="subMatKhauMoi" alignment="TOP_LEFT" spacing="20"
                      visible="false" managed="false">
                    <Label text="🔒 Đặt mật khẩu mới" styleClass="login-glass-title"/>
                    <VBox spacing="8">
                        <Label text="Mật khẩu mới" styleClass="login-glass-label"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <StackPane HBox.hgrow="ALWAYS">
                                <PasswordField fx:id="txtQmkMatKhauMoi"
                                              styleClass="login-glass-input" maxWidth="Infinity"/>
                                <TextField fx:id="txtQmkMatKhauMoiVisible"
                                           styleClass="login-glass-input" visible="false"
                                           managed="false" maxWidth="Infinity"/>
                            </StackPane>
                            <Button fx:id="btnToggleQmkMatKhau" text="👁"
                                    styleClass="btn-login-icon" onAction="#onToggleQmkMatKhau"/>
                        </HBox>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="Xác nhận mật khẩu mới" styleClass="login-glass-label"/>
                        <PasswordField fx:id="txtQmkXacNhan"
                                      styleClass="login-glass-input"/>
                    </VBox>
                    <Button fx:id="btnDoiMatKhauMoi" text="Đổi mật khẩu"
                            styleClass="btn-login-primary" maxWidth="Infinity"
                            onAction="#onDoiMatKhauSauOtp"/>
                    <Label fx:id="lblQmkThongBao3" styleClass="login-glass-error"
                           wrapText="true" maxWidth="Infinity"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS" minHeight="4"/>
                <Button text="← Quay lại" styleClass="btn-login-ghost"
                        maxWidth="Infinity" onAction="#onQuayVeStart"/>
            </VBox>

        </StackPane>
    </VBox>

</StackPane>
