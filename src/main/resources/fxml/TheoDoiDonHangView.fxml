<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
    TheoDoiDonHangView.fxml — Màn hình theo dõi đơn hàng (Chỉ chứa content)
    Được load động vào MainView (AppShell)
    Controller: com.bakery.views.controllers.banhang.TheoDoiDonHangViewFXMLController
-->
<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bakery.views.controllers.banhang.TheoDoiDonHangViewFXMLController"
      styleClass="bg-app"
      spacing="0">

    <!-- Content -->
    <VBox fx:id="tabTheoDoi" spacing="12" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <!-- Filter bar Theo dõi -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Mã đơn:" styleClass="lbl-body-bold"/>
            <TextField fx:id="txtTimMaDon" promptText="VD: 1001" prefWidth="100" styleClass="text-field"/>
            
            <Label text="Ngày:" styleClass="lbl-body-bold"/>
            <DatePicker fx:id="dpNgayTheoDoi" styleClass="text-field" prefWidth="150"/>
            
            <Label text="Từ:" styleClass="lbl-body-bold"/>
            <ComboBox fx:id="cbGioTu" prefWidth="90" styleClass="combo-box"/>
            
            <Label text="Đến:" styleClass="lbl-body-bold"/>
            <ComboBox fx:id="cbGioDen" prefWidth="90" styleClass="combo-box"/>
            
            <Label text="Trạng thái:" styleClass="lbl-body-bold"/>
            <ComboBox fx:id="cbLocTrangThaiTheoDoi" prefWidth="140" styleClass="combo-box" onAction="#onLocTrangThaiTheoDoi"/>
            
            <Button text="🔍 Tìm kiếm" styleClass="btn-primary" onAction="#onTimKiemDon"/>
        </HBox>

        <!-- Danh sách card đơn hàng -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox fx:id="panelChuaDon" spacing="10" style="-fx-background-color: transparent;"/>
        </ScrollPane>
    </VBox>
</VBox>
