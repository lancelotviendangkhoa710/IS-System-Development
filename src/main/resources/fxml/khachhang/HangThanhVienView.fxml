<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" styleClass="bg-app" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bakery.views.controllers.khachhang.HangThanhVienController">
    <padding>
        <Insets top="20" bottom="20" left="0" right="0" />
    </padding>

    <VBox spacing="15" styleClass="card" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="15">
            <VBox spacing="5">
                <Label text="Danh sách hạng thành viên" styleClass="lbl-title-card" />
                <Label text="Thiết lập mức thưởng và điều kiện cho khách hàng thân thiết" styleClass="lbl-small" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnSua" text="✏️ Sửa hạng" styleClass="btn-secondary" onAction="#onSuaAction" disable="true"/>
        </HBox>

        <TableView fx:id="tierTable" styleClass="table-view" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colTenHang" prefWidth="200" text="Tên hạng" />
                <TableColumn fx:id="colDiemToiThieu" prefWidth="150" text="Điểm tối thiểu" />
                <TableColumn fx:id="colPhanTramGiamGia" prefWidth="150" text="Giảm giá (%)" />
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="ℹ️ Hạng được cập nhật tự động định kỳ dựa trên điểm tích lũy." styleClass="lbl-small" style="-fx-font-style: italic;" />
        </HBox>
    </VBox>
</VBox>
