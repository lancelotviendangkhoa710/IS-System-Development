<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bakery.views.controllers.banhang.KhachHangDialogViewFXMLController"
      spacing="0" prefWidth="480">

    <!-- Header -->
    <HBox styleClass="dialog-header" alignment="CENTER_LEFT" spacing="12">
        <Label text="👤" style="-fx-font-size: 20px;"/>
        <VBox spacing="2">
            <Label fx:id="lblTitle" text="Thêm khách hàng mới" styleClass="dialog-header-title"/>
            <Label text="Điền đầy đủ thông tin bên dưới" styleClass="lbl-small"/>
        </VBox>
    </HBox>

    <!-- Body -->
    <VBox styleClass="dialog-body" spacing="18">

        <!-- Họ tên -->
        <VBox spacing="6">
            <Label text="Họ và tên khách hàng *" styleClass="lbl-body-bold"/>
            <TextField fx:id="txtHoTen"
                       promptText="VD: Nguyễn Văn A"
                       styleClass="text-field"/>
        </VBox>

        <!-- SĐT -->
        <VBox spacing="6">
            <Label text="Số điện thoại *" styleClass="lbl-body-bold"/>
            <TextField fx:id="txtSDT"
                       promptText="VD: 0901234567 (10 chữ số)"
                       styleClass="text-field"/>
        </VBox>

        <!-- Địa chỉ -->
        <VBox spacing="6">
            <Label text="Địa chỉ" styleClass="lbl-body-bold"/>
            <TextField fx:id="txtDiaChi"
                       promptText="VD: 123 Lê Lợi, Q.1, TP.HCM"
                       styleClass="text-field"/>
        </VBox>

        <!-- Info banner -->
        <HBox styleClass="info-banner" spacing="10" alignment="CENTER_LEFT">
            <Label text="ℹ️" styleClass="lbl-body"/>
            <Label text="Khách hàng mới sẽ được xếp hạng thành viên tự động dựa trên điểm tích lũy."
                   styleClass="lbl-body" wrapText="true" HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- Error label -->
        <Label fx:id="lblError" text="" styleClass="lbl-danger" wrapText="true"/>

    </VBox>

    <!-- Footer -->
    <HBox styleClass="dialog-footer" alignment="CENTER_RIGHT" spacing="12">
        <Button text="Hủy" onAction="#onHuy" styleClass="btn-secondary"/>
        <Button fx:id="btnLuu" text="✅ Lưu khách hàng" onAction="#onLuu" styleClass="btn-success"/>
    </HBox>

</VBox>
