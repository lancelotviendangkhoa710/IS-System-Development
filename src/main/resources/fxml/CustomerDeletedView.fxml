<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox maxHeight="600.0" prefWidth="750.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 20, 0, 0, 10);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bakery.views.controllers.customer.CustomerDeletedViewFXMLController">

    <!-- ==================== HEADER (giống HTML) ==================== -->
    <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 16 20; -fx-border-width: 0 0 1 0;">
        <!-- Icon thùng rác (đỏ) -->
        <Label style="-fx-font-size: 24px; " text="🗑" />
        <!-- Tiêu đề -->
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; " text="Thùng rác - Khách hàng đã xóa" />
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <!-- ==================== SEARCH BAR ==================== -->
    <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 10 20;">
        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: #eeeeee; -fx-background-radius: 20; -fx-padding: 4 16;">
            <Label style="-fx-font-size: 16px; -fx-text-fill: #78716c;" text="🔍" />
            <TextField fx:id="searchField" prefHeight="29.0" prefWidth="303.0" promptText="Tìm theo tên, SĐT, mã KH, địa chỉ" style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
        </HBox>
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <!-- ==================== BODY (bảng dữ liệu) ==================== -->
    <TableView fx:id="deletedTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colMaKH" prefWidth="100.0" text="Mã KH" />
            <TableColumn fx:id="colTenKH" prefWidth="180.0" text="Tên khách hàng" />
            <TableColumn fx:id="colSDT" prefWidth="140.0" text="SĐT" />
            <TableColumn fx:id="colNgayXoa" prefWidth="130.0" text="Ngày xóa" />
            <TableColumn fx:id="colNguoiXoa" prefWidth="130.0" text="Người xóa" />
            <TableColumn fx:id="colThaoTac" prefWidth="130.0" text="Thao tác" />
        </columns>
    </TableView>

    <!-- ==================== FOOTER ==================== -->
    <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-padding: 12 20; -fx-border-width: 1 0 0 0;">
        <Label fx:id="lblPageInfo" style="-fx-font-size: 14px;" text="Hiển thị 0 khách hàng" />
    </HBox>
</VBox>
