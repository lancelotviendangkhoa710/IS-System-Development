<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    ReasonConfirmDialog.fxml — Dialog xác nhận bắt buộc nhập lý do
    Dùng StageStyle.TRANSPARENT → root StackPane trong suốt, card VBox có bo góc + bóng đổ.
    Controller: com.bakery.views.controllers.ReasonConfirmDialogController
-->
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.bakery.views.controllers.ReasonConfirmDialogController"
           style="-fx-background-color: transparent;"
           minWidth="460" maxWidth="460">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Card -->
    <VBox spacing="18"
          style="-fx-background-color: white;
                 -fx-background-radius: 16px;
                 -fx-padding: 28 28 24 28;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.22), 28, 0, 0, 8);">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="lblIcon" text="&#x26A0;"
                   style="-fx-font-size: 20px; -fx-text-fill: #DC2626;"/>
            <Label fx:id="lblTitle" text="Xác nhận"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;
                          -fx-text-fill: #DC2626; -fx-font-family: 'Segoe UI';"/>
        </HBox>

        <Separator/>

        <!-- Message -->
        <Label fx:id="lblMessage" text="" wrapText="true"
               style="-fx-font-size: 13px; -fx-text-fill: #374151;
                      -fx-font-family: 'Segoe UI'; -fx-line-spacing: 2;"/>

        <!-- Reason input -->
        <VBox spacing="6">
            <Label fx:id="lblPrompt" text="Lý do:"
                   style="-fx-font-size: 13px; -fx-font-weight: bold;
                          -fx-text-fill: #374151; -fx-font-family: 'Segoe UI';"/>
            <TextArea fx:id="txtReason" prefRowCount="3" wrapText="true"
                      style="-fx-font-size: 13px; -fx-font-family: 'Segoe UI';
                             -fx-background-radius: 8px; -fx-border-radius: 8px;
                             -fx-border-color: #D1D5DB; -fx-border-width: 1;
                             -fx-background-color: white; -fx-focus-color: #92400E;"/>
            <Label fx:id="lblError" text="Vui lòng nhập lý do trước khi xác nhận."
                   visible="false" managed="false"
                   style="-fx-text-fill: #DC2626; -fx-font-size: 12px;
                          -fx-font-family: 'Segoe UI';"/>
        </VBox>

        <!-- Buttons -->
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnCancel" text="Hủy bỏ" onAction="#onCancel"
                    style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;
                           -fx-font-size: 13px; -fx-font-family: 'Segoe UI';
                           -fx-background-radius: 8px; -fx-padding: 9 24;
                           -fx-cursor: hand; -fx-font-weight: bold;
                           -fx-border-color: #D1D5DB; -fx-border-width: 1;
                           -fx-border-radius: 8px;"/>
            <Button fx:id="btnConfirm" text="Xác nhận" onAction="#onConfirm"
                    style="-fx-background-color: #DC2626; -fx-text-fill: white;
                           -fx-font-size: 13px; -fx-font-family: 'Segoe UI';
                           -fx-background-radius: 8px; -fx-padding: 9 24;
                           -fx-cursor: hand; -fx-font-weight: bold;"/>
        </HBox>

    </VBox>
</StackPane>
