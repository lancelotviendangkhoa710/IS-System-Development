<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  KhoView.fxml — Trung tâm Quản lý Kho hàng.
  Tab 1: Thẻ kho | Tab 2: Nhà cung cấp | Tab 3: Kiểm kê (Nguyên liệu + Tồn kho) | Tab 4: Nhập kho | Tab 5: Truy xuất
  Controller: KhoViewFXMLController.
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bakery.views.controllers.kho.KhoViewFXMLController"
      styleClass="bg-app" spacing="0">

    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <!-- Header chung -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <padding><Insets bottom="16"/></padding>
        <VBox spacing="4">
            <Label text="🏪 Quản lý Kho hàng" styleClass="lbl-title-screen"/>
            <Label text="Thẻ kho · Nhà cung cấp · Kiểm kê · Nguyên liệu · Nhập kho" styleClass="lbl-body"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblThongBao" styleClass="lbl-small-bold"/>
    </HBox>

    <!-- TabPane 5 tab chính -->
    <TabPane fx:id="tabPaneKho" VBox.vgrow="ALWAYS"
             tabClosingPolicy="UNAVAILABLE"
             styleClass="modern-tab-pane">

        <!-- Tab 1: Thẻ kho (nâng lên từ nested → Tab 1 ngoài) -->
        <Tab text="📒  Thẻ kho" fx:id="tabTheKho">
            <fx:include source="TheKhoView.fxml"/>
        </Tab>

        <!-- Tab 2: Nhà cung cấp -->
        <Tab text="🏭  Nhà cung cấp" fx:id="tabNhaCungCap">
            <fx:include source="QuanLyNhaCungCapView.fxml"/>
        </Tab>

        <!-- Tab 3: Kiểm kê kho — Nguyên liệu + Tồn kho -->
        <Tab text="📊  Kiểm kê kho" fx:id="tabKiemKe">
            <VBox spacing="0">
                <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="modern-tab-pane">
                    <Tab text="🌾  Nguyên liệu">
                        <fx:include source="NguyenLieuView.fxml"/>
                    </Tab>
                    <Tab text="📋  Tồn kho">
                        <fx:include source="KiemKeKhoView.fxml"/>
                    </Tab>
                </TabPane>
            </VBox>
        </Tab>

        <!-- Tab 4: Nhập kho -->
        <Tab text="📥  Nhập kho" fx:id="tabNhapKho">
            <fx:include source="NhapKhoView.fxml"/>
        </Tab>

        <!-- Tab 5: Truy xuất nguồn gốc -->
        <Tab text="🔍  Truy xuất nguồn gốc" fx:id="tabTraCuuNguonGoc">
            <fx:include source="TraCuuNguonGocView.fxml"/>
        </Tab>

    </TabPane>
</VBox>
