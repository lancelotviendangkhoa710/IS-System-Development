<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  TheKhoView.fxml — Màn hình Tra cứu thẻ kho nguyên liệu (UC44).
  Layout: Bộ lọc (top) + KPI tổng hợp kỳ (mid) + Bảng biến động (bottom).
  Controller: TheKhoViewFXMLController.
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bakery.views.controllers.kho.TheKhoViewFXMLController"
      spacing="16" styleClass="bg-app">

    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <!-- ① BỘ LỌC -->
    <VBox styleClass="card" spacing="12">
        <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
        <Label text="📋  Tra cứu thẻ kho nguyên liệu" styleClass="lbl-title-card"/>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <ComboBox fx:id="cmbNguyenLieu" prefWidth="260" styleClass="combo-box"
                      promptText="— Chọn nguyên liệu —"/>
            <Label text="Từ ngày:" styleClass="lbl-body"/>
            <DatePicker fx:id="dpTuNgay" prefWidth="140"/>
            <Label text="Đến ngày:" styleClass="lbl-body"/>
            <DatePicker fx:id="dpDenNgay" prefWidth="140"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnTimKiem" text="📋  Xem thẻ kho"
                    styleClass="btn-primary" onAction="#onTimKiem"/>
            <Button fx:id="btnXoaLoc" text="↺  Xoá lọc"
                    styleClass="btn-secondary" onAction="#onXoaLoc"/>
        </HBox>
    </VBox>

    <!-- ② KPI TỔNG HỢP KỲ -->
    <HBox spacing="16">

        <VBox styleClass="card" alignment="CENTER" HBox.hgrow="ALWAYS" spacing="6">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <Label text="Tồn đầu kỳ" styleClass="lbl-body-bold"/>
            <Label fx:id="lblTonDauKy" text="—" styleClass="lbl-kpi"/>
        </VBox>

        <VBox styleClass="card" alignment="CENTER" HBox.hgrow="ALWAYS" spacing="6">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <Label text="Nhập kỳ" styleClass="lbl-body-bold"/>
            <Label fx:id="lblNhapKy" text="—" styleClass="lbl-kpi lbl-success"/>
        </VBox>

        <VBox styleClass="card" alignment="CENTER" HBox.hgrow="ALWAYS" spacing="6">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <Label text="Xuất kỳ" styleClass="lbl-body-bold"/>
            <Label fx:id="lblXuatKy" text="—" styleClass="lbl-kpi lbl-danger"/>
        </VBox>

        <VBox styleClass="card" alignment="CENTER" HBox.hgrow="ALWAYS" spacing="6">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <Label text="Tồn cuối kỳ" styleClass="lbl-body-bold"/>
            <Label fx:id="lblTonCuoiKy" text="—" styleClass="lbl-kpi"/>
        </VBox>

    </HBox>

    <!-- ③ BẢNG LỊCH SỬ BIẾN ĐỘNG -->
    <VBox spacing="8" VBox.vgrow="ALWAYS">
        <Label text="📊  Lịch sử biến động" styleClass="lbl-title-card"/>
        <TableView fx:id="tblBienDong" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colNgay"    text="Ngày giao dịch"  prefWidth="150"/>
                <TableColumn fx:id="colLoai"    text="Loại"             prefWidth="200"/>
                <TableColumn fx:id="colMaLo"    text="Mã lô"            prefWidth="80"/>
                <TableColumn fx:id="colSoLuong" text="Số lượng"         prefWidth="120"/>
                <TableColumn fx:id="colConLai"  text="Còn lại trong lô" prefWidth="140"/>
            </columns>
            <placeholder>
                <Label text="Chọn nguyên liệu và nhấn 'Xem thẻ kho'." styleClass="lbl-body"/>
            </placeholder>
        </TableView>
    </VBox>

    <!-- ④ STATUS BAR -->
    <HBox>
        <Label fx:id="lblThongBao" styleClass="lbl-small-bold"/>
    </HBox>

</VBox>
