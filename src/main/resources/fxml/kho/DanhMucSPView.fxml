<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.bakery.views.controllers.kho.DanhMucSPViewFXMLController"
      spacing="20">
    
    <padding>
        <Insets top="16" right="24" bottom="16" left="24"/>
    </padding>

    <!-- Header Section -->
    <VBox spacing="10">
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label text="Quản lý danh mục sản phẩm" styleClass="lbl-title-screen"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Danh sách danh mục" styleClass="lbl-title-card"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="txtTimKiem" promptText="🔍 Tìm danh mục..." prefWidth="200" onKeyReleased="#onTimKiem" styleClass="text-field"/>
            <Button text="↺ Làm mới" styleClass="btn-reset" onAction="#onLamMoi"/>
            <Button fx:id="btnSua" text="Sửa" styleClass="btn-secondary" onAction="#onSuaAction" disable="true"/>
            <Button fx:id="btnXoa" text="🗑 Xóa" styleClass="btn-danger" onAction="#onXoaAction" disable="true"/>
            <Button fx:id="btnThemMoi" text="➕ Thêm mới" styleClass="btn-success" onAction="#onThemMoi"/>
        </HBox>
    </VBox>

    <!-- TableView full width -->
    <TableView fx:id="tblDanhMuc" styleClass="table-view" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colMaDM" text="Mã" prefWidth="100"/>
            <TableColumn fx:id="colTenDM" text="Tên danh mục" prefWidth="400"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- Footer Status -->
    <HBox>
        <Label fx:id="lblThongBao" styleClass="lbl-small-bold"/>
    </HBox>

</VBox>
