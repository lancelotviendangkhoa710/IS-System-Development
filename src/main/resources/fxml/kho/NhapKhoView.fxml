<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.bakery.views.controllers.kho.NhapKhoViewFXMLController">
    <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label fx:id="lblTitle" text="QUẢN LÝ NHẬP KHO" styleClass="lbl-header"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnLapBaoCao" text="📋 Lập Báo Cáo" onAction="#onLapBaoCao"
                styleClass="btn-secondary"/>
        <Button fx:id="btnXoa" text="🗑 Xóa phiếu" onAction="#onXoa"
                styleClass="btn-danger" visible="false" managed="false"/>
        <Button fx:id="btnInPhieu" text="🖨 In phiếu" onAction="#onInPhieuNhap"
                styleClass="btn-secondary" disable="true"/>
        <Button text="📂 Nhập từ File" onAction="#onNhapTuFile" styleClass="btn-secondary"/>
        <Button text="+ Tạo phiếu nhập" onAction="#onAction" styleClass="btn-success"/>
    </HBox>

    <VBox styleClass="card" VBox.vgrow="ALWAYS">
        <TableView fx:id="tblData" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colDate" text="Ngày nhập" prefWidth="150"/>
                <TableColumn fx:id="colUser" text="Người thực hiện" prefWidth="180"/>
                <TableColumn fx:id="colContent" text="Nội dung nhập" prefWidth="400"/>
                <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="150"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>
    </VBox>
    
    <Label fx:id="lblThongBao" styleClass="lbl-status"/>
</VBox>
