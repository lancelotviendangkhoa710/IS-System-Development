<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" styleClass="bg-app"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bakery.views.controllers.kho.SanXuatViewFXMLController">

    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

    <!-- ① HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <VBox spacing="4">
            <Label text="Lập Kế Hoạch Sản Xuất" styleClass="lbl-title-screen"/>
            <Label text="Tính nguyên liệu cần xuất kho theo công thức" styleClass="lbl-body"/>
        </VBox>
    </HBox>

    <!-- ② CONTENT -->
    <HBox spacing="30" VBox.vgrow="ALWAYS">

        <!-- LEFT: Chọn sản phẩm + Tính toán -->
        <VBox spacing="20" styleClass="card" prefWidth="320" alignment="TOP_CENTER">
            <Label text="Thông số kế hoạch" styleClass="lbl-title-card"/>

            <VBox spacing="8">
                <Label text="Sản phẩm cần làm: *" styleClass="lbl-body-bold"/>
                <ComboBox fx:id="cmbSanPham" maxWidth="Infinity" styleClass="combo-box"
                          onAction="#onSanPhamChanged"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Số lượng tối đa có thể làm:" styleClass="lbl-body-bold"/>
                <Label fx:id="lblSoLuongKhaDung" text="— Chọn sản phẩm —" styleClass="lbl-price"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Kế hoạch số lượng: *" styleClass="lbl-body-bold"/>
                <TextField fx:id="txtSoLuongKeHoach" promptText="Nhập số lượng cần làm..."
                           styleClass="text-field"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="12" maxWidth="Infinity">
                <Button fx:id="btnTinhToan" text="⚙ Tính nguyên liệu"
                        styleClass="btn-primary" maxWidth="Infinity" onAction="#onTinhToan"/>
                <Button fx:id="btnXoaBang" text="🗑 Xóa bảng"
                        styleClass="btn-secondary" maxWidth="Infinity" onAction="#onXoaBang"/>
            </VBox>
        </VBox>

        <!-- RIGHT: Bảng nguyên liệu cần xuất -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Danh sách nguyên liệu cần xuất" styleClass="lbl-title-card"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblCanhBaoThieu" styleClass="lbl-danger"/>
            </HBox>

            <TableView fx:id="tblNguyenLieu" styleClass="table-view" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colTenNL" text="Nguyên liệu" prefWidth="200"/>
                    <TableColumn fx:id="colDVT" text="ĐVT" prefWidth="80"/>
                    <TableColumn fx:id="colTonKho" text="Tồn kho" prefWidth="110"/>
                    <TableColumn fx:id="colDinhMuc" text="Định mức/cái" prefWidth="110"/>
                    <TableColumn fx:id="colCanXuat" text="Cần xuất" prefWidth="110"/>
                    <TableColumn fx:id="colTrangThai" text="Trạng thái" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>

    </HBox>

    <!-- ③ FOOTER -->
    <HBox>
        <Label fx:id="lblThongBao" styleClass="lbl-small-bold"/>
    </HBox>

</VBox>
