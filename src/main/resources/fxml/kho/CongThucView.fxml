<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bakery.views.controllers.kho.CongThucViewFXMLController">
    <padding><Insets top="20" right="0" bottom="0" left="0"/></padding>

    <!-- HEADER INFO + CHỌN SẢN PHẨM -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Xem công thức:" styleClass="lbl-body-bold"/>
        <ComboBox fx:id="cmbChonSanPham" promptText="🔍 Tìm hoặc chọn sản phẩm..."
                  editable="true" prefWidth="320" styleClass="combo-box"/>
        <Label fx:id="lblSanPhamDangCauHinh" text="" styleClass="lbl-body" wrapText="false"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="↺ Làm mới" styleClass="btn-reset" onAction="#onLamMoi"/>
        <Button text="➕ Thêm nguyên liệu" styleClass="btn-success" onAction="#onThemCongThuc"/>
    </HBox>

    <!-- MAIN CONTENT -->
    <HBox spacing="30" VBox.vgrow="ALWAYS">

        <!-- LEFT: Bảng công thức hiện tại -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <Label text="Công thức nguyên liệu" styleClass="lbl-title-card"/>
            <TableView fx:id="tblCongThuc" styleClass="table-view" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colTenNguyenLieu" text="Nguyên liệu" prefWidth="220"/>
                    <TableColumn fx:id="colDinhMuc"       text="Định mức"    prefWidth="100"/>
                    <TableColumn fx:id="colDonGia"        text="Đơn giá"     prefWidth="120"/>
                    <TableColumn fx:id="colThanhTien"     text="Thành tiền"  prefWidth="130"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <!-- Tổng giá vốn BOM -->
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label text="Tổng giá vốn BOM:" styleClass="lbl-body-bold"/>
                <Label fx:id="lblTongGiaVon" text="0 đ" styleClass="lbl-price"/>
            </HBox>
        </VBox>

        <!-- RIGHT: Form sửa định mức (chọn dòng trong bảng để điền) -->
        <VBox spacing="20" styleClass="card" prefWidth="380" alignment="TOP_CENTER">
            <Label text="Sửa định mức nguyên liệu" styleClass="lbl-title-card"/>
            <Label text="← Chọn dòng trong bảng để sửa" styleClass="lbl-body"/>

            <VBox spacing="8">
                <Label text="Nguyên liệu: *" styleClass="lbl-body-bold"/>
                <ComboBox fx:id="cmbNguyenLieu" maxWidth="Infinity"
                          promptText="Chọn nguyên liệu..."
                          styleClass="combo-box"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Định mức tiêu hao: *" styleClass="lbl-body-bold"/>
                <TextField fx:id="txtDinhMuc" promptText="VD: 0.25 (kg)" styleClass="text-field"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="12" maxWidth="Infinity">
                <Button fx:id="btnLuuCongThuc" text="💾 Cập nhật định mức"
                        styleClass="btn-success" maxWidth="Infinity"
                        onAction="#onLuuCongThuc"/>
                <Button fx:id="btnXoaCongThuc" text="🗑 Xóa khỏi công thức"
                        styleClass="btn-danger" maxWidth="Infinity"
                        onAction="#onXoaCongThuc"/>
            </VBox>
        </VBox>

    </HBox>

    <!-- FOOTER -->
    <HBox>
        <Label fx:id="lblThongBao" styleClass="lbl-small-bold"/>
    </HBox>

</VBox>
