<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bakery.views.controllers.kho.CongThucViewFXMLController">
    <padding><Insets top="20" right="0" bottom="0" left="0"/></padding>

    <!-- HEADER INFO + CHỌN SẢN PHẨM -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Xem công thức:" styleClass="lbl-body-bold"/>
        <ComboBox fx:id="cmbChonSanPham" promptText="🔍 Tìm hoặc chọn sản phẩm..."
                  editable="true" prefWidth="320" styleClass="combo-box"/>
        <Label fx:id="lblSanPhamDangCauHinh" text="" styleClass="lbl-body" wrapText="false"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="↺ Làm mới" styleClass="btn-reset" onAction="#onLamMoi"/>
        <Button fx:id="btnSua" text="✏️ Sửa định mức" styleClass="btn-secondary" onAction="#onSuaAction" disable="true"/>
        <Button fx:id="btnXoa" text="🗑 Xóa khỏi công thức" styleClass="btn-danger" onAction="#onXoaAction" disable="true"/>
        <Button text="➕ Thêm nguyên liệu" styleClass="btn-success" onAction="#onThemCongThuc"/>
    </HBox>

    <!-- MAIN CONTENT -->
    <HBox spacing="30" VBox.vgrow="ALWAYS">

        <!-- LEFT: Bảng công thức hiện tại -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <Label text="Công thức nguyên liệu" styleClass="lbl-title-card"/>
            <TableView fx:id="tblCongThuc" styleClass="table-view" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colTenNguyenLieu" text="Nguyên liệu" prefWidth="200"/>
                    <TableColumn fx:id="colDinhMuc"       text="Định mức"    prefWidth="90"/>
                    <TableColumn fx:id="colDVT"            text="ĐV Tính"     prefWidth="80"/>
                    <TableColumn fx:id="colDonGia"        text="Đơn giá"     prefWidth="110"/>
                    <TableColumn fx:id="colThanhTien"     text="Thành tiền"  prefWidth="120"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <!-- Tổng giá vốn BOM -->
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label text="Tổng giá vốn BOM:" styleClass="lbl-body-bold"/>
                <Label fx:id="lblTongGiaVon" text="0 đ" styleClass="lbl-price"/>
            </HBox>
        </VBox>

    </HBox>

    <!-- FOOTER -->
    <HBox>
        <Label fx:id="lblThongBao" styleClass="lbl-small-bold"/>
    </HBox>

</VBox>
