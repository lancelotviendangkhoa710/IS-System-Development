<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" styleClass="bg-app" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.bakery.views.controllers.kho.TonKhoNguyenLieuViewFXMLController">
    <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

    <!-- Bộ lọc kỳ báo cáo -->
    <VBox styleClass="card" spacing="12">
        <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
        <Label text="📦  Báo cáo tồn kho nguyên liệu" styleClass="lbl-title-card"/>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Từ ngày:" styleClass="lbl-body"/>
            <DatePicker fx:id="dpTonKhoTuNgay" prefWidth="150"/>
            <Label text="Đến ngày:" styleClass="lbl-body"/>
            <DatePicker fx:id="dpTonKhoDenNgay" prefWidth="150"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnXemTonKho" text="📋  Xem báo cáo"
                    styleClass="btn-primary" onAction="#onXemBaoCaoTonKho"/>
        </HBox>
    </VBox>

    <!-- KPI Tổng hợp -->
    <HBox spacing="16">
        <VBox styleClass="card, kpi-amber" alignment="CENTER" HBox.hgrow="ALWAYS" spacing="6">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <Label text="⛔  Hết hàng" styleClass="kpi-label"/>
            <Label fx:id="lblTonKhoHetHang" text="—" styleClass="kpi-value"/>
            <Label text="loại nguyên liệu" styleClass="kpi-sub"/>
        </VBox>
        <VBox styleClass="card, kpi-amber" alignment="CENTER" HBox.hgrow="ALWAYS" spacing="6">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <Label text="⚠  Sắp hết" styleClass="kpi-label"/>
            <Label fx:id="lblTonKhoSapHet" text="—" styleClass="kpi-value"/>
            <Label text="loại nguyên liệu" styleClass="kpi-sub"/>
        </VBox>
        <VBox styleClass="card, kpi-green" alignment="CENTER" HBox.hgrow="ALWAYS" spacing="6">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <Label text="✅  Đủ hàng" styleClass="kpi-label"/>
            <Label fx:id="lblTonKhoDuHang" text="—" styleClass="kpi-value"/>
            <Label text="loại nguyên liệu" styleClass="kpi-sub"/>
        </VBox>
    </HBox>

    <!-- Bảng chi tiết -->
    <VBox spacing="8" VBox.vgrow="ALWAYS">
        <Label text="📊  Chi tiết tồn kho theo nguyên liệu" styleClass="lbl-title-card"/>
        <TableView fx:id="tableTonKho" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn text="Nguyên liệu"  prefWidth="180"/>
                <TableColumn text="ĐVT"          prefWidth="70"/>
                <TableColumn text="Tồn đầu kỳ"  prefWidth="120"/>
                <TableColumn text="Nhập kỳ"      prefWidth="120"/>
                <TableColumn text="Xuất kỳ"      prefWidth="120"/>
                <TableColumn text="Tồn cuối kỳ" prefWidth="120"/>
            </columns>
            <placeholder>
                <Label text="Chọn kỳ báo cáo và nhấn 'Xem báo cáo'." styleClass="lbl-body"/>
            </placeholder>
        </TableView>
    </VBox>
    
    <Label fx:id="lblThongBao" styleClass="lbl-status"/>
</VBox>
