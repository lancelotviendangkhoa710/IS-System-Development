<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  NguyenLieuView.fxml — Tab Kiểm kê kho · Quản lý Nguyên liệu.
  Cấu trúc: full-width table + toolbar header (Sửa/Xóa/Thêm).
  Thêm / Sửa qua dialog. Nút Sửa/Xóa disable mặc định, enable khi chọn dòng.
  Controller: NguyenLieuViewFXMLController.
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bakery.views.controllers.kho.NguyenLieuViewFXMLController"
      spacing="20">

    <padding>
        <Insets top="16" right="24" bottom="16" left="24"/>
    </padding>

    <!-- ① HEADER -->
    <VBox spacing="10">
        <HBox alignment="CENTER_LEFT" spacing="15">
            <VBox spacing="5">
                <Label text="Quản lý nguyên liệu" styleClass="lbl-title-screen"/>
                <Label text="Thêm, sửa, xóa các nguyên liệu dùng trong công thức sản xuất bánh."
                       styleClass="lbl-body"/>
            </VBox>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Danh sách nguyên liệu" styleClass="lbl-title-card"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="txtTimKiem" promptText="🔍 Tìm nguyên liệu..."
                       prefWidth="240" onKeyReleased="#onTimKiem" styleClass="text-field"/>
            <Button text="↺ Làm mới" styleClass="btn-reset" onAction="#onLamMoi"/>
            <Button fx:id="btnSua" text="✏️ Sửa" styleClass="btn-secondary" onAction="#onSuaAction" disable="true"/>
            <Button fx:id="btnXoa" text="🗑 Xóa" styleClass="btn-danger" onAction="#onXoaAction" disable="true"/>
            <Button fx:id="btnThemMoi" text="➕ Thêm mới" styleClass="btn-success" onAction="#onThemMoi"/>
        </HBox>
    </VBox>

    <!-- ② TABLE — full width -->
    <TableView fx:id="tblNguyenLieu" styleClass="table-view" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colSoLuongTon" text="Số lượng tồn"     prefWidth="110"/>
            <TableColumn fx:id="colTenNL"     text="Tên nguyên liệu" prefWidth="220"/>
            <TableColumn fx:id="colXuatXu"    text="Xuất xứ"         prefWidth="110"/>
            <TableColumn fx:id="colDVT"       text="ĐV Tính"         prefWidth="90"/>
            <TableColumn fx:id="colMucTon"    text="Mức tồn AT"      prefWidth="110"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- ③ FOOTER STATUS -->
    <HBox>
        <Label fx:id="lblThongBao" styleClass="lbl-small-bold"/>
    </HBox>

</VBox>
