<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bakery.views.controllers.kho.ThemCongThucDialogController"
      spacing="0" prefWidth="460">

    <!-- Header -->
    <HBox styleClass="dialog-header" alignment="CENTER_LEFT" spacing="12">
        <Label text="➕ Thêm nguyên liệu vào công thức" styleClass="dialog-header-title"/>
    </HBox>

    <!-- Body -->
    <VBox styleClass="dialog-body" spacing="16" VBox.vgrow="ALWAYS">

        <VBox spacing="6">
            <Label text="Nguyên liệu: *" styleClass="lbl-body-bold"/>
            <ComboBox fx:id="cmbNguyenLieu" maxWidth="Infinity"
                      promptText="Chọn nguyên liệu..." styleClass="combo-box"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Định mức tiêu hao: *" styleClass="lbl-body-bold"/>
            <TextField fx:id="txtDinhMuc" promptText="VD: 0.25 (kg)" styleClass="text-field"/>
        </VBox>

        <Label fx:id="lblLoi" text="" styleClass="lbl-danger" wrapText="true"/>

    </VBox>

    <!-- Footer -->
    <HBox styleClass="dialog-footer" alignment="CENTER_RIGHT" spacing="10">
        <Button text="Hủy" styleClass="btn-secondary" onAction="#onHuy"/>
        <Button text="✅ Thêm vào công thức" styleClass="btn-primary" onAction="#onXacNhan"/>
    </HBox>

</VBox>
