<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bakery.views.controllers.nhansu.QuanLyNhanVienViewFXMLController"
      spacing="20" styleClass="bg-app">

    <padding>
        <Insets top="28" right="40" bottom="24" left="40"/>
    </padding>

    <!-- ① HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <VBox spacing="4">
            <Label text="Quản lý nhân sự" styleClass="lbl-title-screen"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="txtTimKiem" promptText="🔍 Tìm tên hoặc SĐT..." prefWidth="240" styleClass="text-field"/>
        <ComboBox fx:id="cmbLocTrangThai" promptText="Tất cả trạng thái" prefWidth="180" styleClass="combo-box"/>
        <Button text="↺ Làm mới" styleClass="btn-reset" onAction="#onLamMoi"/>
        <Button fx:id="btnThemMoi" text="➕ Thêm nhân viên" styleClass="btn-success" onAction="#onThemMoi"/>
    </HBox>

    <!-- ② TABLE (full width) -->
    <VBox VBox.vgrow="ALWAYS" spacing="10">
        <Label text="Danh sách nhân viên" styleClass="lbl-title-card"/>

        <TableView fx:id="tblNhanVien" styleClass="table-view" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colMaNV"        text="ID"            prefWidth="60"/>
                <TableColumn fx:id="colHoTen"       text="Họ tên"        prefWidth="220"/>
                <TableColumn fx:id="colSdt"         text="Số điện thoại" prefWidth="140"/>
                <TableColumn fx:id="colVaiTro"      text="Vai trò"       prefWidth="160"/>
                <TableColumn fx:id="colTenDangNhap" text="Tên đăng nhập" prefWidth="160"/>
                <TableColumn fx:id="colTrangThai"   text="Trạng thái"    prefWidth="130"/>
                <TableColumn fx:id="colHanhDong"    text="Hành động"     prefWidth="220"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

    <!-- ③ FOOTER STATUS -->
    <HBox>
        <Label fx:id="lblThongBao" styleClass="lbl-small-bold"/>
    </HBox>

</VBox>
