<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bakery.views.controllers.nhansu.QuanLyNhanVienViewFXMLController">

    <padding>
        <Insets bottom="16" left="24" right="24" top="16"/>
    </padding>

    <!-- ① HEADER: Tiêu đề -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <VBox spacing="4">
            <Label text="👤 Quản lý Nhân viên" styleClass="lbl-title-screen"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- ② CONTENT: Toolbar + TableView -->
    <VBox spacing="10" VBox.vgrow="ALWAYS">

        <!-- Toolbar: tiêu đề bảng + tìm kiếm + lọc + nút hành động -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Danh sách nhân viên" styleClass="lbl-title-card"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="txtTimKiem" promptText="🔍 Tìm tên, SĐT, username..."
                       prefWidth="230" styleClass="text-field"/>
            <ComboBox fx:id="cmbLocTrangThai" promptText="Tất cả trạng thái"
                      prefWidth="175" styleClass="combo-box"/>
            <Button onAction="#onLamMoi" styleClass="btn-reset" text="↺ Làm mới"/>
            <Button fx:id="btnSua" onAction="#onSua" styleClass="btn-secondary"
                    text="✏️ Sửa" disable="true"/>
            <Button fx:id="btnThoiViec" onAction="#onThoiViec" styleClass="btn-danger"
                    text="🔒 Thôi việc" disable="true"/>
            <Button fx:id="btnThemMoi" onAction="#onThemMoi" styleClass="btn-success"
                    text="➕ Thêm nhân viên"/>
        </HBox>

        <!-- TableView -->
        <TableView fx:id="tblNhanVien" styleClass="table-view" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colMaNV"        text="ID"               prefWidth="55"/>
                <TableColumn fx:id="colHoTen"       text="Họ tên"           prefWidth="200"/>
                <TableColumn fx:id="colSdt"         text="Số điện thoại"    prefWidth="130"/>
                <TableColumn fx:id="colVaiTro"      text="Vai trò"          prefWidth="160"/>
                <TableColumn fx:id="colTenDangNhap" text="Tên đăng nhập"    prefWidth="150"/>
                <TableColumn fx:id="colTrangThai"   text="Trạng thái"       prefWidth="140"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

    </VBox>

    <!-- ③ FOOTER STATUS -->
    <HBox>
        <Label fx:id="lblThongBao" styleClass="lbl-small-bold"/>
    </HBox>

</VBox>
