<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  ChamCongView — Tab chấm công nhân viên, tái sử dụng bảng CALAMVIEC.
  - NV thường (MAMAYPOS=NULL): Check-in / Check-out
  - Thu ngân: Xem lịch sử (ca POS đã có màn hình riêng)
  - Hiển thị trạng thái ca hiện tại + lịch sử tháng + tổng giờ làm
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bakery.views.controllers.nhansu.ChamCongViewFXMLController"
      spacing="20" styleClass="bg-app">
    <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

    <!-- ── Header ── -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="4">
            <Label text="⏱ Chấm Công" styleClass="lbl-title-screen"/>
            <Label text="Ghi nhận giờ vào/ra theo ca làm việc thực tế"
                   styleClass="lbl-body"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <!-- Chọn tháng xem lịch sử -->
        <Label text="Tháng:" styleClass="lbl-body"/>
        <ComboBox fx:id="cbThang" prefWidth="80" styleClass="combo-box"/>
        <Label text="/" styleClass="lbl-body"/>
        <ComboBox fx:id="cbNam" prefWidth="100" styleClass="combo-box"/>
        <Button text="🔍 Xem" onAction="#onXemLichSu" styleClass="btn-secondary"/>
    </HBox>

    <!-- ── Trạng thái ca hiện tại ── -->
    <HBox spacing="16">
        <!-- Card trạng thái -->
        <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="📌 Trạng thái ca hiện tại" styleClass="lbl-title-card"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblTrangThaiCa" text="Chưa check-in"
                       styleClass="lbl-body-bold"/>
            </HBox>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Giờ vào:" styleClass="lbl-body"/>
                <Label fx:id="lblGioVao" text="—" styleClass="lbl-body-bold"/>
                <Label text="  |  " styleClass="lbl-muted"/>
                <Label text="Thời gian làm:" styleClass="lbl-body"/>
                <Label fx:id="lblThoiGianLam" text="—" styleClass="lbl-body-bold"/>
            </HBox>

            <HBox spacing="12">
                <Button fx:id="btnCheckIn" text="✅ Check-in (Vào ca)"
                        onAction="#onCheckIn" styleClass="btn-success"
                        prefWidth="180"/>
                <Button fx:id="btnCheckOut" text="🔴 Check-out (Kết ca)"
                        onAction="#onCheckOut" styleClass="btn-danger"
                        prefWidth="180" disable="true"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="🔄 Làm mới" onAction="#onLamMoi" styleClass="btn-secondary"/>
            </HBox>

            <Label fx:id="lblThongBao" text="" styleClass="lbl-body" wrapText="true"/>
        </VBox>

        <!-- Card KPI tháng -->
        <VBox styleClass="card" spacing="12" prefWidth="260">
            <Label text="📊 Tháng này" styleClass="lbl-title-card"/>
            <VBox spacing="8" alignment="CENTER">
                <Label text="NGÀY LÀM VIỆC" styleClass="lbl-small-bold"/>
                <Label fx:id="lblNgayLam" text="0" styleClass="lbl-kpi"/>
                <Label text="ngày có mặt" styleClass="lbl-small"/>
            </VBox>
            <VBox spacing="8" alignment="CENTER">
                <Label text="TỔNG GIỜ LÀM" styleClass="lbl-small-bold"/>
                <Label fx:id="lblTongGio" text="0 giờ 0 phút" styleClass="lbl-price"/>
            </VBox>
        </VBox>
    </HBox>

    <!-- ── Bảng lịch sử ── -->
    <VBox VBox.vgrow="ALWAYS" styleClass="card" spacing="10">
        <Label text="📋 Lịch sử chấm công" styleClass="lbl-title-card"/>
        <TableView fx:id="tablelichSu" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colNgay"      text="Ngày"         prefWidth="110"/>
                <TableColumn fx:id="colGioVao"    text="Giờ vào"      prefWidth="100"/>
                <TableColumn fx:id="colGioRa"     text="Giờ ra"       prefWidth="100"/>
                <TableColumn fx:id="colTongGio"   text="Tổng giờ"     prefWidth="100"/>
                <TableColumn fx:id="colLoai"      text="Loại ca"      prefWidth="130"/>
                <TableColumn fx:id="colTrangThai" text="Trạng thái"   prefWidth="110"/>
            </columns>
            <placeholder>
                <Label text="Chưa có dữ liệu chấm công trong tháng này." styleClass="lbl-body"/>
            </placeholder>
        </TableView>
    </VBox>

</VBox>
