<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
    TheoDoiDonHangView.fxml — Màn hình theo dõi đơn hàng (Chỉ chứa content)
    Được load động vào MainView (AppShell)
    Controller: com.bakery.views.controllers.banhang.TheoDoiDonHangViewFXMLController
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bakery.views.controllers.banhang.TheoDoiDonHangViewFXMLController"
      spacing="20" styleClass="bg-app">

    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

    <!-- ① HEADER: Tiêu đề + Nút hành động -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <VBox spacing="5">
            <Label text="Theo dõi tiến độ đơn hàng" styleClass="lbl-title-screen"/>
            <Label text="Quản lý và cập nhật trạng thái đơn đặt bánh" styleClass="lbl-body"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- ② CONTENT: Filter Bar + Scrollable Cards -->
    <VBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Filter bar -->
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="card">
            <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
            
            <VBox spacing="8">
                <Label text="Mã đơn:" styleClass="lbl-body-bold"/>
                <TextField fx:id="txtTimMaDon" prefWidth="80" styleClass="text-field"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Tên khách:" styleClass="lbl-body-bold"/>
                <TextField fx:id="txtTimKhachHang" prefWidth="150" styleClass="text-field"/>
            </VBox>
            
            <VBox spacing="8">
                <Label text="Ngày nhận:" styleClass="lbl-body-bold"/>
                <DatePicker fx:id="dpNgayTheoDoi" styleClass="text-field" prefWidth="140"/>
            </VBox>
            
            <VBox spacing="8">
                <Label text="Từ giờ:" styleClass="lbl-body-bold"/>
                <ComboBox fx:id="cbGioTu" prefWidth="90" styleClass="combo-box"/>
            </VBox>
            
            <VBox spacing="8">
                <Label text="Đến giờ:" styleClass="lbl-body-bold"/>
                <ComboBox fx:id="cbGioDen" prefWidth="90" styleClass="combo-box"/>
            </VBox>
            
            <VBox spacing="8">
                <Label text="Trạng thái:" styleClass="lbl-body-bold"/>
                <ComboBox fx:id="cbLocTrangThaiTheoDoi" prefWidth="150" styleClass="combo-box" onAction="#onLocTrangThaiTheoDoi"/>
            </VBox>
            
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🔍 Tìm kiếm" styleClass="btn-primary" onAction="#onTimKiemDon" prefHeight="40"/>
        </HBox>

        <!-- Danh sách card đơn hàng -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane-transparent">
            <VBox fx:id="panelChuaDon" spacing="15" styleClass="scroll-content-transparent"/>
        </ScrollPane>
    </VBox>

    <!-- ③ FOOTER STATUS BAR -->
    <HBox>
        <Label fx:id="lblThongBao" styleClass="lbl-small-bold"/>
    </HBox>
</VBox>
