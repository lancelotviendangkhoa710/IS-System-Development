<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!--
    DonHangView.fxml — Màn hình nghiệp vụ POS (Chỉ chứa content)
    Được load động vào MainView (AppShell)
    Controller: com.bakery.views.controllers.banhang.DonHangViewFXMLController
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bakery.views.controllers.banhang.DonHangViewFXMLController"
      styleClass="bg-app"
      spacing="0">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- CONTENT AREA -->
    <HBox fx:id="tabTaoDon" spacing="16" VBox.vgrow="ALWAYS">
        
        <!-- Panel trái: Danh sách sản phẩm (65%) -->
        <VBox HBox.hgrow="ALWAYS" spacing="12">

            <!-- Filter Bar — các nút danh mục được tạo động từ DB trong controller -->
            <HBox fx:id="hboxBoLocDanhMuc" spacing="8" alignment="CENTER_LEFT">
                <ToggleButton fx:id="btnLocTatCa" text="Tất cả"
                             styleClass="toggle-filter"
                             onAction="#onLocDanhMuc"
                             userData="ALL" selected="true"/>
                <ToggleButton fx:id="btnLocTuyChinh" text="✨ Tùy chỉnh"
                             styleClass="toggle-filter"
                             onAction="#onLocDanhMuc"
                             userData="CUSTOM"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtTimKiemSanPham"
                           promptText="🔍  Tìm sản phẩm..."
                           prefWidth="220"
                           styleClass="text-field"/>

            </HBox>

            <!-- Product Area (StackPane chứa 2 màn hình: Products / Custom) -->
            <StackPane VBox.vgrow="ALWAYS">

                <!-- Màn hình sản phẩm thông thường -->
                <ScrollPane fx:id="scrollSanPham" fitToWidth="true"
                            style="-fx-background-color: transparent; -fx-background: transparent;"
                            visible="true">
                    <FlowPane fx:id="tileSanPham"
                              hgap="14" vgap="14"
                              prefWrapLength="600"
                              style="-fx-background-color: transparent;"/>
                </ScrollPane>

                <!-- Màn hình bánh tùy chỉnh (ẩn mặc định) -->
                <ScrollPane fx:id="scrollTuyChinh" fitToWidth="true"
                            style="-fx-background-color: transparent; -fx-background: transparent;"
                            visible="false">
                    <VBox fx:id="panelTuyChinh" spacing="16">
                        <padding>
                            <Insets top="8" right="8" bottom="8" left="8"/>
                        </padding>

                        <Label text="✨ Bánh Tùy Chỉnh" styleClass="lbl-title-card"/>

                        <GridPane hgap="16" vgap="12">
                            <!-- Hàng 1: Loại bánh -->
                            <Label text="Loại bánh:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                   styleClass="lbl-body-bold"/>
                            <ComboBox fx:id="cbCustomSp" prefWidth="240"
                                      GridPane.columnIndex="1" GridPane.rowIndex="0"
                                      styleClass="combo-box"
                                      onAction="#onTuyChinhChanged"/>

                            <!-- Hàng 2: Kích cỡ -->
                            <Label text="Kích cỡ:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                   styleClass="lbl-body-bold"/>
                            <ComboBox fx:id="cbCustomKichCo" prefWidth="240"
                                      GridPane.columnIndex="1" GridPane.rowIndex="1"
                                      styleClass="combo-box"
                                      onAction="#onTuyChinhChanged"/>

                            <!-- Hàng 3: Cốt bánh -->
                            <Label text="Cốt bánh:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                   styleClass="lbl-body-bold"/>
                            <ComboBox fx:id="cbCustomCotBanh" prefWidth="240"
                                      GridPane.columnIndex="1" GridPane.rowIndex="2"
                                      styleClass="combo-box"
                                      onAction="#onTuyChinhChanged"/>

                            <!-- Hàng 4: Nhân bánh -->
                            <Label text="Nhân bánh:" GridPane.columnIndex="0" GridPane.rowIndex="3"
                                   styleClass="lbl-body-bold"/>
                            <ComboBox fx:id="cbCustomNhanBanh" prefWidth="240"
                                      GridPane.columnIndex="1" GridPane.rowIndex="3"
                                      styleClass="combo-box"
                                      onAction="#onTuyChinhChanged"/>

                            <!-- Hàng 5: Trang trí -->
                            <Label text="Trang trí:" GridPane.columnIndex="0" GridPane.rowIndex="4"
                                   styleClass="lbl-body-bold"/>
                            <ComboBox fx:id="cbCustomTrangTri" prefWidth="240"
                                      GridPane.columnIndex="1" GridPane.rowIndex="4"
                                      styleClass="combo-box"
                                      onAction="#onTuyChinhChanged"/>

                            <!-- Hàng 6: Lời chúc -->
                            <Label text="Lời chúc:" GridPane.columnIndex="0" GridPane.rowIndex="5"
                                   styleClass="lbl-body-bold"/>
                            <TextArea fx:id="txtCustomLoiChuc" prefWidth="240" prefHeight="60"
                                      styleClass="text-area" promptText="Nhập lời chúc..."
                                      GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                            <!-- Hàng 7: Ghi chú -->
                            <Label text="Ghi chú:" GridPane.columnIndex="0" GridPane.rowIndex="6"
                                   styleClass="lbl-body-bold"/>
                            <TextArea fx:id="txtCustomGhiChu" prefWidth="240" prefHeight="60"
                                      styleClass="text-area" promptText="Ghi chú đặc biệt..."
                                      GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                        </GridPane>

                        <!-- Giá + Số lượng + Thêm -->
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="Đơn giá:" styleClass="lbl-body-bold"/>
                            <Label fx:id="lblGiaTuyChinh" text="0 đ" styleClass="lbl-price"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Số lượng:" styleClass="lbl-body-bold"/>
                            <Spinner fx:id="spCustomSoLuong" prefWidth="80"
                                     styleClass="text-field"/>
                            <Button text="🛒 Thêm vào giỏ"
                                    fx:id="btnThemTuyChinh"
                                    styleClass="btn-primary"
                                    onAction="#onThemBanhTuyChinh"/>
                        </HBox>
                    </VBox>
                </ScrollPane>

            </StackPane>
        </VBox>

        <!-- Panel phải: Giỏ hàng (35%) -->
        <VBox prefWidth="430" minWidth="380" spacing="12">

            <!-- Giỏ hàng -->
            <VBox styleClass="card" spacing="8" VBox.vgrow="ALWAYS">
                <Label text="🛒 Giỏ hàng" styleClass="lbl-title-card"/>
                <TableView fx:id="tblGioHang" VBox.vgrow="ALWAYS"
                           styleClass="table-view">
                    <columns>
                        <TableColumn fx:id="colTenSP" text="Sản phẩm" prefWidth="120"/>
                        <TableColumn fx:id="colSoLuong" text="SL" prefWidth="120"/>
                        <TableColumn fx:id="colDonGia" text="Đơn giá" prefWidth="85"/>
                        <TableColumn fx:id="colThanhTien" text="Thành tiền" prefWidth="65"/>
                        <TableColumn fx:id="colXoa" text="" prefWidth="36"/>
                    </columns>
                    <placeholder>
                        <Label text="Chưa có sản phẩm nào" styleClass="lbl-body"/>
                    </placeholder>
                </TableView>
            </VBox>

            <!-- Tóm tắt tiền -->
            <VBox styleClass="card" spacing="6">
                <HBox>
                    <Label text="Tạm tính:" styleClass="lbl-body"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTongTienHang" text="0 đ" styleClass="lbl-body-bold"/>
                </HBox>
                <HBox>
                    <Label text="Giảm giá (10%):" styleClass="lbl-body"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTienGiamGia" text="0 đ"
                           style="-fx-text-fill: #16A34A; -fx-font-weight: bold;"/>
                </HBox>
                <Separator/>
                <HBox>
                    <Label text="Tổng thanh toán:" styleClass="lbl-body-bold"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTongThanhToan" text="0 đ" styleClass="lbl-price"/>
                </HBox>
                <HBox>
                    <Label text="Cọc tối thiểu (50%):" styleClass="lbl-small-bold"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblCocToiThieu" text="0 đ" styleClass="lbl-small-bold"/>
                </HBox>
            </VBox>

            <!-- Thông báo & Nút thanh toán -->
            <Label fx:id="lblThongBao" text="" wrapText="true"
                   styleClass="lbl-small-bold" maxWidth="Infinity"/>
            <Button fx:id="btnThanhToan"
                    text="✅ Tạo đơn &amp; Thanh toán"
                    styleClass="btn-success"
                    maxWidth="Infinity"
                    disable="true"
                    onAction="#onThanhToan"/>
        </VBox>
    </HBox>

</VBox>
