<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    MoCaView.fxml — Màn hình xác nhận mở ca (chỉ dành cho CASHIER)
    Hiển thị sau khi đăng nhập nếu chưa có ca đang mở.
    Controller: com.bakery.views.controllers.MoCaController
-->
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.bakery.views.controllers.MoCaViewFXMLController"
           styleClass="app-bg">

    <!-- Card trung tâm -->
    <VBox styleClass="login-card"
          maxWidth="480" minWidth="380"
          spacing="0" alignment="TOP_CENTER">

        <!-- ── ICON ── -->
        <StackPane styleClass="login-icon-circle" alignment="CENTER">
            <Label text="&#9749;"
                   style="-fx-text-fill: white; -fx-font-size: 28px;
                          -fx-font-family: 'Segoe UI';"/>
        </StackPane>
        <Region prefHeight="20"/>

        <!-- ── TIÊU ĐỀ ── -->
        <Label text="Xác nhận Mở Ca"
               style="-fx-font-size: 22px; -fx-font-weight: bold;
                      -fx-text-fill: -amber-primary; -fx-font-family: 'Segoe UI';"/>
        <Region prefHeight="8"/>

        <!-- ── LỜI CHÀO ── -->
        <HBox spacing="4" alignment="CENTER">
            <Label text="Xin chào,"
                   style="-fx-font-size: 14px; -fx-text-fill: -text-secondary;
                          -fx-font-family: 'Segoe UI';"/>
            <Label fx:id="lblHoTen" text="Thu Ngân"
                   style="-fx-font-size: 14px; -fx-font-weight: bold;
                          -fx-text-fill: -amber-primary; -fx-font-family: 'Segoe UI';"/>
        </HBox>
        <Region prefHeight="20"/>

        <!-- ── HỘP HƯỚNG DẪN ── -->
        <VBox styleClass="moca-info-box" maxWidth="400">
            <Label text="Vui lòng đếm và nhập số tiền mặt hiện có trong két trước khi bắt đầu ca làm việc. Thông tin này dùng để đối soát cuối ca."
                   wrapText="true"
                   style="-fx-font-size: 13px; -fx-text-fill: -amber-text;
                          -fx-font-family: 'Segoe UI'; -fx-line-spacing: 2;"/>
        </VBox>
        <Region prefHeight="24"/>

        <!-- ── FORM ── -->
        <VBox spacing="16" maxWidth="400">

            <!-- Máy POS -->
            <VBox styleClass="form-group">
                <Label text="Máy POS" styleClass="text-small"/>
                <Region prefHeight="4"/>
                <ComboBox fx:id="cbMayPOS"
                          styleClass="combo-box"
                          maxWidth="Infinity"
                          promptText="Chọn máy POS"/>
            </VBox>

            <!-- Tiền đầu ca -->
            <VBox styleClass="form-group">
                <Label text="Tiền mặt đầu ca (VNĐ)" styleClass="text-small"/>
                <Region prefHeight="4"/>
                <HBox styleClass="prefix-field-box" alignment="CENTER_LEFT">
                    <Label text="đ" styleClass="prefix-label"/>
                    <TextField fx:id="tfTienDauCa"
                               styleClass="prefix-input"
                               promptText="0"
                               HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

        </VBox>

        <!-- ── LỖI ── -->
        <Region prefHeight="8"/>
        <Label fx:id="lblThongBao" text=" " styleClass="text-error" wrapText="true" maxWidth="400"/>

        <!-- ── LOADING ── -->
        <StackPane fx:id="paneLoading" visible="false" managed="false" prefHeight="32">
            <ProgressIndicator prefWidth="28" prefHeight="28"/>
        </StackPane>

        <Region prefHeight="8"/>

        <!-- ── BUTTONS ── -->
        <HBox spacing="12" maxWidth="400">
            <Button text="Đăng xuất"
                    styleClass="btn-secondary"
                    onAction="#onDangXuat"
                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button fx:id="btnBatDau"
                    text="Bắt đầu làm việc"
                    styleClass="btn-primary"
                    onAction="#onBatDauLamViec"
                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>

    </VBox>

</StackPane>
