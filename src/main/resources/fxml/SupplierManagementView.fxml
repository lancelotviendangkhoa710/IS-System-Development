<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bakery.views.controllers.SupplierManagementViewFXMLController"
      spacing="20" styleClass="bg-app">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <!-- ① HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Button text="← Quay lại" styleClass="btn-secondary" onAction="#onVeMenu"/>
        <VBox spacing="5">
            <Label text="Quản lý Nhà Cung Cấp" styleClass="lbl-title-screen"/>
            <Label text="Thêm, sửa, xóa thông tin nhà cung cấp nguyên liệu." styleClass="lbl-body"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- ② CONTENT -->
    <HBox spacing="30" VBox.vgrow="ALWAYS">

        <!-- Left: Search + TableView -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Danh sách nhà cung cấp" styleClass="lbl-title-card"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtTimKiem" promptText="🔍 Tìm theo tên hoặc SĐT..."
                           prefWidth="260" onKeyReleased="#onTimKiem" styleClass="text-field"/>
                <Button text="Tải lại" onAction="#onTaiLai" styleClass="btn-secondary"/>
            </HBox>

            <TableView fx:id="tvNhaCungCap" styleClass="table-view" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colMaNCC"  text="Mã NCC"          prefWidth="80"/>
                    <TableColumn fx:id="colTenNCC" text="Tên Nhà Cung Cấp" prefWidth="250"/>
                    <TableColumn fx:id="colSdt"    text="Số Điện Thoại"   prefWidth="150"/>
                    <TableColumn fx:id="colDiaChi" text="Địa Chỉ"         prefWidth="350"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- Right: Form Card -->
        <VBox spacing="20" styleClass="card" prefWidth="400" alignment="TOP_CENTER">
            <Label text="Thông tin chi tiết" styleClass="lbl-title-card"/>

            <VBox spacing="8">
                <Label text="Mã Nhà Cung Cấp" styleClass="lbl-body-bold"/>
                <TextField fx:id="txtMaNCC" disable="true" styleClass="text-field"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Tên Nhà Cung Cấp: *" styleClass="lbl-body-bold"/>
                <TextField fx:id="txtTenNCC" styleClass="text-field"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Số Điện Thoại:" styleClass="lbl-body-bold"/>
                <TextField fx:id="txtSdt" styleClass="text-field"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Địa Chỉ:" styleClass="lbl-body-bold"/>
                <TextArea fx:id="txtDiaChi" prefRowCount="3" wrapText="true" styleClass="text-field"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="12" maxWidth="Infinity">
                <Button fx:id="btnThem" text="➕ Thêm Mới"
                        onAction="#onThem" maxWidth="Infinity" styleClass="btn-primary"/>
                <Button fx:id="btnLuu" text="💾 Lưu Thay Đổi"
                        onAction="#onLuu" maxWidth="Infinity" styleClass="btn-primary"/>
                <Button fx:id="btnHuy" text="↺ Làm Mới Form"
                        onAction="#onHuy" maxWidth="Infinity" styleClass="btn-secondary"/>
                <Button fx:id="btnXoa" text="🗑 Xóa Đối Tác"
                        onAction="#onXoa" maxWidth="Infinity" styleClass="btn-danger"/>
            </VBox>
        </VBox>

    </HBox>

    <!-- ③ FOOTER STATUS BAR -->
    <HBox>
        <Label fx:id="lblThongBao" styleClass="lbl-small-bold"/>
    </HBox>

</VBox>
