<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    DashboardView.fxml — Tổng quan & Đối soát
    Layout: 4 KPI card + (Top 5 chart | Đóng ca panel).
    Controller: com.bakery.views.controllers.DashboardController
-->
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bakery.views.controllers.DashboardController"
      spacing="20">

    <!-- ══ ROW 1: 4 KPI CARDS ══════════════════════════════════════════════ -->
    <HBox spacing="16">

        <!-- Doanh thu hôm nay -->
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="0">
            <HBox spacing="14" alignment="CENTER_LEFT">
                <StackPane styleClass="icon-circle, icon-circle-success">
                    <Label text="↑"
                           style="-fx-text-fill: #16A34A; -fx-font-size: 20px;
                                  -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
                </StackPane>
                <VBox spacing="4">
                    <Label text="Doanh thu hôm nay" styleClass="text-small"/>
                    <Label fx:id="lblDoanhThu" text="—" styleClass="text-kpi"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Đơn đã hoàn thành -->
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="0">
            <HBox spacing="14" alignment="CENTER_LEFT">
                <StackPane styleClass="icon-circle, icon-circle-info">
                    <Label text="✓"
                           style="-fx-text-fill: #2563EB; -fx-font-size: 20px;
                                  -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
                </StackPane>
                <VBox spacing="4">
                    <Label text="Đơn đã hoàn thành" styleClass="text-small"/>
                    <Label fx:id="lblDonHoanThanh" text="—" styleClass="text-kpi"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Đơn đang xử lý -->
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="0">
            <HBox spacing="14" alignment="CENTER_LEFT">
                <StackPane styleClass="icon-circle, icon-circle-warning">
                    <Label text="○"
                           style="-fx-text-fill: #D97706; -fx-font-size: 20px;
                                  -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
                </StackPane>
                <VBox spacing="4">
                    <Label text="Đơn đang xử lý" styleClass="text-small"/>
                    <Label fx:id="lblDonDangXuLy" text="—" styleClass="text-kpi"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Cảnh báo tồn kho -->
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="0">
            <HBox spacing="14" alignment="CENTER_LEFT">
                <StackPane styleClass="icon-circle, icon-circle-danger">
                    <Label text="!"
                           style="-fx-text-fill: #DC2626; -fx-font-size: 22px;
                                  -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
                </StackPane>
                <VBox spacing="4">
                    <Label text="Cảnh báo tồn kho" styleClass="text-small"/>
                    <Label fx:id="lblCanhBaoTonKho" text="—" styleClass="text-kpi"/>
                </VBox>
            </HBox>
        </VBox>

    </HBox>

    <!-- ══ ROW 2: BIỂU ĐỒ TOP 5 + CARD ĐÓNG CA ════════════════════════════ -->
    <HBox spacing="16" VBox.vgrow="ALWAYS">

        <!-- LEFT: Top 5 bánh bán chạy -->
        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="0">

            <Label text="Top 5 Bánh Bán Chạy (Tháng)" styleClass="text-title-card"/>
            <Region prefHeight="20"/>

            <!-- Placeholder loading — ẩn sau khi có data -->
            <StackPane fx:id="paneLoadingTop5" prefHeight="160">
                <ProgressIndicator prefWidth="32" prefHeight="32"/>
            </StackPane>

            <!-- Danh sách bars — hiện sau khi load xong -->
            <VBox fx:id="vboxTop5" spacing="14" visible="false" managed="false"/>

        </VBox>

        <!-- RIGHT: Nghiệp vụ Đóng Ca (chỉ hiện với CASHIER) -->
        <VBox fx:id="cardDongCa"
              styleClass="card-dong-ca"
              alignment="CENTER"
              spacing="20"
              prefWidth="340" minWidth="300" maxWidth="380"
              visible="false" managed="false">

            <!-- Icon calculator -->
            <StackPane style="-fx-background-color: rgba(255,255,255,0.18);
                              -fx-background-radius: 14px;"
                       prefWidth="64" prefHeight="64">
                <Label text="&#9635;"
                       style="-fx-text-fill: #FDE68A; -fx-font-size: 30px;
                              -fx-font-family: 'Segoe UI';"/>
            </StackPane>

            <VBox spacing="8" alignment="CENTER">
                <Label text="Nghiệp vụ Đóng Ca"
                       style="-fx-text-fill: white; -fx-font-size: 18px;
                              -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
                <Label text="Đối soát dòng tiền mặt tại két trước khi ra về."
                       style="-fx-text-fill: #FDE68A; -fx-font-size: 13px;
                              -fx-font-family: 'Segoe UI';"
                       wrapText="true" textAlignment="CENTER" maxWidth="260"/>
            </VBox>

            <Button text="Thực hiện Đối soát ngay"
                    styleClass="btn-on-amber"
                    onAction="#onThucHienDongCa"/>

        </VBox>

    </HBox>

</VBox>
