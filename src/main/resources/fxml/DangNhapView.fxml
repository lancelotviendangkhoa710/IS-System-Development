<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bakery.views.controllers.nhansu.DangNhapViewFXMLController"
      styleClass="bg-app"
      alignment="CENTER"
      spacing="20"
      prefWidth="1280"
      prefHeight="720">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <HBox maxWidth="1120" VBox.vgrow="ALWAYS" spacing="30" alignment="CENTER">
        <VBox spacing="20" HBox.hgrow="ALWAYS" styleClass="card,login-hero">
            <Label text="H3K Bakery" styleClass="login-hero-brand"/>
        </VBox>

        <VBox alignment="TOP_LEFT" spacing="20" prefWidth="420" styleClass="card,login-form-box">
            <Label text="Đăng nhập" styleClass="lbl-title-screen"/>
            <Label text="Chào mừng bạn trở lại với hệ thống quản trị." styleClass="lbl-body"/>

            <VBox spacing="8">
                <Label text="Tên đăng nhập" styleClass="lbl-body-bold"/>
                <TextField fx:id="txtTenDangNhap" promptText="" styleClass="text-field"/>
            </VBox>

            <VBox spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Mật khẩu" styleClass="lbl-body-bold"/>
                </HBox>
                <PasswordField fx:id="txtMatKhau" promptText="" styleClass="text-field" onAction="#onDangNhap"/>
            </VBox>

            <Button text="Đăng nhập" styleClass="btn-primary" maxWidth="Infinity" onAction="#onDangNhap"/>
            <Label fx:id="lblThongBao" styleClass="lbl-danger" wrapText="true" maxWidth="Infinity"/>
        </VBox>
    </HBox>
</VBox>
