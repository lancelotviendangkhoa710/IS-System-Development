<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bakery.views.controllers.baocao.BaoCaoViewFXMLController"
            styleClass="bg-app">

    <!-- TOP HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="report-header">
            <VBox spacing="4">
                <Label text="📊 Báo cáo &amp; Sổ quỹ" styleClass="lbl-title-screen"/>
                <Label text="Thống kê hiệu suất kinh doanh và quản lý dòng tiền" styleClass="lbl-body"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <TabPane fx:id="tabPaneBaoCao" tabClosingPolicy="UNAVAILABLE" styleClass="modern-tab-pane">
            <tabs>
                <Tab fx:id="tabThongKeKinhDoanh" text="📈  Thống kê kinh doanh">
                    <content>
                        <ScrollPane fitToWidth="true" styleClass="report-scroll">
                            <VBox spacing="24" style="-fx-padding: 20 40 40 40;">

                                <!-- Filter Row -->
                                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="report-filter-bar">
                                    <Label text="🗓" style="-fx-font-size: 16px;"/>
                                    <ComboBox fx:id="cbLoaiBaoCao" prefWidth="100" promptText="Ngày" styleClass="combo-box"/>
                                    <DatePicker fx:id="dpNgayBaoCao" prefWidth="140"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button id="btnXuatJasperPDF"
                                            text="📄  Xuất PDF"
                                            onAction="#onXuatJasperPDF"
                                            styleClass="btn-primary"
                                            style="-fx-font-weight: bold;"/>
                                    <Button id="btnXuatJasperExcel"
                                            text="📊  Xuất Excel"
                                            onAction="#onXuatJasperExcel"
                                            styleClass="btn-reset"
                                            style="-fx-font-weight: bold;"/>
                                    <Button id="btnXuatLichSu"
                                            text="📋  Báo cáo"
                                            onAction="#onXuatLichSuMuaHang"
                                            styleClass="btn-secondary"
                                            style="-fx-font-weight: bold;"/>
                                </HBox>

                                <!-- KPI CARDS — 4 màu gradient khác nhau -->
                                <GridPane hgap="20" vgap="20">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="25"/>
                                        <ColumnConstraints percentWidth="25"/>
                                        <ColumnConstraints percentWidth="25"/>
                                        <ColumnConstraints percentWidth="25"/>
                                    </columnConstraints>

                                    <!-- Card 1: Doanh Thu — Amber gradient -->
                                    <VBox GridPane.columnIndex="0" styleClass="kpi-card, kpi-amber" spacing="10">
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <Label text="💰" style="-fx-font-size: 22px;"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Label text="+12.5% ↗" styleClass="kpi-badge-up"/>
                                        </HBox>
                                        <Label text="DOANH THU" styleClass="kpi-label"/>
                                        <Label fx:id="lblDoanhThu" text="0đ" styleClass="kpi-value"/>
                                        <Label fx:id="lblChenhLechDoanhThu" text="Chưa có dữ liệu hôm qua"
                                               styleClass="kpi-sub"/>
                                    </VBox>

                                    <!-- Card 2: Lợi Nhuận — Green gradient -->
                                    <VBox GridPane.columnIndex="1" styleClass="kpi-card, kpi-green" spacing="10">
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <Label text="🏦" style="-fx-font-size: 22px;"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Label text="+4.2% ↗" styleClass="kpi-badge-up"/>
                                        </HBox>
                                        <Label text="LỢI NHUẬN" styleClass="kpi-label"/>
                                        <Label fx:id="lblLoiNhuan" text="0đ" styleClass="kpi-value"/>
                                        <Label text="Doanh thu - Giá vốn thực tế" styleClass="kpi-sub"/>
                                    </VBox>

                                    <!-- Card 3: Tổng Đơn — Blue gradient -->
                                    <VBox GridPane.columnIndex="2" styleClass="kpi-card, kpi-blue" spacing="10">
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <Label text="🛍️" style="-fx-font-size: 22px;"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Label text="Ổn định" styleClass="kpi-badge-neutral"/>
                                        </HBox>
                                        <Label text="TỔNG ĐƠN HÀNG" styleClass="kpi-label"/>
                                        <Label fx:id="lblTongDon" text="0" styleClass="kpi-value"/>
                                        <Label text="Đơn đã hoàn thành" styleClass="kpi-sub"/>
                                    </VBox>

                                    <!-- Card 4: Khách Hàng — Purple gradient -->
                                    <VBox GridPane.columnIndex="3" styleClass="kpi-card, kpi-purple" spacing="10">
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <Label text="⭐" style="-fx-font-size: 22px;"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Label text="-2.1% ↘" styleClass="kpi-badge-down"/>
                                        </HBox>
                                        <Label text="KHÁCH THÀNH VIÊN" styleClass="kpi-label"/>
                                        <Label fx:id="lblKhachHang" text="0" styleClass="kpi-value"/>
                                        <Label text="Khách hàng tích điểm" styleClass="kpi-sub"/>
                                    </VBox>
                                </GridPane>

                                <!-- LINE CHART: Doanh Thu -->
                                <VBox styleClass="chart-card" spacing="8">
                                    <HBox alignment="CENTER_LEFT" spacing="12">
                                        <Label text="📈" style="-fx-font-size: 18px;"/>
                                        <VBox>
                                            <Label text="Biểu đồ Doanh Thu" styleClass="lbl-medium-bold"/>
                                            <Label text="Diễn biến doanh thu trong tuần"
                                                   style="-fx-text-fill: #6B7280; -fx-font-size: 12px;"/>
                                        </VBox>
                                    </HBox>
                                    <LineChart fx:id="revenueChart" prefHeight="300"
                                               legendVisible="true" createSymbols="true"
                                               animated="true">
                                        <xAxis><CategoryAxis side="BOTTOM" label="Thời gian"/></xAxis>
                                        <yAxis><NumberAxis side="LEFT" label="Doanh thu (VNĐ)"/></yAxis>
                                    </LineChart>
                                </VBox>

                                <!-- PIE + BAR CHARTS ROW -->
                                <HBox spacing="20">
                                    <!-- Pie Chart -->
                                    <VBox styleClass="chart-card" prefWidth="400" spacing="8">
                                        <HBox alignment="CENTER_LEFT" spacing="12">
                                            <Label text="🥧" style="-fx-font-size: 18px;"/>
                                            <VBox>
                                                <Label text="Cơ cấu doanh thu" styleClass="lbl-medium-bold"/>
                                                <Label text="Theo danh mục sản phẩm"
                                                       style="-fx-text-fill: #6B7280; -fx-font-size: 12px;"/>
                                            </VBox>
                                        </HBox>
                                        <PieChart fx:id="revenuePieChart" prefHeight="260"
                                                  legendSide="BOTTOM" animated="true"
                                                  labelsVisible="true"/>
                                    </VBox>

                                    <!-- Bar Chart -->
                                    <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" spacing="8">
                                        <HBox alignment="CENTER_LEFT" spacing="12">
                                            <Label text="📊" style="-fx-font-size: 18px;"/>
                                            <VBox>
                                                <Label text="So sánh doanh thu" styleClass="lbl-medium-bold"/>
                                                <Label text="Giữa các danh mục"
                                                       style="-fx-text-fill: #6B7280; -fx-font-size: 12px;"/>
                                            </VBox>
                                        </HBox>
                                        <BarChart fx:id="revenueBarChart" prefHeight="260"
                                                  legendVisible="false" animated="true">
                                            <xAxis><CategoryAxis side="BOTTOM" label="Danh mục"/></xAxis>
                                            <yAxis><NumberAxis side="LEFT" label="Doanh thu (VNĐ)"/></yAxis>
                                        </BarChart>
                                    </VBox>
                                </HBox>

                                <!-- BEST SELLERS + TRANSACTIONS ROW -->
                                <HBox spacing="20">
                                    <!-- Best Sellers -->
                                    <VBox fx:id="vboxBestSellers" styleClass="chart-card" prefWidth="360"
                                          spacing="16">
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <Label text="🏆" style="-fx-font-size: 18px;"/>
                                            <Label text="Bánh bán chạy nhất" styleClass="lbl-medium-bold"/>
                                        </HBox>
                                        <Region VBox.vgrow="ALWAYS"/>
                                        <Button text="Xem chi tiết kho →" styleClass="btn-ghost"
                                                maxWidth="Infinity"/>
                                    </VBox>

                                    <!-- Latest Transactions -->
                                    <VBox styleClass="chart-card" HBox.hgrow="ALWAYS">
                                        <HBox alignment="CENTER_LEFT"
                                              style="-fx-padding: 0 0 14 0; -fx-border-color: #F0EDEA; -fx-border-width: 0 0 1 0;">
                                            <Label text="Giao dịch mới nhất" styleClass="lbl-medium-bold"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Label text="● Cập nhật Live" styleClass="badge-live"/>
                                        </HBox>
                                        <TableView fx:id="tableGiaoDich" prefHeight="260"
                                                   styleClass="table-view"
                                                   style="-fx-background-color: transparent;">
                                            <columns>
                                                <TableColumn text="Mã Đơn" prefWidth="100"/>
                                                <TableColumn text="Khách hàng" prefWidth="150"/>
                                                <TableColumn text="Món" prefWidth="250"/>
                                                <TableColumn text="Tổng tiền" prefWidth="120"/>
                                                <TableColumn text="Trạng thái" prefWidth="120"/>
                                            </columns>
                                        </TableView>
                                    </VBox>
                                </HBox>

                                <!-- BIỂU ĐỒ THEO THÁNG: DOANH THU + LỢI NHUẬN (side-by-side) -->
                                <HBox spacing="20">
                                    <!-- Doanh thu 12 tháng -->
                                    <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" spacing="8">
                                        <HBox alignment="CENTER_LEFT" spacing="12">
                                            <Label text="📅" style="-fx-font-size: 18px;"/>
                                            <VBox HBox.hgrow="ALWAYS">
                                                <Label text="Doanh thu theo tháng" styleClass="lbl-medium-bold"/>
                                                <Label text="So sánh 12 tháng trong năm"
                                                       style="-fx-text-fill: #6B7280; -fx-font-size: 12px;"/>
                                            </VBox>
                                            <ComboBox fx:id="cbNamBieuDo" prefWidth="90" styleClass="combo-box"/>
                                        </HBox>
                                        <BarChart fx:id="monthlyBarChart" prefHeight="280"
                                                  legendVisible="false" animated="true">
                                            <xAxis><CategoryAxis side="BOTTOM" label="Tháng"/></xAxis>
                                            <yAxis><NumberAxis side="LEFT" label="Doanh thu (VNĐ)"/></yAxis>
                                        </BarChart>
                                    </VBox>

                                    <!-- Lợi nhuận 12 tháng -->
                                    <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" spacing="8">
                                        <HBox alignment="CENTER_LEFT" spacing="12">
                                            <Label text="💹" style="-fx-font-size: 18px;"/>
                                            <VBox HBox.hgrow="ALWAYS">
                                                <Label text="Lợi nhuận theo tháng" styleClass="lbl-medium-bold"/>
                                                <Label text="Doanh thu − Giá vốn COGS"
                                                       style="-fx-text-fill: #6B7280; -fx-font-size: 12px;"/>
                                            </VBox>
                                            <ComboBox fx:id="cbNamBieuDoLoiNhuan" prefWidth="90" styleClass="combo-box"/>
                                        </HBox>
                                        <BarChart fx:id="monthlyProfitBarChart" prefHeight="280"
                                                  legendVisible="false" animated="true">
                                            <xAxis><CategoryAxis side="BOTTOM" label="Tháng"/></xAxis>
                                            <yAxis><NumberAxis side="LEFT" label="Lợi nhuận (VNĐ)"/></yAxis>
                                        </BarChart>
                                    </VBox>
                                </HBox>

                            </VBox>
                        </ScrollPane>
                    </content>
                </Tab>

                <Tab fx:id="tabLoiNhuanSanPham" text="📊  Lợi nhuận sản phẩm">
                    <content>
                        <ScrollPane fitToWidth="true" styleClass="report-scroll">
                            <VBox spacing="24" style="-fx-padding: 20 40 40 40;">
                                <!-- KPI Cards cho Sản phẩm -->
                                <GridPane hgap="20" vgap="20">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="33.3"/>
                                        <ColumnConstraints percentWidth="33.3"/>
                                        <ColumnConstraints percentWidth="33.4"/>
                                    </columnConstraints>
                                    
                                    <!-- KPI 1: SP Sinh Lời Nhất — Green gradient -->
                                    <VBox GridPane.columnIndex="0" styleClass="kpi-card, kpi-green" spacing="10">
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <Label text="🏦" style="-fx-font-size: 22px;"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Label text="Lợi nhuận cao nhất" styleClass="kpi-badge-up"/>
                                        </HBox>
                                        <Label text="SẢN PHẨM SINH LỜI NHẤT" styleClass="kpi-label"/>
                                        <Label fx:id="lblLoiNhuanSPSinhLoiNhat" text="Chưa có dữ liệu" styleClass="kpi-value" style="-fx-font-size: 18px;"/>
                                        <Label fx:id="lblLoiNhuanSPSinhLoiNhatGiaTri" text="0đ" styleClass="kpi-sub"/>
                                    </VBox>

                                    <!-- KPI 2: SP Bán Chạy Nhất — Amber gradient -->
                                    <VBox GridPane.columnIndex="1" styleClass="kpi-card, kpi-amber" spacing="10">
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <Label text="🏆" style="-fx-font-size: 22px;"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Label text="Số lượng bán nhiều nhất" styleClass="kpi-badge-neutral"/>
                                        </HBox>
                                        <Label text="SẢN PHẨM BÁN CHẠY NHẤT" styleClass="kpi-label"/>
                                        <Label fx:id="lblLoiNhuanSPBanChayNhat" text="Chưa có dữ liệu" styleClass="kpi-value" style="-fx-font-size: 18px;"/>
                                        <Label fx:id="lblLoiNhuanSPBanChayNhatGiaTri" text="0 cái" styleClass="kpi-sub"/>
                                    </VBox>

                                    <!-- KPI 3: Biên Lợi Nhuận Gộp TB — Blue gradient -->
                                    <VBox GridPane.columnIndex="2" styleClass="kpi-card, kpi-blue" spacing="10">
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <Label text="💹" style="-fx-font-size: 22px;"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Label text="Hiệu quả gộp" styleClass="kpi-badge-up"/>
                                        </HBox>
                                        <Label text="BIÊN LỢI NHUẬN GỘP TB" styleClass="kpi-label"/>
                                        <Label fx:id="lblLoiNhuanBienLNTB" text="0.0%" styleClass="kpi-value"/>
                                        <Label text="Tổng lợi nhuận / Tổng doanh thu" styleClass="kpi-sub"/>
                                    </VBox>
                                </GridPane>

                                <!-- Table View: Danh sách sản phẩm -->
                                <VBox styleClass="chart-card" spacing="12">
                                    <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 14 0; -fx-border-color: #F0EDEA; -fx-border-width: 0 0 1 0;">
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <Label text="Chi tiết lợi nhuận theo sản phẩm" styleClass="lbl-medium-bold"/>
                                            <Label text="Danh sách thống kê doanh số và lợi nhuận gộp từng sản phẩm trong kỳ" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;"/>
                                        </VBox>
                                    </HBox>
                                    <TableView fx:id="tblLoiNhuanSanPham" prefHeight="400" styleClass="table-view" style="-fx-background-color: transparent;">
                                        <columns>
                                            <TableColumn fx:id="colLoiNhuanTenSP" text="Tên sản phẩm" prefWidth="250"/>
                                            <TableColumn fx:id="colLoiNhuanTenDM" text="Danh mục" prefWidth="150"/>
                                            <TableColumn fx:id="colLoiNhuanSoLuong" text="Số lượng bán" prefWidth="120"/>
                                            <TableColumn fx:id="colLoiNhuanDoanhThu" text="Doanh thu" prefWidth="140"/>
                                            <TableColumn fx:id="colLoiNhuanGiaVon" text="Giá vốn (COGS)" prefWidth="140"/>
                                            <TableColumn fx:id="colLoiNhuanLoiNhuan" text="Lợi nhuận" prefWidth="140"/>
                                            <TableColumn fx:id="colLoiNhuanTyle" text="Tỷ suất LN" prefWidth="120"/>
                                        </columns>
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                        </columnResizePolicy>
                                    </TableView>
                                </VBox>
                            </VBox>
                        </ScrollPane>
                    </content>
                </Tab>

                <Tab fx:id="tabSoQuyThuChi" text="💰  Sổ quỹ thu chi">
                    <content>
                        <fx:include source="SoQuyView.fxml"/>
                    </content>
                </Tab>

                <Tab fx:id="tabQuanLyLoai" text="📋  Quản lý loại thu chi">
                    <content>
                        <fx:include source="../taichinh/QuanLyLoaiThuChiView.fxml"/>
                    </content>
                </Tab>

                <Tab fx:id="tabGiamSatCa" text="🔍  Giám sát tiền mặt đóng ca">
                    <content>
                        <fx:include source="../hethong/GiamSatCaView.fxml"/>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
