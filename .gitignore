# Biểu mẫu gitignore cho dự án Java Maven (VSCode)

# ── Build output ────────────────────────────────────────────────────────────
target/
bin/
build/
out/
build-check/
.tools/

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
.project
.classpath
.settings/

# ── Bảo mật / Môi trường ─────────────────────────────────────────────────────
src/main/java/com/bakery/utils/DBConnect.java
src/main/resources/application.properties
src/main/resources/email.properties
*.env
application.properties
acc.md

# ── AI / Agent tools (local only — KHÔNG commit lên git) ────────────────────
.agents/
.claude/
.ai/
.gitnexus/

# ── File phân tích & tài liệu tạm (local only) ──────────────────────────────
CLAUDE.md
AGENTS.md
Backlog_Technical.md
task_fix_ui.md
task_fix_ui
task1.md
task2.md
db_top_analysis.md
concurrent_transactions_report.md
*_report.md
*_analysis.md

# ── Log / script tạm ─────────────────────────────────────────────────────────
*.log
gitnexus_stderr.txt
gn_stderr.txt
gn_stdout.txt
pw_err.txt
pw_out.txt
