@startuml TongHop_QuanLySanPham
left to right direction
skinparam shadowing false
    ' ==========================================
    ' 2.3.17. Thêm/Xóa/Sửa danh mục sản phẩm
    ' ==========================================
    usecase "Quản lý danh mục" as UC_ManageCat
    usecase "Thêm danh mục" as UC_AddCat
    usecase "Sửa danh mục" as UC_EditCat
    usecase "Xóa danh mục" as UC_DelCat

    usecase "Hủy bỏ lưu" as UC_CancelCat
    usecase "Cảnh báo trống tên nhóm" as UC_ErrEmptyCat
    usecase "Báo lỗi trùng lặp" as UC_ErrDupCat
    usecase "Chặn xóa (Nhóm đang chứa sản phẩm)" as UC_ErrHasProd

    ' ==========================================
    ' 2.3.18. Thêm/Xóa/Sửa sản phẩm
    ' ==========================================
    usecase "Quản lý sản phẩm" as UC_ManageProd
    usecase "Thêm mới sản phẩm" as UC_AddProd
    usecase "Chỉnh sửa sản phẩm" as UC_EditProd
    usecase "Ngừng bán sản phẩm" as UC_StopProd

    usecase "Lỗi giá bán âm hoặc bằng không" as UC_ErrPrice
    usecase "Cảnh báo (Sản phẩm đang nằm trong đơn chờ)" as UC_WarnOrder

    ' ==========================================
    ' 2.3.19. Tra cứu sản phẩm
    ' ==========================================
    usecase "Tra cứu sản phẩm" as UC_SearchProd
    usecase "Xóa trắng từ khóa / Bỏ bộ lọc" as UC_ClearProd
    usecase "Thông báo không tìm thấy kết quả" as UC_ErrNotFoundProd

    ' ==========================================
    ' 2.3.20. Thêm/Xóa/Sửa công thức
    ' ==========================================
    usecase "Quản lý công thức" as UC_ManageRecipe
    usecase "Thêm công thức" as UC_AddRecipe
    usecase "Sửa công thức" as UC_EditRecipe
    usecase "Xóa công thức" as UC_DelRecipe

    usecase "Hủy bỏ lưu" as UC_CancelRecipe
    usecase "Lỗi định lượng âm hoặc bằng không" as UC_ErrQty
    usecase "Lỗi trùng lặp bánh đã có công thức" as UC_ErrDupRecipe

    ' ==========================================
    ' 2.3.21. Tra cứu công thức
    ' ==========================================
    usecase "Tra cứu công thức" as UC_SearchRecipe
    usecase "Xóa trắng từ khóa tìm kiếm" as UC_ClearRecipe
    usecase "Thông báo không tìm thấy kết quả" as UC_ErrNotFoundRecipe

    ' ==========================================
    ' 2.3.22. Tính toán số lượng bánh làm ra
    ' ==========================================
    usecase "Tính toán số lượng bánh làm ra" as UC_Calc
    usecase "Dừng tính toán (Phát hiện vật tư tồn bằng 0)" as UC_ErrZeroStock

    ' ==========================================
    ' 2.3.23. Cấu hình giới hạn nhận đơn
    ' ==========================================
    usecase "Cấu hình giới hạn nhận đơn" as UC_LimitConfig
    usecase "Hủy bỏ cài đặt" as UC_CancelLimit
    usecase "Báo lỗi điền số âm" as UC_ErrNegative
    usecase "Từ chối hạ mức (Nhỏ hơn số đơn đã lỡ nhận)" as UC_ErrLower

' ==========================================
' QUAN HỆ (RELATIONSHIPS)
' ==========================================

' Nhóm 17
UC_AddCat --|> UC_ManageCat
UC_EditCat --|> UC_ManageCat
UC_DelCat --|> UC_ManageCat

UC_CancelCat ..> UC_ManageCat : <<extend>>
UC_ErrEmptyCat ..> UC_ManageCat : <<extend>>
UC_ErrDupCat ..> UC_AddCat : <<extend>>
UC_ErrHasProd ..> UC_DelCat : <<extend>>

' Nhóm 18
UC_AddProd --|> UC_ManageProd
UC_EditProd --|> UC_ManageProd
UC_StopProd --|> UC_ManageProd

UC_ErrPrice ..> UC_ManageProd : <<extend>>
UC_WarnOrder ..> UC_StopProd : <<extend>>

' Nhóm 19
UC_ClearProd ..> UC_SearchProd : <<extend>>
UC_ErrNotFoundProd ..> UC_SearchProd : <<extend>>

' Nhóm 20
UC_AddRecipe --|> UC_ManageRecipe
UC_EditRecipe --|> UC_ManageRecipe
UC_DelRecipe --|> UC_ManageRecipe

UC_CancelRecipe ..> UC_ManageRecipe : <<extend>>
UC_ErrQty ..> UC_ManageRecipe : <<extend>>
UC_ErrDupRecipe ..> UC_AddRecipe : <<extend>>

' Nhóm 21
UC_ClearRecipe ..> UC_SearchRecipe : <<extend>>
UC_ErrNotFoundRecipe ..> UC_SearchRecipe : <<extend>>

' Nhóm 22
UC_ErrZeroStock ..> UC_Calc : <<extend>>

' Nhóm 23
UC_CancelLimit ..> UC_LimitConfig : <<extend>>
UC_ErrNegative ..> UC_LimitConfig : <<extend>>
UC_ErrLower ..> UC_LimitConfig : <<extend>>

@enduml