@startuml 03_ThemXoaSuaNhanSu
left to right direction
skinparam shadowing false

usecase "Cập nhật nhân sự" as UC_ManageStaff
usecase "Thêm nhân sự" as UC_AddStaff
usecase "Sửa nhân sự" as UC_EditStaff
usecase "Xóa/Vô hiệu hóa nhân sự" as UC_DelStaff
usecase "Hủy bỏ điền biểu mẫu" as UC_Cancel1
usecase "Từ chối hộp thoại vô hiệu hóa" as UC_CancelDel1
usecase "Cảnh báo bỏ trống trường bắt buộc" as UC_ErrEmpty1
usecase "Báo lỗi trùng tên đăng nhập" as UC_ErrDup1

usecase "Tra cứu nhân sự" as UC_SearchStaff
usecase "Truy xuất cơ sở dữ liệu" as UC_FetchDB
usecase "Xóa từ khóa (Hiển thị lại ban đầu)" as UC_ClearSearch1
usecase "Thông báo không tìm thấy kết quả" as UC_ErrNotFound1

usecase "Cấu hình hạng thành viên" as UC_ConfigRank
usecase "Hủy bỏ cài đặt" as UC_Cancel2
usecase "Báo lỗi vượt mức giảm giá / trùng điểm" as UC_ErrInvalid

usecase "Quản lý hồ sơ khách hàng" as UC_ManageCust
usecase "Thêm khách hàng" as UC_AddCust
usecase "Sửa khách hàng" as UC_EditCust
usecase "Xóa khách hàng" as UC_DelCust

usecase "Hủy bỏ biểu mẫu" as UC_Cancel3
usecase "Hủy bỏ trên hộp thoại xóa" as UC_CancelDel2
usecase "Cảnh báo bỏ trống trường" as UC_ErrEmpty2
usecase "Lỗi trùng lặp số điện thoại" as UC_ErrDup2
usecase "Chặn xóa (Có đơn chưa hoàn thành)" as UC_ErrBlock

usecase "Tra cứu khách hàng" as UC_SearchCust
usecase "Xóa từ khóa (Hiển thị lại)" as UC_ClearSearch2
usecase "Không tìm thấy & Gợi ý tạo mới" as UC_ErrNotFound2

usecase "Tra cứu lịch sử mua hàng" as UC_History
usecase "Thiết lập bộ lọc khoảng thời gian" as UC_FilterTime
usecase "Thông báo khách hàng mới (Trống)" as UC_ErrEmpty

usecase "Cập nhật trạng thái đơn" as UC_UpdateStatus
usecase "Chuyển trạng thái: Đang làm" as UC_StsDoing
usecase "Chuyển trạng thái: Chờ giao" as UC_StsWait
usecase "Chuyển trạng thái: Hoàn thành" as UC_StsDone
usecase "Cảnh báo vi phạm (Chuyển tắt trạng thái)" as UC_ErrSkip

usecase "Tra cứu danh sách đơn" as UC_SearchOrder
usecase "Xóa trắng các bộ lọc" as UC_ClearFilter
usecase "Thông báo không tìm thấy kết quả" as UC_ErrNotFound3

usecase "Hủy đơn và hoàn cọc" as UC_CancelOrder
usecase "Khách hàng đổi ý (Không hủy nữa)" as UC_Abort
usecase "Chặn hủy (Bánh đã làm xong / Chờ giao)" as UC_ErrDone

UC_AddStaff --|> UC_ManageStaff
UC_EditStaff --|> UC_ManageStaff
UC_DelStaff --|> UC_ManageStaff
UC_Cancel1 ..> UC_ManageStaff : <<extend>>
UC_CancelDel1 ..> UC_DelStaff : <<extend>>
UC_ErrEmpty1 ..> UC_ManageStaff : <<extend>>
UC_ErrDup1 ..> UC_AddStaff : <<extend>>

UC_SearchStaff ..> UC_FetchDB : <<include>>
UC_ClearSearch1 ..> UC_SearchStaff : <<extend>>
UC_ErrNotFound1 ..> UC_SearchStaff : <<extend>>

UC_Cancel2 ..> UC_ConfigRank : <<extend>>
UC_ErrInvalid ..> UC_ConfigRank : <<extend>>

UC_AddCust --|> UC_ManageCust
UC_EditCust --|> UC_ManageCust
UC_DelCust --|> UC_ManageCust

UC_Cancel3 ..> UC_ManageCust : <<extend>>
UC_CancelDel2 ..> UC_DelCust : <<extend>>
UC_ErrEmpty2 ..> UC_ManageCust : <<extend>>
UC_ErrDup2 ..> UC_AddCust : <<extend>>
UC_ErrBlock ..> UC_DelCust : <<extend>>

UC_ClearSearch2 ..> UC_SearchCust : <<extend>>
UC_ErrNotFound2 ..> UC_SearchCust : <<extend>>

UC_FilterTime ..> UC_History : <<extend>>
UC_ErrEmpty ..> UC_History : <<extend>>

UC_StsDoing --|> UC_UpdateStatus
UC_StsWait --|> UC_UpdateStatus
UC_StsDone --|> UC_UpdateStatus

UC_ErrSkip ..> UC_UpdateStatus : <<extend>>

UC_ClearFilter ..> UC_SearchOrder : <<extend>>
UC_ErrNotFound3 ..> UC_SearchOrder : <<extend>>

UC_Abort ..> UC_CancelOrder : <<extend>>
UC_ErrDone ..> UC_CancelOrder : <<extend>>

@enduml