@startuml TongHop_TrangThaiDon_CongThuc_XuatKho
left to right direction
skinparam shadowing false

    ' ==========================================
    ' 2.3.14. Cập nhật trạng thái đơn
    ' ==========================================
    usecase "Cập nhật trạng thái đơn" as UC_UpdateStatus
    usecase "Chuyển trạng thái: Đang làm" as UC_StsDoing
    usecase "Chuyển trạng thái: Chờ giao" as UC_StsWait
    usecase "Chuyển trạng thái: Hoàn thành" as UC_StsDone
    usecase "Cảnh báo vi phạm (Chuyển tắt trạng thái)" as UC_ErrSkip

    ' ==========================================
    ' 2.3.15. Tra cứu danh sách đơn
    ' ==========================================
    usecase "Tra cứu danh sách đơn" as UC_SearchOrder
    usecase "Xóa trắng các bộ lọc" as UC_ClearFilterOrder
    usecase "Thông báo không tìm thấy kết quả" as UC_ErrNotFoundOrder

    ' ==========================================
    ' 2.3.20. Thêm/Xóa/Sửa công thức
    ' ==========================================
    usecase "Quản lý công thức" as UC_ManageRecipe
    usecase "Thêm công thức" as UC_AddRecipe
    usecase "Sửa công thức" as UC_EditRecipe
    usecase "Xóa công thức" as UC_DelRecipe

    usecase "Hủy bỏ lưu" as UC_CancelRecipe
    usecase "Lỗi định lượng âm hoặc bằng không" as UC_ErrQty
    usecase "Lỗi trùng lặp bánh đã có công thức" as UC_ErrDupRecipe

    ' ==========================================
    ' 2.3.21. Tra cứu công thức
    ' ==========================================
    usecase "Tra cứu công thức" as UC_SearchRecipe
    usecase "Xóa trắng từ khóa tìm kiếm" as UC_ClearRecipe
    usecase "Thông báo không tìm thấy kết quả" as UC_ErrNotFoundRecipe

    ' ==========================================
    ' 2.3.22. Tính toán số lượng bánh làm ra
    ' ==========================================
    usecase "Tính toán số lượng bánh làm ra" as UC_Calc
    usecase "Dừng tính toán (Phát hiện vật tư tồn bằng 0)" as UC_ErrZeroStock

    ' ==========================================
    ' 2.3.26. Lập phiếu xuất kho
    ' ==========================================
    usecase "Lập phiếu xuất kho" as UC_Export
    usecase "Kiểm tra số lượng tồn" as UC_CheckStock
    usecase "Hủy giao dịch (Kho không đủ vật tư)" as UC_ErrNoStock
    usecase "Yêu cầu chờ (Xung đột thao tác xuất trùng lặp)" as UC_ErrLock


' ==========================================
' QUAN HỆ (RELATIONSHIPS)
' ==========================================

' Nhóm 14
UC_StsDoing --|> UC_UpdateStatus
UC_StsWait --|> UC_UpdateStatus
UC_StsDone --|> UC_UpdateStatus
UC_ErrSkip ..> UC_UpdateStatus : <<extend>>

' Nhóm 15
UC_ClearFilterOrder ..> UC_SearchOrder : <<extend>>
UC_ErrNotFoundOrder ..> UC_SearchOrder : <<extend>>

' Nhóm 20
UC_AddRecipe --|> UC_ManageRecipe
UC_EditRecipe --|> UC_ManageRecipe
UC_DelRecipe --|> UC_ManageRecipe

UC_CancelRecipe ..> UC_ManageRecipe : <<extend>>
UC_ErrQty ..> UC_ManageRecipe : <<extend>>
UC_ErrDupRecipe ..> UC_AddRecipe : <<extend>>

' Nhóm 21
UC_ClearRecipe ..> UC_SearchRecipe : <<extend>>
UC_ErrNotFoundRecipe ..> UC_SearchRecipe : <<extend>>

' Nhóm 22
UC_ErrZeroStock ..> UC_Calc : <<extend>>

' Nhóm 26
UC_Export ..> UC_CheckStock : <<include>>
UC_ErrNoStock ..> UC_Export : <<extend>>
UC_ErrLock ..> UC_Export : <<extend>>

@enduml