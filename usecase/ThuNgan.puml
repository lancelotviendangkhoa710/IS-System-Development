@startuml TongHop_QuanLyKhachHang_BanHang
left to right direction
skinparam shadowing false

    ' ==========================================
    ' 2.3.8. Thêm/Xóa/Sửa khách hàng
    ' ==========================================
    usecase "Quản lý hồ sơ khách hàng" as UC_ManageCust
    usecase "Thêm khách hàng" as UC_AddCust
    usecase "Sửa khách hàng" as UC_EditCust
    usecase "Xóa khách hàng" as UC_DelCust

    usecase "Hủy bỏ biểu mẫu" as UC_CancelCust
    usecase "Hủy bỏ trên hộp thoại xóa" as UC_CancelDelCust
    usecase "Cảnh báo bỏ trống trường" as UC_ErrEmptyCust
    usecase "Lỗi trùng lặp số điện thoại" as UC_ErrDupCust
    usecase "Chặn xóa (Có đơn chưa hoàn thành)" as UC_ErrBlockCust

    ' ==========================================
    ' 2.3.9. Tra cứu khách hàng
    ' ==========================================
    usecase "Tra cứu khách hàng" as UC_SearchCust
    usecase "Xóa từ khóa (Hiển thị lại)" as UC_ClearSearchCust
    usecase "Không tìm thấy & Gợi ý tạo mới" as UC_ErrNotFoundCust

    ' ==========================================
    ' 2.3.10. Tra cứu lịch sử mua hàng
    ' ==========================================
    usecase "Tra cứu lịch sử mua hàng" as UC_History
    usecase "Thiết lập bộ lọc khoảng thời gian" as UC_FilterTime
    usecase "Thông báo khách hàng mới (Trống)" as UC_ErrEmptyHistory

    ' ==========================================
    ' 2.3.12. Lập hóa đơn bán lẻ
    ' ==========================================
    usecase "Lập hóa đơn bán lẻ" as UC_Retail
    usecase "Kiểm tra thông tin thành viên" as UC_CheckMember
    usecase "Khách vãng lai (Bỏ qua nhập SĐT)" as UC_Guest
    usecase "Xóa bớt món trước khi thanh toán" as UC_RemoveItem
    usecase "Lỗi nhập thiếu tiền khách đưa" as UC_ErrMoney

    ' ==========================================
    ' 2.3.13. Lập đơn đặt bánh tùy chỉnh
    ' ==========================================
    usecase "Lập đơn đặt bánh tùy chỉnh" as UC_CustomOrder
    usecase "Bỏ qua bước thêm phụ kiện" as UC_SkipDeco
    usecase "Từ chối nhận đơn (Giờ hẹn quá cận)" as UC_ErrTime
    usecase "Chặn thao tác (Tiền cọc thấp hơn tối thiểu)" as UC_ErrDeposit

    ' ==========================================
    ' 2.3.14. Cập nhật trạng thái đơn
    ' ==========================================
    usecase "Cập nhật trạng thái đơn" as UC_UpdateStatus
    usecase "Chuyển trạng thái: Đang làm" as UC_StsDoing
    usecase "Chuyển trạng thái: Chờ giao" as UC_StsWait
    usecase "Chuyển trạng thái: Hoàn thành" as UC_StsDone
    usecase "Cảnh báo vi phạm (Chuyển tắt trạng thái)" as UC_ErrSkip

    ' ==========================================
    ' 2.3.15. Tra cứu danh sách đơn
    ' ==========================================
    usecase "Tra cứu danh sách đơn" as UC_SearchOrder
    usecase "Xóa trắng các bộ lọc" as UC_ClearFilterOrder
    usecase "Thông báo không tìm thấy kết quả" as UC_ErrNotFoundOrder

    ' ==========================================
    ' 2.3.16. Hủy đơn và hoàn cọc
    ' ==========================================
    usecase "Hủy đơn và hoàn cọc" as UC_CancelOrder
    usecase "Khách hàng đổi ý (Không hủy nữa)" as UC_Abort
    usecase "Chặn hủy (Bánh đã làm xong / Chờ giao)" as UC_ErrDone

    ' ==========================================
    ' 2.3.19. Tra cứu sản phẩm
    ' ==========================================
    usecase "Tra cứu sản phẩm" as UC_SearchProd
    usecase "Xóa trắng từ khóa / Bỏ bộ lọc" as UC_ClearProd
    usecase "Thông báo không tìm thấy kết quả" as UC_ErrNotFoundProd


' ==========================================
' QUAN HỆ (RELATIONSHIPS)
' ==========================================

' Nhóm 08
UC_AddCust --|> UC_ManageCust
UC_EditCust --|> UC_ManageCust
UC_DelCust --|> UC_ManageCust

UC_CancelCust ..> UC_ManageCust : <<extend>>
UC_CancelDelCust ..> UC_DelCust : <<extend>>
UC_ErrEmptyCust ..> UC_ManageCust : <<extend>>
UC_ErrDupCust ..> UC_AddCust : <<extend>>
UC_ErrBlockCust ..> UC_DelCust : <<extend>>

' Nhóm 09
UC_ClearSearchCust ..> UC_SearchCust : <<extend>>
UC_ErrNotFoundCust ..> UC_SearchCust : <<extend>>

' Nhóm 10
UC_FilterTime ..> UC_History : <<extend>>
UC_ErrEmptyHistory ..> UC_History : <<extend>>

' Nhóm 12
UC_Retail ..> UC_CheckMember : <<include>>
UC_Guest ..> UC_CheckMember : <<extend>>
UC_RemoveItem ..> UC_Retail : <<extend>>
UC_ErrMoney ..> UC_Retail : <<extend>>

' Nhóm 13
UC_SkipDeco ..> UC_CustomOrder : <<extend>>
UC_ErrTime ..> UC_CustomOrder : <<extend>>
UC_ErrDeposit ..> UC_CustomOrder : <<extend>>

' Nhóm 14
UC_StsDoing --|> UC_UpdateStatus
UC_StsWait --|> UC_UpdateStatus
UC_StsDone --|> UC_UpdateStatus

UC_ErrSkip ..> UC_UpdateStatus : <<extend>>

' Nhóm 15
UC_ClearFilterOrder ..> UC_SearchOrder : <<extend>>
UC_ErrNotFoundOrder ..> UC_SearchOrder : <<extend>>

' Nhóm 16
UC_Abort ..> UC_CancelOrder : <<extend>>
UC_ErrDone ..> UC_CancelOrder : <<extend>>

' Nhóm 19
UC_ClearProd ..> UC_SearchProd : <<extend>>
UC_ErrNotFoundProd ..> UC_SearchProd : <<extend>>

@enduml