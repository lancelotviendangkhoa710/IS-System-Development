' ==========================================
' 2.3.25. Lập phiếu nhập kho
' ==========================================
@startuml 25_LapPhieuNhapKho
left to right direction
skinparam shadowing false

usecase "Lập phiếu nhập kho" as UC_Import
usecase "Xóa dòng nguyên liệu nhập sai" as UC_DelRow
usecase "Lưu tạm nháp phiếu nhập" as UC_SaveDraft
usecase "Lỗi HSD nhỏ hơn ngày sản xuất" as UC_ErrDate
usecase "Chặn lưu (Thiếu nhà cung cấp / phiếu trống)" as UC_ErrEmpty

UC_DelRow ..> UC_Import : <<extend>>
UC_SaveDraft ..> UC_Import : <<extend>>
UC_ErrDate ..> UC_Import : <<extend>>
UC_ErrEmpty ..> UC_Import : <<extend>>
@enduml
