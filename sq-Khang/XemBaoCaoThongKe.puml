@startuml XemBaoCaoThongKe
mainframe sd Seq_XemBaoCaoThongKe
autonumber "<b>##."
skinparam sequenceMessageAlign center
skinparam style strictuml

    skinparam noteBackgroundColor transparent
    skinparam noteBorderColor transparent

actor "Quản lý" as QL #White
boundary "GUI_BaoCaoThongKe" as UI #White
control "Controller_BaoCaoThongKe" as SYS #White
entity ": HOADON" as DB_HD #White
entity ": PHIEUNHAPKHO" as DB_PNK #White

UI -> UI: Mở màn hình xem báo cáo thống kê
activate UI
deactivate UI

QL -> UI: Chọn chức năng báo cáo
activate UI
deactivate UI

group opt Báo cáo lợi nhuận
    autonumber stop
    QL -[hidden]-> DB_PNK
    autonumber resume "<b>##."
    ref over QL, DB_PNK: Báo cáo lợi nhuận (Seq_BaoCaoLoiNhuan)
end

group opt Báo cáo doanh thu
    autonumber stop
    QL -[hidden]-> DB_PNK
    autonumber resume "<b>##."
    ref over QL, DB_PNK: Báo cáo doanh thu (Seq_BaoCaoDoanhThu)
end

@enduml
