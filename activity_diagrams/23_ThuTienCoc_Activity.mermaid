flowchart TD
    subgraph Nguoi_dung [Người dùng]
        ND1("Chốt thông tin bánh, báo số tiền cần cọc")
        ND2("Nhập số tiền cọc vào biểu mẫu")
        ND3("Khách thanh toán tiền mặt/chuyển khoản")
        ND4("Xác nhận đã nhận tiền")
    end

    subgraph He_thong [Hệ thống]
        start(( )) --> ND1
        ND1 --> ND2
        ND2 --> DK1{"Khách đổi ý hủy?"}
        DK1 -->|Có| HT1("Hủy đơn hàng tùy chỉnh đang tạo")
        HT1 --> end_node((( )))
        DK1 -->|Không| ND3
        ND3 --> ND4
        ND4 --> HT2("Lưu số tiền đã cọc")
        HT2 --> HT3("Tính số tiền còn lại khi giao bánh")
        HT3 --> end_node
    end

    subgraph CSDL [CSDL]
        DB1("UPDATE DONDATHANG TIENDACOC")
        Table1["DONDATHANG"]
    end

    HT2 --> DB1
    DB1 --> Table1
    Table1 --> HT3
