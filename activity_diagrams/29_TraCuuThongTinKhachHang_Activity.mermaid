flowchart TD
    subgraph Nguoi_dung [Người dùng]
        ND1("Chọn ô tìm kiếm khách hàng")
        ND2("Nhập SĐT hoặc tên")
        ND3("Nhấn chọn khách để xem chi tiết")
    end

    subgraph He_thong [Hệ thống]
        start(( )) --> ND1
        ND1 --> ND2
        ND2 --> HT1("Kiểm tra định dạng SĐT")
        HT1 --> DK1{"Định dạng hợp lệ?"}
        DK1 -->|Không| HT2("Ngăn truy vấn, báo lỗi cú pháp")
