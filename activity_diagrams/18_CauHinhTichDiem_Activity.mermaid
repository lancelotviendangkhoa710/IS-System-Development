flowchart TD
    subgraph Nguoi_dung [Người dùng]
        ND1("Vào mục Cấu hình khách hàng")
        ND2("Chọn Cài đặt tỷ lệ tích điểm")
        ND3("Nhập số tiền tương ứng với 1 điểm thưởng")
        ND4("Nhấn Lưu cấu hình")
    end

    subgraph He_thong [Hệ thống]
        start(( )) --> ND1
        ND1 --> ND2
        ND2 --> ND3
