@startuml
skinparam conditionStyle diamond
skinparam ranksep 80
skinparam swimlaneWidth 140
skinparam shadowing false
skinparam ActivityShape rounded
skinparam linetype ortho

|Người dùng|
|Hệ thống|
|CSDL|

|Người dùng|
start
:Nhập tên đăng nhập\nvà mật khẩu;
:Nhấn nút xác nhận;
|Hệ thống|
:Kiểm tra tính hợp lệ\ncủa thông tin vừa nhập;
|CSDL|
:Xác thực tài khoản;
|Hệ thống|

if (Sai tên/mật khẩu?) then (Có)
  :Hiển thị thông báo lỗi\nvà yêu cầu nhập lại;
  stop
else (Không)
  if (Tài khoản bị vô hiệu hóa?) then (Có)
    :Từ chối truy cập\nvà báo lỗi tương ứng;
    stop
  else (Hợp lệ)
    :Ghi nhận phiên làm việc\nvà hiển thị màn hình chính;
    |Người dùng|
    :Nhấn nút đăng xuất\ntrên màn hình chính;
    |Hệ thống|
    :Kết thúc phiên làm việc\nvà quay lại màn hình khởi động;
    stop
  endif
endif

@enduml