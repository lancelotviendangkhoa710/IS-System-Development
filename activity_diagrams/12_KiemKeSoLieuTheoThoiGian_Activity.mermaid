flowchart TD
    subgraph Nguoi_dung [Người dùng]
        ND1("Chọn Chốt ca/Kiểm kê")
        ND2("Nhập số tiền thực tế đếm được")
        ND3("Nhấn Hoàn tất chốt sổ")
    end

    subgraph He_thong [Hệ thống]
        start(( )) --> ND1
        ND1 --> HT1("Hiển thị số tiền ghi nhận được")
        HT1 --> ND2
        ND2 --> HT2("Đối chiếu chênh lệch")
        HT2 --> DK1{"Có chênh lệch?"}
        DK1 -->|Có| HT3("Yêu cầu ghi chú lý do sai lệch")
        HT3 --> ND3
        DK1 -->|Không| ND3
        ND3 --> HT4("Khóa chỉnh sửa")
        HT4 --> end_node((( )))
    end

    subgraph CSDL [CSDL]
        DB1("SELECT HOADON tổng theo ca")
        DB2("INSERT/UPDATE DOISOAT")
        Table1["DOISOAT"]
    end

    HT1 --> DB1
    DB1 --> HT2
    HT4 --> DB2
    DB2 --> Table1
