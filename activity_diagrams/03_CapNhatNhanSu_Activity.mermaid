flowchart TD
    subgraph Nguoi_dung [Người dùng]
        ND1("Chọn chức năng cập nhật và chọn một nhân viên")
        ND2("Thay đổi thông tin và nhấn Lưu")
    end

    subgraph He_thong [Hệ thống]
        start(( )) --> HT1("Hiển thị biểu mẫu chứa thông tin hiện tại")
        HT1 --> ND1
        ND1 --> ND2
        ND2 --> HT2("Kiểm tra tính hợp lệ của dữ liệu")
        HT2 --> DK1{"Hợp lệ?"}
        DK1 -->|Không| HT3("Báo lỗi và yêu cầu nhập lại")
        HT3 --> ND2
        DK1 -->|Có| HT4("Lưu thay đổi")
        HT4 --> HT5("Thông báo cập nhật thành công")
        HT5 --> end_node((( )))
        HT3 --> end_node
    end

    subgraph CSDL [CSDL]
        DB1("SELECT NHANVIEN")
        DB2("UPDATE NHANVIEN")
        Table1["NHANVIEN"]
    end

    HT1 --> DB1
    DB1 --> Table1
    Table1 --> HT1
    HT4 --> DB2
