flowchart TD
    subgraph Nguoi_dung [Người dùng]
        ND1("Chọn chức năng Phân quyền")
        ND2("Chọn một nhân viên hoặc nhóm vai trò")
        ND3("Tích chọn/bỏ chọn quyền và nhấn Lưu")
    end

    subgraph He_thong [Hệ thống]
        start(( )) --> ND1
        ND1 --> ND2
        ND2 --> HT1("Hiển thị danh sách quyền hạn")
        HT1 --> ND3
        ND3 --> HT2("Ghi nhận bộ quyền hạn mới")
        HT2 --> HT3("Thông báo cập nhật thành công")
        HT3 --> end_node((( )))
    end

    subgraph CSDL [CSDL]
        DB1("SELECT VAITRO, CHUCNANG")
        DB2("UPDATE VAITRO_CHUCNANG")
        Table1["VAITRO_CHUCNANG"]
    end

    HT1 --> DB1
    DB1 --> HT1
    HT2 --> DB2
    DB2 --> Table1
    Table1 --> HT3
